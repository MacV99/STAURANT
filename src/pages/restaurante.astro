---
import Layout1 from "../layouts/Layout1.astro";
import DishForm from "../components/DishForm.astro";
import RestaurantForm from "../components/RestaurantForm.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";
import DishCard from "../components/DishCard.astro";
import RestaurantHeader from "../components/RestaurantHeader.astro";
import SortBar from "../components/SortBar.astro";
import type { Dish, Restaurant } from "../lib/data";

const tplDish: Dish = {
  id: "",
  restaurantId: "",
  typeId: null,
  name: "...",
  rating: 5,
  notes: " ",
  createdAt: "",
  updatedAt: "",
  officialDishId: null,
};
const tplRestaurant: Restaurant = {
  id: "",
  name: "...",
  status: "visited",
  notes: " ",
  cities: [],
  address: null,
  createdAt: "",
  updatedAt: "",
  officialRestaurantId: null,
};
---

<Layout1 title="Restaurante · STAURANT">
  <div class="detail-page flex-column">
    <a id="back-link" href="/" class="back-link flex-row">
      <i class="bi bi-arrow-left"></i> Volver
    </a>

    <div id="restaurant-header" class="restaurant-header"><div class="skeleton-card skeleton-header"></div></div>

    <div class="dishes-section flex-column">
      <div class="dishes-top flex-row">
        <h2 class="dishes-title">Platos</h2>
      </div>

      <div class="list-toolbar texture-dotted">
        <div class="dish-search-wrap">
          <i class="bi bi-search dish-search-icon"></i>
          <input
            id="dish-search"
            class="dish-search-input"
            type="search"
            placeholder="Buscar plato..."
            autocomplete="off"
            spellcheck="false"
          />
          <button
            id="dish-search-clear"
            class="dish-search-clear"
            type="button"
            aria-label="Limpiar búsqueda"
            hidden
          >
            <i class="bi bi-x-circle-fill"></i>
          </button>
        </div>

        <div class="dishes-controls filter-row">
          <SortBar
            options={[
              { field: "rating", dir: "desc", label: "Mejor calificados", short: "Mejor nota", icon: "bi-star-fill" },
              { field: "rating", dir: "asc", label: "Peor calificados", short: "Peor nota", icon: "bi-star" },
              { field: "name", dir: "asc", label: "Nombre (A–Z)", short: "A–Z", icon: "bi-sort-alpha-down" },
              { field: "modified", dir: "desc", label: "Modificados recientemente", short: "Recientes", icon: "bi-clock-history" },
              { field: "date", dir: "desc", label: "Agregados recientemente", short: "Nuevos", icon: "bi-calendar-plus" },
            ]}
          />
          <div id="dish-type-chips" class="filter-chips" aria-label="Filtrar por tipo" hidden></div>
        </div>
      </div>

      <div id="dishes-list" class="flex-column"></div>
    </div>
  </div>

  <DishForm />
  <RestaurantForm />
  <ConfirmDialog />

  <template id="tpl-dish-card">
    <DishCard dish={tplDish} typeName="..." />
  </template>

  <template id="tpl-restaurant-header">
    <RestaurantHeader restaurant={tplRestaurant} avg={5} dishCount={0} />
  </template>
</Layout1>

<style>
  .detail-page {
    width: 100%;
    max-width: 760px;
    padding: 20px 16px 80px;
    align-items: stretch;
    gap: 24px;
  }

  .back-link {
    justify-content: flex-start;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--clr-primary);
    letter-spacing: 1px;
    width: fit-content;
    padding: 6px 0;
    transition: var(--transition);
  }

  .restaurant-header {
    width: 100%;
  }

  .dishes-section {
    align-items: stretch;
    gap: 12px;
  }

  .dishes-top {
    justify-content: flex-start;
  }

  .dishes-title {
    font-size: 1rem;
    letter-spacing: 2px;
    color: var(--clr-text);
  }

  .dish-search-wrap[hidden],
  .dishes-controls[hidden] {
    display: none;
  }

  .dish-search-wrap {
    position: relative;
    width: 100%;
  }

  .dish-search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--clr-text);
    opacity: 0.4;
    font-size: 0.85rem;
    pointer-events: none;
  }

  .dish-search-input {
    width: 100%;
    padding: 9px 14px 9px 34px;
    border-radius: var(--border-radius);
    border: 1.5px solid var(--clr-border);
    background: var(--clr-white);
    font-size: 1rem; /* 16px: menos y el iPhone hace zoom al tocar */
    color: var(--clr-text);
    transition: border-color var(--transition);
  }

  .dish-search-input::placeholder {
    color: var(--clr-text);
    opacity: 0.5;
  }

  .dish-search-input:focus {
    outline: none;
    border-color: var(--clr-border2);
  }

  .dish-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .dish-search-input:not(:placeholder-shown) {
    padding-right: 38px;
  }

  .dish-search-clear {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: 6px;
    color: var(--clr-text);
    opacity: 0.55;
    cursor: pointer;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: opacity var(--transition);
  }

  .dish-search-clear[hidden] {
    display: none;
  }

  @media (hover: hover) {
    .dish-search-clear:hover {
      opacity: 1;
    }
  }

  /* Debajo de la cabecera móvil (sticky, 80px). En desktop no hay cabecera. */
  @media (max-width: 767px) {
    .list-toolbar {
      top: 80px;
    }
  }

  #dishes-list {
    align-items: stretch;
    gap: 5px;
  }

  @media (hover: hover) {
    .back-link:hover {
      color: var(--clr-text);
    }
  }

  @media (min-width: 768px) {
    .detail-page {
      padding: 28px 24px 80px;
    }
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";
  import { supabase } from "../lib/supabase.ts";
  import { withLoading } from "../scripts/loading";
  import {
    initCache,
    isCacheLoaded,
    getRestaurants,
    getDishesByRestaurant,
    deleteDish,
    deleteRestaurant,
    getRestaurantAverage,
    markAsVisited,
    markAsPending,
    getDishTypes,
    getOfficialDishStat,
    getOfficialRestaurantStat,
    getTopRatedDishIds,
    getCurrentUserId,
    getCachedOfficialRestaurant,
  } from "../lib/data.ts";
  import type { Restaurant, Dish } from "../lib/data.ts";
  import {
    emit,
    makeCrown,
    paintRatingBadge,
    buildGlobalRatingPill,
    fillRestaurantName,
    updateSortPills,
    wireSortBar,
    renderFilterChips,
    keepListInView,
    shortDishName,
  } from "../scripts/store.ts";
  import { wireAddressLink } from "../scripts/maps.ts";
  import { wireShareButton, officialShareUrl, personalShareUrl } from "../scripts/share.ts";

  // ─── Sort state (persiste en módulo entre navegaciones) ────────────────────

  type SortField = "name" | "rating" | "date" | "modified";
  type SortDir = "asc" | "desc";
  const SORT_KEY = "staurant_sort_d";

  function getSortState(): { field: SortField; dir: SortDir } {
    try {
      const saved = JSON.parse(localStorage.getItem(SORT_KEY) ?? "{}");
      // Solo combinaciones que ofrece el SortBar; otra guardada → defecto.
      const ok = ["rating-desc", "rating-asc", "name-asc", "modified-desc", "date-desc"];
      if (ok.includes(`${saved.field}-${saved.dir}`))
        return { field: saved.field as SortField, dir: saved.dir as SortDir };
    } catch {
      /* valor corrupto → defecto */
    }
    return { field: "rating", dir: "desc" };
  }
  function setSortState(s: { field: SortField; dir: SortDir }) {
    localStorage.setItem(SORT_KEY, JSON.stringify(s));
  }
  let dishSort = getSortState();

  function sortDishes(dishes: ReturnType<typeof getDishesByRestaurant>) {
    return [...dishes].sort((a, b) => {
      let cmp = 0;
      if (dishSort.field === "name") cmp = a.name.localeCompare(b.name);
      else if (dishSort.field === "rating") {
        const ra = a.rating ?? -1;
        const rb = b.rating ?? -1;
        cmp = ra - rb;
      } else if (dishSort.field === "modified")
        cmp = new Date(a.updatedAt).getTime() - new Date(b.updatedAt).getTime();
      else
        cmp = new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime();
      return dishSort.dir === "asc" ? cmp : -cmp;
    });
  }

  function getFilteredSortedDishes(restaurantId: string): Dish[] {
    let dishes = getDishesByRestaurant(restaurantId);
    if (dishSearch) {
      const q = dishSearch.toLowerCase();
      dishes = dishes.filter(
        (d) =>
          d.name.toLowerCase().includes(q) || d.notes.toLowerCase().includes(q),
      );
    }
    if (dishTypeFilter) {
      dishes = dishes.filter((d) => d.typeId === dishTypeFilter);
    }
    return sortDishes(dishes);
  }

  /** Chips de tipo: solo las categorías de este restaurante, las más usadas
   *  primero. Si el tipo elegido ya no tiene platos, vuelve a "Todos". */
  function renderTypeChips() {
    const el = document.getElementById("dish-type-chips");
    if (!el || !currentRestaurant) return;
    const useById = new Map<string, number>();
    for (const d of getDishesByRestaurant(currentRestaurant.id))
      if (d.typeId) useById.set(d.typeId, (useById.get(d.typeId) ?? 0) + 1);
    const types = getDishTypes()
      .filter((t) => useById.has(t.id))
      .sort(
        (a, b) =>
          (useById.get(b.id) ?? 0) - (useById.get(a.id) ?? 0) ||
          a.name.localeCompare(b.name, "es"),
      );
    if (!types.some((t) => t.id === dishTypeFilter)) dishTypeFilter = "";
    renderFilterChips(el, {
      selected: dishTypeFilter,
      options: types.map((t) => ({ value: t.id, label: t.name, count: useById.get(t.id) })),
      onPick: (id) => {
        dishTypeFilter = id;
        rerenderRestaurantePage();
        scrollToDishes();
      },
    });
  }

  function scrollToDishes() {
    keepListInView(
      document.getElementById("dishes-list"),
      document.querySelector<HTMLElement>(".list-toolbar"),
    );
  }

  // ─── Restaurante activo + filtros (nivel de módulo) ──────────────────────────
  // Actualizados en cada astro:page-load. Los listeners de módulo los leen aquí.

  let currentRestaurant: Restaurant | undefined;
  let dishSearch = "";
  let dishTypeFilter = "";
  // id del plato cuyo badge debe hacer "pop" en el próximo render (recién calificado/editado).
  let popDishId: string | null = null;
  // IDs de los platos estrella (mejor calificación personal). Recalculado antes de
  // cada render para que la corona 👑 se actualice al cambiar las calificaciones.
  let topDishIds: Set<string> = new Set();

  // ─── Generadores de HTML (nivel módulo) ────────────────────────────────────

  function buildHeaderElement(r: Restaurant, avg: number | null): Element {
    const tpl = document.getElementById(
      "tpl-restaurant-header",
    ) as HTMLTemplateElement;
    const div = (tpl.content.cloneNode(true) as DocumentFragment).querySelector(
      ".rh-card",
    )!;
    div.setAttribute("style", `view-transition-name: restaurant-${r.id}`);
    div.classList.toggle("is-official", !!r.officialRestaurantId);
    fillRestaurantName(div.querySelector("h1")!, r.name, !!r.officialRestaurantId);
    const dishes = getDishesByRestaurant(r.id);
    const pill = div.querySelector(".dish-count-pill");
    if (r.status === "pending") {
      const pendingSpan = document.createElement("span");
      pendingSpan.className = "pending-tag";
      pendingSpan.innerHTML = '<i class="bi bi-bookmark"></i> Pendiente';
      pill?.replaceWith(pendingSpan);
    } else {
      if (pill)
        pill.innerHTML = `<i class="bi bi-journal-text"></i> ${dishes.length} ${dishes.length === 1 ? "plato" : "platos"}`;
    }
    const citiesEl = div.querySelector(".rh-cities") as HTMLElement | null;
    const citiesListEl = div.querySelector(".rh-cities-list");
    if (citiesEl && citiesListEl && r.cities.length > 0) {
      citiesListEl.textContent = r.cities.join(" · ");
      citiesEl.hidden = false;
    }
    const addressEl = div.querySelector<HTMLAnchorElement>(".rh-address");
    const addressTextEl = div.querySelector(".rh-address-text");
    if (addressEl && addressTextEl && r.address?.trim()) {
      addressTextEl.textContent = r.address;
      wireAddressLink(addressEl, r.address);
      addressEl.hidden = false;
    }
    const badge = div.querySelector(".rating-badge")!;
    paintRatingBadge(badge, avg);
    // Pill de rating global (solo si es oficial y hay calificaciones agregadas)
    if (r.officialRestaurantId) {
      const stat = getOfficialRestaurantStat(r.officialRestaurantId);
      if (stat && stat.ratingsCount > 0) {
        const pillsRow = div.querySelector<HTMLElement>(".rh-pills");
        // Global primero, antes del conteo de platos.
        pillsRow?.insertBefore(
          buildGlobalRatingPill(stat.avgRating, stat.ratingsCount),
          pillsRow.firstChild,
        );
      }
    }

    const notesEl = div.querySelector<HTMLElement>(".rh-notes");
    if (r.notes) {
      notesEl!.textContent = r.notes;
    } else {
      notesEl?.remove();
    }
    // Compartir: si está ligado a un oficial, se comparte la carta pública; si no,
    // la vista de amigo de este restaurante. "Amigo" lo envía por recomendaciones.
    wireShareButton(div, () => {
      const official = r.officialRestaurantId
        ? getCachedOfficialRestaurant(r.officialRestaurantId)
        : null;
      return {
        title: r.name,
        url: official
          ? officialShareUrl(official)
          : personalShareUrl(getCurrentUserId() ?? "", r.id),
        friend: { type: "restaurant", id: r.id, title: r.name },
      };
    });
    div
      .querySelector<HTMLButtonElement>(".rh-btn-edit-rh")!
      .addEventListener("click", () => {
        (window as any).restaurantForm.open("edit", r);
        // Cerrar menú
        div
          .querySelector<HTMLElement>(".rh-menu-popup")
          ?.classList.remove("active");
      });
    div
      .querySelector<HTMLButtonElement>(".rh-btn-delete-rh")!
      .addEventListener("click", () => {
        (window as any).confirmDialog.show(
          `¿Eliminar "${r.name}"? Se borrarán también sus platos.`,
          () => {
            deleteRestaurant(r.id);
            navigate("/");
          },
        );
        // Cerrar menú
        div
          .querySelector<HTMLElement>(".rh-menu-popup")
          ?.classList.remove("active");
      });

    // ─── Setup menú popup ─────────────────────────────────────────────────────
    // ".rh-menu" delante: el botón de compartir también lleva .rh-btn-menu.
    const btnMenu = div.querySelector<HTMLButtonElement>(".rh-menu .rh-btn-menu")!;
    const menuPopup = div.querySelector<HTMLElement>(".rh-menu-popup")!;

    btnMenu.addEventListener("click", (e) => {
      e.stopPropagation();
      // Cerrar otros menús abiertos
      document.querySelectorAll(".rh-menu-popup.active").forEach((m) => {
        if (m !== menuPopup) {
          m.classList.remove("active");
        }
      });
      // Toggle menú actual
      menuPopup.classList.toggle("active");
    });

    return div;
  }

  function buildDishCardElement(d: Dish): Element {
    const tpl = document.getElementById("tpl-dish-card") as HTMLTemplateElement;
    const article = (
      tpl.content.cloneNode(true) as DocumentFragment
    ).querySelector("article")!;
    article.setAttribute("data-id", d.id);
    const nameEl = article.querySelector("h4")!;
    nameEl.textContent = shortDishName(d.name);
    // Corona 👑 del mejor calificado: junto al nombre.
    if (topDishIds.has(d.id)) nameEl.appendChild(makeCrown("Plato estrella", true));
    // Categoría: pequeña, debajo del nombre.
    const typeTagEl = article.querySelector<HTMLElement>(".dish-type-tag");
    const typeName = d.typeId
      ? (getDishTypes().find((t) => t.id === d.typeId)?.name ?? null)
      : null;
    if (typeName && typeTagEl) typeTagEl.textContent = typeName;
    else typeTagEl?.remove();
    // Pill de rating global del plato (solo si es oficial y hay agregados)
    if (d.officialDishId) {
      const stat = getOfficialDishStat(d.officialDishId);
      if (stat && stat.ratingsCount > 0) {
        const infoEl = article.querySelector<HTMLElement>(".dish-info");
        infoEl?.appendChild(buildGlobalRatingPill(stat.avgRating, stat.ratingsCount));
      }
    }

    // La descripción ya NO se muestra en la card (solo en el modal de detalle).
    const badge = article.querySelector(".rating-badge")!;
    paintRatingBadge(badge, d.rating, { button: true });
    if (d.id === popDishId) badge.classList.add("badge-pop");
    badge.addEventListener("click", (e) => {
      e.stopPropagation();
      (window as any).dishForm.open("edit", d.restaurantId, d);
      menuPopup.classList.remove("active");
    });

    // ─── Setup menú popup ─────────────────────────────────────────────────────
    const btnMenu = article.querySelector<HTMLButtonElement>(".btn-menu")!;
    const menuPopup = article.querySelector<HTMLElement>(".menu-popup")!;

    btnMenu.addEventListener("click", (e) => {
      e.stopPropagation();
      // Cerrar otros menús abiertos
      document.querySelectorAll(".menu-popup.active").forEach((m) => {
        if (m !== menuPopup) {
          m.classList.remove("active");
        }
      });
      // Toggle menú actual
      menuPopup.classList.toggle("active");
    });

    const editBtn = article.querySelector<HTMLButtonElement>(".btn-edit-dish")!;
    editBtn.addEventListener("click", () => {
      (window as any).dishForm.open("edit", d.restaurantId, d);
      menuPopup.classList.remove("active");
    });
    article
      .querySelector<HTMLButtonElement>(".btn-recommend-dish")!
      .addEventListener("click", () => {
        (window as any).recommend?.open({
          type: "dish",
          id: d.id,
          title: d.name,
          subtitle: currentRestaurant?.name ?? null,
        });
        menuPopup.classList.remove("active");
      });
    const deleteBtn = article.querySelector<HTMLButtonElement>(".btn-delete-dish")!;
    if (d.officialDishId) {
      // Plato oficial: solo se permite calificar. No se puede editar la ficha ni
      // eliminarlo individualmente; el menú se limita a la acción de calificar.
      editBtn.querySelector("span")!.textContent = "Calificar";
      editBtn.querySelector("i")!.className = "bi bi-star-fill";
      deleteBtn.remove();
    } else {
      deleteBtn.addEventListener("click", () => {
        (window as any).confirmDialog.show(
          `¿Eliminar el plato "${d.name}"?`,
          () => {
            deleteDish(d.id);
            emit("dish:deleted", d.id);
          },
        );
        menuPopup.classList.remove("active");
      });
    }

    // Toda la card califica (mismo efecto que tocar la estrella). Los clics en el
    // menú de acciones no deben propagar hasta aquí; la estrella ya hace su propio
    // stopPropagation, así que no dispara doble.
    article.classList.add("is-rateable");
    article
      .querySelector(".dish-actions")
      ?.addEventListener("click", (e) => e.stopPropagation());
    article.addEventListener("click", () => {
      (window as any).dishForm.open("edit", d.restaurantId, d);
    });

    return article;
  }

  function renderDishes(
    filtered: Dish[],
    totalCount: number,
    dishesListEl: HTMLElement,
    sortBarEl: HTMLElement | null,
  ) {
    // Con pocos platos, buscar/ordenar/filtrar sobra: se ocultan para ver los
    // platos de una. Nunca mientras haya una búsqueda o filtro activo.
    const fewDishes = totalCount < 5 && !dishSearch && !dishTypeFilter;
    const searchWrapEl = document.querySelector<HTMLElement>(".dish-search-wrap");
    const controlsEl = document.querySelector<HTMLElement>(".dishes-controls");
    if (searchWrapEl) searchWrapEl.hidden = fewDishes;
    if (controlsEl) controlsEl.hidden = fewDishes;
    if (sortBarEl) sortBarEl.hidden = totalCount < 2;
    if (filtered.length === 0) {
      const isFiltering = !!dishSearch || !!dishTypeFilter;
      dishesListEl.innerHTML = isFiltering
        ? `<div class="empty-state flex-column">
             <i class="bi bi-search"></i>
             <p>Sin resultados para la búsqueda.</p>
           </div>`
        : `<div class="empty-state flex-column">
             <i class="bi bi-egg-fried"></i>
             <p>Aún no hay platos registrados.</p>
             <p class="empty-hint">Agrega el primer plato con el botón de arriba.</p>
           </div>`;
      return;
    }
    dishesListEl.innerHTML = "";
    // Stagger solo sin filtros activos (evita parpadeo al buscar/filtrar).
    dishesListEl.classList.toggle("stagger-in", !dishSearch && !dishTypeFilter);
    filtered.forEach((d) => dishesListEl.appendChild(buildDishCardElement(d)));
  }

  // ─── Funciones de render y wiring a nivel de módulo ───────────────────────
  // Consultan el DOM en cada llamada → inocuas en páginas sin estos elementos.

  function rerenderRestaurantePage() {
    const headerEl = document.getElementById("restaurant-header");
    const dishesListEl = document.getElementById("dishes-list");
    const sortBarEl = document.querySelector<HTMLElement>(".sort-bar");
    if (!headerEl || !dishesListEl || !currentRestaurant) return;

    renderTypeChips(); // antes de filtrar: puede resetear un tipo ya sin platos
    const avg = getRestaurantAverage(currentRestaurant.id);
    const filtered = getFilteredSortedDishes(currentRestaurant.id);
    const total = getDishesByRestaurant(currentRestaurant.id).length;
    topDishIds = getTopRatedDishIds(currentRestaurant.id);

    headerEl.replaceChildren(buildHeaderElement(currentRestaurant, avg));
    renderDishes(filtered, total, dishesListEl, sortBarEl);
    popDishId = null; // el pop ya se aplicó en este render
  }

  // ─── Listeners permanentes a nivel de módulo ──────────────────────────────

  // Cerrar menús abiertos al hacer click fuera. Registrado 1× a nivel módulo
  // para no acumular listeners en cada render de card/header.
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest(".rh-menu")) {
      document.querySelectorAll(".rh-menu-popup.active").forEach((p) =>
        p.classList.remove("active"),
      );
    }
    if (!target.closest(".dish-menu")) {
      document.querySelectorAll(".menu-popup.active").forEach((p) =>
        p.classList.remove("active"),
      );
    }
  });

  document.addEventListener("dish:created", (e) => {
    if (!currentRestaurant) return;
    popDishId = ((e as CustomEvent).detail as Dish | undefined)?.id ?? null;
    try {
      if (currentRestaurant.status === "pending") {
        const updated = markAsVisited(currentRestaurant.id);
        if (updated) {
          currentRestaurant = updated;
          // Actualizar backLink para que "Volver" lleve a todos
          const bl = document.getElementById(
            "back-link",
          ) as HTMLAnchorElement | null;
          if (bl) bl.href = "/?tab=todos";
          emit("restaurant:visited", updated);
        }
      }
    } catch (err) {
      console.error("[dish:created] markAsVisited error:", err);
    }
    rerenderRestaurantePage();
  });

  document.addEventListener("dish:updated", (e) => {
    popDishId = ((e as CustomEvent).detail as Dish | undefined)?.id ?? null;
    rerenderRestaurantePage();
  });

  // Auto-promueve pending → visitado SOLO cuando un plato pasa por primera vez
  // de sin calificar a calificado. No reacciona a edits de notas / nombre, así
  // un pending puesto manualmente por el usuario no se revierte.
  document.addEventListener("dish:first-rated", (e) => {
    if (!currentRestaurant || currentRestaurant.status !== "pending") return;
    popDishId = ((e as CustomEvent).detail as Dish | undefined)?.id ?? null;
    try {
      const updated = markAsVisited(currentRestaurant.id);
      if (updated) {
        currentRestaurant = updated;
        const bl = document.getElementById(
          "back-link",
        ) as HTMLAnchorElement | null;
        if (bl) bl.href = "/?tab=todos";
        emit("restaurant:visited", updated);
      }
    } catch (err) {
      console.error("[dish:first-rated] markAsVisited error:", err);
    }
    rerenderRestaurantePage();
  });
  document.addEventListener("dish:deleted", () => {
    if (currentRestaurant?.status === "visited") {
      const remaining = getDishesByRestaurant(currentRestaurant.id);
      if (remaining.length === 0) {
        const updated = markAsPending(currentRestaurant.id);
        if (updated) {
          currentRestaurant = updated;
          const bl = document.getElementById(
            "back-link",
          ) as HTMLAnchorElement | null;
          if (bl) bl.href = "/?tab=pendientes";
          emit("restaurant:updated", updated);
        }
      }
    }
    rerenderRestaurantePage();
  });

  document.addEventListener("restaurant:updated", (e) => {
    try {
      const updated = (e as CustomEvent).detail as Restaurant;
      if (updated?.id === currentRestaurant?.id) currentRestaurant = updated;
    } catch (err) {
      console.error("[restaurant:updated] error:", err);
    }
    rerenderRestaurantePage();
  });

  document.addEventListener("cache:synced", () => {
    if (!currentRestaurant) return;
    const fresh = getRestaurants().find((r) => r.id === currentRestaurant!.id);
    if (fresh) currentRestaurant = fresh;
    rerenderRestaurantePage();
  });

  document.addEventListener("stats:synced", () => {
    if (currentRestaurant) rerenderRestaurantePage();
  });

  // ─── PRE-RENDER en astro:after-swap ────────────────────────────────────────

  document.addEventListener("astro:after-swap", () => {
    const headerEl = document.getElementById("restaurant-header");
    if (!headerEl || !isCacheLoaded()) return;

    const id = new URLSearchParams(window.location.search).get("id") ?? "";
    const restaurant = getRestaurants().find((r) => r.id === id);
    if (!restaurant) return;

    document.title = `${restaurant.name} · STAURANT`;

    const avg = getRestaurantAverage(restaurant.id);
    const filtered = getFilteredSortedDishes(restaurant.id);
    const total = getDishesByRestaurant(restaurant.id).length;
    topDishIds = getTopRatedDishIds(restaurant.id);

    headerEl.replaceChildren(buildHeaderElement(restaurant, avg));

    const dishesListEl = document.getElementById("dishes-list");
    const sortBarEl = document.querySelector<HTMLElement>(".sort-bar");
    if (!dishesListEl) return;

    renderDishes(filtered, total, dishesListEl, sortBarEl);
  });

  // ─── Init completo en astro:page-load ──────────────────────────────────────

  document.addEventListener("astro:page-load", async () => {
    const headerEl = document.getElementById("restaurant-header");
    if (!headerEl) return;

    // Inject dish skeleton cards while cache loads (first visit only)
    if (!isCacheLoaded()) {
      const dishesListEl = document.getElementById("dishes-list") as HTMLElement | null;
      if (dishesListEl) {
        dishesListEl.innerHTML = "";
        for (let i = 0; i < 4; i++) {
          const sk = document.createElement("div");
          sk.className = "skeleton-card skeleton-dish";
          dishesListEl.appendChild(sk);
        }
      }
    }

    const {
      data: { session },
    } = await withLoading(supabase.auth.getSession());
    if (!session) {
      window.location.href = "/login";
      return;
    }

    await withLoading(initCache(session.user.id));

    const id = new URLSearchParams(window.location.search).get("id") ?? "";
    currentRestaurant = getRestaurants().find((r) => r.id === id);

    if (currentRestaurant)
      document.title = `${currentRestaurant.name} · STAURANT`;

    const backLink = document.getElementById("back-link") as HTMLAnchorElement;
    if (backLink)
      backLink.href = `/?tab=${currentRestaurant?.status === "pending" ? "pendientes" : "todos"}`;
    if (!currentRestaurant) {
      window.location.href = "/";
      return;
    }

    // ─── Sort UI ──────────────────────────────────────────────────────────────

    function updateDishSortUI() {
      updateSortPills(dishSort.field, dishSort.dir);
    }

    // ─── Cablear controles ────────────────────────────────────────────────────

    wireSortBar((field, dir) => {
      dishSort = { field: field as SortField, dir };
      setSortState(dishSort);
      updateDishSortUI();
      rerenderRestaurantePage();
      scrollToDishes();
    });

    const searchEl = document.getElementById(
      "dish-search",
    ) as HTMLInputElement | null;
    const clearEl = document.getElementById(
      "dish-search-clear",
    ) as HTMLButtonElement | null;
    const syncClear = () => {
      if (clearEl) clearEl.hidden = dishSearch.length === 0;
    };
    if (searchEl) {
      searchEl.value = dishSearch;
      syncClear();
      searchEl.oninput = () => {
        dishSearch = searchEl.value;
        syncClear();
        rerenderRestaurantePage();
      };
    }
    if (clearEl) {
      clearEl.onclick = () => {
        dishSearch = "";
        if (searchEl) {
          searchEl.value = "";
          searchEl.focus();
        }
        syncClear();
        rerenderRestaurantePage();
      };
    }

    // ─── Fix botón Atrás del navegador ────────────────────────────────────────
    // ViewTransitions no intercepta popstate en todos los casos; forzar navigate.

    const onPopState = () => navigate(window.location.href);
    window.addEventListener("popstate", onPopState);
    document.addEventListener(
      "astro:before-preparation",
      () => {
        window.removeEventListener("popstate", onPopState);
      },
      { once: true },
    );

    // ─── Render inicial con event wiring ─────────────────────────────────────

    updateDishSortUI();
    rerenderRestaurantePage();
  });
</script>
