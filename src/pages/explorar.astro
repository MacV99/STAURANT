---
import Layout1 from "../layouts/Layout1.astro";
---

<Layout1 title="Explorar · STAURANT">
  <div class="explore-page flex-column">
    <div class="explore-header flex-column">
      <h1 class="explore-title">Explorar Restaurantes</h1>
      <p class="explore-sub">
        Descubre los restaurantes oficiales de la plataforma y agrégalos a tu
        colección.
      </p>
    </div>

    <div class="explore-search-wrap">
      <i class="bi bi-search-fill explore-search-icon"></i>
      <input
        id="explore-search"
        class="explore-search-input"
        type="search"
        placeholder="Buscar restaurante oficial..."
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <div class="explore-controls flex-row">
      <div class="type-filter-wrap">
        <button id="explore-city-btn" class="type-pill" type="button" hidden>
          <span class="type-pill-label">Ciudad</span>
          <span id="explore-city-value" class="type-pill-value">Todas</span>
          <i class="bi bi-chevron-down"></i>
        </button>
        <div id="explore-city-dropdown" class="type-dropdown" hidden></div>
      </div>
    </div>

    <div id="explore-list" class="flex-column"></div>
  </div>
</Layout1>

<style>
  .explore-page {
    width: 100%;
    max-width: 1100px;
    padding: 20px 16px 100px;
    align-items: stretch;
    gap: 16px;
  }

  .explore-header {
    align-items: flex-start;
    gap: 4px;
  }

  .explore-title {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: var(--clr-text);
  }

  .explore-sub {
    font-size: 0.88rem;
    color: var(--clr-text);
    opacity: 0.65;
    line-height: 1.45;
  }

  .explore-search-wrap {
    position: relative;
    width: 100%;
  }

  .explore-search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--clr-text);
    opacity: 0.45;
    font-size: 0.95rem;
    pointer-events: none;
  }

  .explore-search-input {
    width: 100%;
    padding: 11px 16px 11px 38px;
    border-radius: var(--border-radius);
    border: 1.5px solid var(--clr-border);
    background: var(--clr-white);
    font-size: 0.9rem;
    color: var(--clr-text);
    transition: border-color var(--transition);
  }

  .explore-search-input::placeholder {
    color: var(--clr-text);
    opacity: 0.5;
  }

  .explore-search-input:focus {
    outline: none;
    border-color: var(--clr-border2);
  }

  .explore-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .explore-controls {
    justify-content: flex-start;
  }

  /* Filtro pill de ciudad — gemelo del filtro de tipo (restaurante/oficial).
     Las opciones del dropdown se estilan en project.css (.type-dropdown). */
  .type-filter-wrap {
    position: relative;
  }

  .type-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 12px;
    border-radius: 20px;
    border: solid 1.5px var(--clr-border);
    background: var(--clr-white);
    color: var(--clr-text);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: var(--transition);
  }

  .type-pill[hidden] {
    display: none;
  }

  .type-pill.active {
    background: var(--clr-primary);
    border-color: var(--clr-primary);
    color: var(--clr-white);
  }

  .type-pill-label {
    opacity: 0.5;
  }

  .type-pill-value {
    font-weight: 700;
  }

  .type-pill i {
    font-size: 0.65rem;
  }

  .type-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: max-content;
    background: var(--clr-white);
    border: 1.5px solid var(--clr-border);
    border-radius: var(--border-radius);
    z-index: 200;
    max-height: 260px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  #explore-list {
    align-items: stretch;
    gap: 7px;
  }

  @media (hover: hover) {
    .type-pill:hover {
      border-color: var(--clr-border2);
    }
  }

  @media (min-width: 768px) {
    .explore-page {
      padding: 28px 24px 80px;
    }

    #explore-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
  }
</style>

<style is:global>
  .explore-card {
    background: var(--clr-white);
    border: 1px solid var(--clr-border);
    border-radius: 18px;
    padding: 16px;
    justify-content: space-between;
    gap: 12px;
    cursor: pointer;
    transition: var(--transition);
  }

  /* .explore-card.is-official (borde de oro giratorio) → estilo compartido en
     project.css junto a .restaurant-card / .rh-card. */

  .explore-card:active {
    transform: scale(0.98);
  }

  .explore-card .ec-body {
    align-items: flex-start;
    min-width: 0;
    gap: 6px;
  }

  .explore-card h3 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    color: var(--clr-text);
    word-break: break-word;
    line-height: 1.25;
  }

  .explore-card .ec-meta {
    justify-content: flex-start;
    gap: 6px;
    flex-wrap: wrap;
  }

  .explore-card .ec-adopted {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    color: var(--clr-success);
    background: var(--clr-success-bg);
    border: solid 1px var(--clr-success-border);
    border-radius: 20px;
    padding: 2px 8px;
  }

  .explore-card .ec-chevron {
    color: var(--clr-text);
    opacity: 0.35;
    font-size: 1rem;
    flex-shrink: 0;
    align-self: center;
  }

  @media (hover: hover) {
    .explore-card:hover {
      border-color: var(--clr-border2);
    }
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";
  import { supabase } from "../lib/supabase.ts";
  import {
    initCache,
    isOfficialInMyList,
    getAllOfficialRestaurants,
    getOfficialRestaurantStat,
    type OfficialRestaurant,
  } from "../lib/data.ts";
  import { buildGlobalRatingPill } from "../scripts/store.ts";

  // Estado a nivel de módulo (persiste entre navegaciones ViewTransition).
  let officials: OfficialRestaurant[] = [];
  let exploreSearch = "";
  let cityFilter = ""; // "" = todas las ciudades

  /** Ciudades distintas de todos los oficiales, ordenadas alfabéticamente. */
  function distinctCities(): string[] {
    const set = new Set<string>();
    for (const o of officials) for (const c of o.cities) if (c) set.add(c);
    return [...set].sort((a, b) => a.localeCompare(b));
  }

  function buildCard(o: OfficialRestaurant): HTMLElement {
    // ¿El usuario ya tiene este oficial en su lista? (membresía, sin clon)
    const adopted = isOfficialInMyList(o.id);
    const stat = getOfficialRestaurantStat(o.id);

    const card = document.createElement("article");
    card.className = "explore-card card-clickable flex-row is-official";
    card.setAttribute("data-id", o.id);

    // Marco de oro giratorio (estilo compartido en project.css)
    const sheet = document.createElement("div");
    sheet.className = "holo-sheet";
    sheet.setAttribute("aria-hidden", "true");
    card.appendChild(sheet);

    const body = document.createElement("div");
    body.className = "ec-body flex-column";

    const h3 = document.createElement("h3");
    h3.textContent = o.name;
    const verified = document.createElement("i");
    verified.className = "bi bi-patch-check-fill verified-badge";
    verified.title = "Restaurante verificado";
    h3.appendChild(verified);
    body.appendChild(h3);

    const meta = document.createElement("div");
    meta.className = "ec-meta flex-row";

    // La ciudad NO se muestra en la card: solo alimenta el filtro de arriba.
    if (stat && stat.ratingsCount > 0) {
      meta.appendChild(buildGlobalRatingPill(stat.avgRating, stat.ratingsCount));
    }

    if (adopted) {
      const tag = document.createElement("span");
      tag.className = "ec-adopted";
      tag.innerHTML = `<i class="bi bi-check-circle-fill"></i> En tu lista`;
      meta.appendChild(tag);
    }

    body.appendChild(meta);
    card.appendChild(body);

    const chevron = document.createElement("i");
    chevron.className = "bi bi-chevron-right ec-chevron";
    card.appendChild(chevron);

    // Perfil oficial único y compartido: siempre se abre la misma vista /oficial,
    // esté o no en tu lista. El estado personal se refleja dentro del perfil.
    card.addEventListener("click", () => navigate(`/oficial?id=${o.id}`));
    return card;
  }

  function render() {
    const listEl = document.getElementById("explore-list");
    if (!listEl) return;

    const q = exploreSearch.toLowerCase().trim();
    let filtered = officials;
    if (cityFilter) filtered = filtered.filter((o) => o.cities.includes(cityFilter));
    if (q)
      filtered = filtered.filter(
        (o) =>
          o.name.toLowerCase().includes(q) ||
          o.cities.some((c) => c.toLowerCase().includes(q)),
      );

    const hasFilter = !!q || !!cityFilter;
    if (filtered.length === 0) {
      listEl.innerHTML = `<div class="empty-state flex-column">
           <i class="bi bi-${hasFilter ? "search" : "shop"}"></i>
           <p>${hasFilter ? "Sin resultados para tu filtro." : "Aún no hay restaurantes oficiales."}</p>
         </div>`;
      return;
    }

    listEl.innerHTML = "";
    const frag = document.createDocumentFragment();
    filtered.forEach((o) => frag.appendChild(buildCard(o)));
    listEl.appendChild(frag);
  }

  // ─── Filtro por ciudad ──────────────────────────────────────────────────────

  function updateCityFilterUI(): void {
    const btn = document.getElementById(
      "explore-city-btn",
    ) as HTMLButtonElement | null;
    const valueEl = document.getElementById("explore-city-value");
    if (!btn || !valueEl) return;
    const cities = distinctCities();
    // Sin ciudades no hay nada que filtrar → se oculta el pill.
    if (cities.length === 0) {
      cityFilter = "";
      btn.hidden = true;
      return;
    }
    btn.hidden = false;
    // Si la ciudad activa ya no existe (cache cambió), se resetea a "todas".
    if (cityFilter && !cities.includes(cityFilter)) cityFilter = "";
    valueEl.textContent = cityFilter || "Todas";
    btn.classList.toggle("active", !!cityFilter);
  }

  function renderCityDropdown(): void {
    const dropdownEl = document.getElementById("explore-city-dropdown");
    if (!dropdownEl) return;
    dropdownEl.innerHTML = "";

    const noneOpt = document.createElement("div");
    noneOpt.className = "type-option is-none";
    noneOpt.textContent = "Todas las ciudades";
    noneOpt.addEventListener("mousedown", (e) => e.preventDefault());
    noneOpt.addEventListener("click", () => selectCity(""));
    dropdownEl.appendChild(noneOpt);

    distinctCities().forEach((name) => {
      const opt = document.createElement("div");
      opt.className = "type-option" + (name === cityFilter ? " is-selected" : "");
      opt.textContent = name;
      opt.addEventListener("mousedown", (e) => e.preventDefault());
      opt.addEventListener("click", () => selectCity(name));
      dropdownEl.appendChild(opt);
    });
  }

  function selectCity(name: string): void {
    cityFilter = name;
    updateCityFilterUI();
    closeCityDropdown();
    render();
  }

  function openCityDropdown(): void {
    const dropdownEl = document.getElementById("explore-city-dropdown");
    const btn = document.getElementById("explore-city-btn");
    if (!dropdownEl || !btn) return;
    renderCityDropdown();
    dropdownEl.hidden = false;
    btn.classList.add("is-open");
  }

  function closeCityDropdown(): void {
    const dropdownEl = document.getElementById("explore-city-dropdown");
    const btn = document.getElementById("explore-city-btn");
    dropdownEl?.setAttribute("hidden", "");
    btn?.classList.remove("is-open");
  }

  function wireCityFilter(): void {
    const btn = document.getElementById("explore-city-btn");
    if (!btn) return;
    // .onclick (no addEventListener) → se reasigna en cada page-load sin acumular.
    btn.onclick = (e) => {
      e.stopPropagation();
      const dropdownEl = document.getElementById("explore-city-dropdown");
      if (dropdownEl?.hidden) openCityDropdown();
      else closeCityDropdown();
    };
  }

  // Re-render cuando lleguen stats globales o cambie el cache (adopción).
  document.addEventListener("stats:synced", render);
  document.addEventListener("cache:synced", render);

  // Clic fuera → cierra el dropdown de ciudad. A nivel módulo (una sola vez) para
  // no acumular listeners en cada astro:page-load.
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (
      !target.closest("#explore-city-dropdown") &&
      !target.closest("#explore-city-btn")
    )
      closeCityDropdown();
  });

  document.addEventListener("astro:page-load", async () => {
    const listEl = document.getElementById("explore-list");
    if (!listEl) return; // no estamos en esta página

    const {
      data: { session },
    } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = "/login";
      return;
    }

    // Skeletons mientras carga
    if (officials.length === 0) {
      listEl.innerHTML = "";
      for (let i = 0; i < 5; i++) {
        const sk = document.createElement("div");
        sk.className = "skeleton-card";
        listEl.appendChild(sk);
      }
    }

    await initCache(session.user.id);

    // Búsqueda
    const searchEl = document.getElementById(
      "explore-search",
    ) as HTMLInputElement | null;
    if (searchEl) {
      searchEl.value = exploreSearch;
      searchEl.oninput = () => {
        exploreSearch = searchEl.value;
        render();
      };
    }

    wireCityFilter();

    officials = await getAllOfficialRestaurants();
    updateCityFilterUI();
    render();
  });
</script>
