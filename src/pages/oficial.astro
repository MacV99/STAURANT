---
import Layout1 from "../layouts/Layout1.astro";
import DishCard from "../components/DishCard.astro";
import RestaurantHeader from "../components/RestaurantHeader.astro";
import SortBar from "../components/SortBar.astro";
import AuthModal from "../components/AuthModal.astro";
import DishForm from "../components/DishForm.astro";
import NoticeDialog from "../components/NoticeDialog.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";
import OfficialManage from "../components/OfficialManage.astro";
import type { Dish, Restaurant } from "../lib/data";

// Plantillas para clonar en runtime (mismo patrón que restaurante.astro): así la
// carta pública del QR usa EXACTAMENTE las mismas cards que el detalle personal.
const tplDish: Dish = {
  id: "",
  restaurantId: "",
  typeId: null,
  name: "...",
  rating: 5,
  notes: " ",
  createdAt: "",
  updatedAt: "",
  officialDishId: null,
};
const tplRestaurant: Restaurant = {
  id: "",
  name: "...",
  status: "visited",
  notes: " ",
  cities: [],
  createdAt: "",
  updatedAt: "",
  officialRestaurantId: "x",
};
---

<Layout1 title="Restaurante · STAURANT" bare>
  <div class="detail-page flex-column">
    {/* Logueado → mismo ← Volver que /restaurante. Anónimo (QR) → topbar pública
        con logo-marca + Iniciar sesión. Se alternan en astro:page-load. */}
    <a id="back-link" href="/" class="back-link flex-row" hidden>
      <i class="bi bi-arrow-left"></i> Volver
    </a>

    <div id="public-topbar" class="public-topbar flex-row" hidden>
      <a href="/" class="pt-brand flex-row" aria-label="STAURANT">
        <img src="/img/logo2.png" alt="STAURANT" class="pt-logo" />
      </a>
      <a id="login-link" href="/login" class="pt-action flex-row">
        <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
      </a>
    </div>

    <div id="oficial-header" class="restaurant-header"></div>

    {/* Banner de vista visitante: SOLO para el dueño mientras NO está en modo
        admin. El dueño ve su restaurante EXACTAMENTE como un visitante (puede
        calificar), y este banner ofrece el interruptor para entrar a gestión. */}
    <div id="visitor-banner" class="visitor-banner flex-row" hidden>
      <span class="vb-label">
        <i class="bi bi-eye"></i> Estás viendo como visitante
      </span>
      <button id="enter-admin-btn" class="vb-btn" type="button">
        <i class="bi bi-shield-lock"></i> Modo administrador
      </button>
    </div>

    {/* Barra de gestión: visible solo si el usuario es DUEÑO de este perfil
        (fila en official_owners) Y activó el modo administrador. Da acceso a
        estadísticas, editar el perfil y agregar platos a la carta. */}
    <div id="owner-bar" class="owner-bar" hidden>
      <div class="owner-bar-top flex-row">
        <span class="owner-badge">
          <i class="bi bi-shield-check"></i> Modo administrador
        </span>
        <button id="exit-admin-btn" class="owner-exit" type="button">
          <i class="bi bi-eye"></i> <span>Ver como visitante</span>
        </button>
      </div>
      <div class="owner-actions">
        <button id="owner-stats-btn" class="owner-act" type="button">
          <i class="bi bi-bar-chart-line"></i> <span>Estadísticas</span>
        </button>
        <button id="owner-edit-btn" class="owner-act" type="button">
          <i class="bi bi-pencil"></i> <span>Editar</span>
        </button>
        <button id="owner-add-dish-btn" class="owner-act is-primary" type="button">
          <i class="bi bi-plus-lg"></i> <span>Plato</span>
        </button>
      </div>
    </div>

    <div class="dishes-section flex-column">
      <div class="dishes-top flex-row">
        <h2 class="dishes-title">Platos</h2>
      </div>

      <div class="dish-search-wrap">
        <i class="bi bi-search-fill dish-search-icon"></i>
        <input
          id="dish-search"
          class="dish-search-input"
          type="search"
          placeholder="Buscar plato..."
          autocomplete="off"
          spellcheck="false"
        />
        <button
          id="dish-search-clear"
          class="dish-search-clear"
          type="button"
          aria-label="Limpiar búsqueda"
          hidden
        >
          <i class="bi bi-x-circle-fill"></i>
        </button>
      </div>

      <div class="dishes-controls flex-row">
        <SortBar
          pills={[
            { field: "rating", label: "Rating" },
            { field: "name", label: "Nombre" },
          ]}
        />
        <div class="type-filter-wrap">
          <button id="dish-type-btn" class="type-pill">
            <span class="type-pill-label">Tipo</span>
            <span id="dish-type-value" class="type-pill-value">Todos</span>
            <i class="bi bi-chevron-down"></i>
          </button>
          <div id="dish-type-dropdown" class="type-dropdown" hidden></div>
        </div>
      </div>

      <div id="dishes-list" class="flex-column"></div>
    </div>
  </div>

  <AuthModal />
  <DishForm />
  <NoticeDialog />
  <ConfirmDialog />
  <OfficialManage />

  <template id="tpl-dish-card">
    <DishCard dish={tplDish} typeName="..." />
  </template>

  <template id="tpl-restaurant-header">
    <RestaurantHeader restaurant={tplRestaurant} avg={5} dishCount={0} />
  </template>
</Layout1>

<style is:global>
  /* Controles edit/eliminar por plato (modo dueño). Van en :global porque los
     botones se crean con createElement → el CSS scoped no los alcanza. */
  .dish-card .owner-dish-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .dish-card .owner-dish-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--clr-border);
    background: var(--clr-white);
    color: var(--clr-text);
    opacity: 0.7;
    cursor: pointer;
    font-size: 0.85rem;
    padding: 0;
    transition: var(--transition);
  }

  /* Superficie danger suave (mismo criterio que el botón Quitar). */
  .dish-card .owner-dish-btn.is-delete {
    color: var(--clr-danger);
    background: var(--clr-danger-bg);
    border-color: var(--clr-danger-border-soft);
    opacity: 1;
  }

  @media (hover: hover) {
    .dish-card .owner-dish-btn:hover {
      background: var(--clr-white2);
      opacity: 1;
    }

    .dish-card .owner-dish-btn.is-delete:hover {
      background: var(--clr-danger-bg-strong);
    }
  }

  /* ══ Ficha editorial de la carta oficial (.official-dish) ══════════════════
     Reestiliza la DishCard reusada SOLO para /oficial. Sin foto, el espacio se
     reparte como una ficha: eyebrow de tipo, nombre fuerte, descripción a 2
     líneas, fila meta (precio + pill) al pie, y el badge de nota a la derecha
     como "score". No afecta las cards personales (sin esta clase). */
  .dish-card.official-dish {
    align-items: center;
    gap: 14px;
    padding: 15px 16px;
    border-radius: 16px;
  }

  /* Columna de contenido a la izquierda; badge de nota empujado a la derecha. */
  .dish-card.official-dish .dish-info {
    order: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .dish-card.official-dish .rating-badge {
    order: 2;
  }

  .dish-card.official-dish .owner-dish-actions,
  .dish-card.official-dish .dish-actions {
    order: 3;
  }

  /* Tipo → eyebrow: etiqueta pequeña en versalitas ARRIBA del nombre (order:-1),
     sin fondo de pill. Look de ficha, no de chip. */
  .dish-card.official-dish .dish-type-tag {
    order: -1;
    margin: 0 0 1px;
    padding: 0;
    background: none;
    border-radius: 0;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: var(--clr-text);
    opacity: 0.45;
  }

  .dish-card.official-dish h4 {
    font-size: 1.02rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.1px;
    /* Look de ficha uniforme: nombre en mayúsculas sin importar cómo se guardó
       el dato (igual que el modal .official-name). */
    text-transform: uppercase;
  }

  /* Descripción: gris, máx 2 líneas (elipsis) para no descuadrar la card. */
  .dish-card.official-dish .dish-notes {
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Fila meta al pie: pill secundario del otro lente (el precio vive en el modal). */
  .dish-card.official-dish .od-meta {
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  /* Badge de nota: score a la derecha. Un pelín más grande = jerarquía clara. */
  .dish-card.official-dish .rating-badge {
    flex-shrink: 0;
    transform: scale(1.06);
  }

  @media (hover: hover) {
    /* Realce sutil al pasar el mouse (solo card calificable). */
    .dish-card.official-dish.is-rateable:hover {
      border-color: var(--clr-border2);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    }
  }

</style>

<style>
  .detail-page {
    width: 100%;
    max-width: 760px;
    padding: 20px 16px 80px;
    align-items: stretch;
    gap: 24px;
  }

  /* ← Volver: idéntico al de /restaurante (mismo tamaño, color y hover). */
  .back-link {
    justify-content: flex-start;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--clr-primary);
    letter-spacing: 1px;
    width: fit-content;
    padding: 6px 0;
    transition: var(--transition);
  }

  .back-link[hidden] {
    display: none;
  }

  .public-topbar {
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 12px;
  }

  .public-topbar[hidden] {
    display: none;
  }

  .pt-brand {
    justify-content: flex-start;
    text-decoration: none;
  }

  .pt-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  .pt-action {
    justify-content: flex-end;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--clr-primary);
    letter-spacing: 0.3px;
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1.5px solid var(--clr-border);
    transition: var(--transition);
    white-space: nowrap;
  }

  .pt-action[hidden] {
    display: none;
  }

  .pt-action i {
    font-size: 0.95rem;
  }

  @media (hover: hover) {
    .pt-action:hover {
      background: var(--clr-white2);
    }

    .back-link:hover {
      color: var(--clr-text);
    }
  }

  .restaurant-header {
    width: 100%;
  }

  /* ── Banner de vista visitante (dueño, modo NO admin) ───────────────────── */
  .visitor-banner {
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 14px;
    border-radius: var(--border-radius);
    background: var(--clr-white2);
    border: 1px dashed var(--clr-border);
  }

  .visitor-banner[hidden] {
    display: none;
  }

  .vb-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2px;
    color: var(--clr-text);
    opacity: 0.7;
  }

  .vb-label i {
    font-size: 0.85rem;
  }

  .vb-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--clr-primary);
    background: var(--clr-primary);
    color: var(--clr-white);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition);
  }

  .vb-btn i {
    font-size: 0.8rem;
  }

  @media (hover: hover) {
    .vb-btn:hover {
      background: var(--clr-primary-dark);
      border-color: var(--clr-primary-dark);
    }
  }

  /* ── Barra de gestión del dueño ─────────────────────────────────────────── */
  .owner-bar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    width: 100%;
    padding: 14px 16px;
    border-radius: var(--border-radius);
    /* Fondo verde muy tenue en vez de borde grueso: comunica "modo gestión" sin
       recargar visualmente. */
    background: color-mix(in srgb, var(--clr-primary) 6%, var(--clr-white));
    border: 1px solid color-mix(in srgb, var(--clr-primary) 22%, transparent);
  }

  .owner-bar[hidden] {
    display: none;
  }

  /* Fila superior: badge "modo admin" a la izquierda, salir a la derecha. */
  .owner-bar-top {
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .owner-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--clr-primary);
    opacity: 0.85;
  }

  .owner-badge i {
    font-size: 0.85rem;
  }

  /* Salir de admin → volver a vista visitante. Discreto (texto + ícono). */
  .owner-exit {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--clr-border);
    background: var(--clr-white);
    color: var(--clr-text);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2px;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition);
  }

  .owner-exit i {
    font-size: 0.78rem;
    opacity: 0.75;
  }

  @media (hover: hover) {
    .owner-exit:hover {
      background: var(--clr-white2);
    }
  }

  /* 3 botones que reparten el ancho por igual: predecible en móvil y desktop. */
  .owner-actions {
    display: flex;
    gap: 8px;
  }

  .owner-act {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 9px;
    border: 1px solid var(--clr-border);
    background: var(--clr-white);
    color: var(--clr-text);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2px;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition);
  }

  .owner-act i {
    font-size: 0.8rem;
    opacity: 0.75;
  }

  .owner-act.is-primary {
    background: var(--clr-primary);
    border-color: var(--clr-primary);
    color: var(--clr-white);
  }

  .owner-act.is-primary i {
    opacity: 1;
  }

  @media (hover: hover) {
    .owner-act:hover {
      background: var(--clr-white2);
    }

    .owner-act:hover i {
      opacity: 1;
    }

    .owner-act.is-primary:hover {
      background: var(--clr-primary-dark);
      border-color: var(--clr-primary-dark);
      color: var(--clr-white);
    }
  }

  @media (min-width: 768px) {
    /* En desktop: badge a la izquierda, acciones compactas a la derecha. */
    .owner-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .owner-actions {
      flex: 0 0 auto;
    }

    .owner-act {
      flex: 0 0 auto;
      padding: 8px 14px;
    }
  }

  .dishes-section {
    align-items: stretch;
    gap: 12px;
  }

  .dishes-top {
    justify-content: flex-start;
  }

  .dishes-title {
    font-size: 1rem;
    letter-spacing: 2px;
    color: var(--clr-text);
  }

  .dish-search-wrap {
    position: relative;
    width: 100%;
  }

  .dish-search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--clr-text);
    opacity: 0.4;
    font-size: 0.85rem;
    pointer-events: none;
  }

  .dish-search-input {
    width: 100%;
    padding: 9px 14px 9px 34px;
    border-radius: var(--border-radius);
    border: 1.5px solid var(--clr-border);
    background: var(--clr-white);
    font-size: 0.88rem;
    color: var(--clr-text);
    transition: border-color var(--transition);
  }

  .dish-search-input::placeholder {
    color: var(--clr-text);
    opacity: 0.5;
  }

  .dish-search-input:focus {
    outline: none;
    border-color: var(--clr-border2);
  }

  .dish-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .dish-search-input:not(:placeholder-shown) {
    padding-right: 38px;
  }

  .dish-search-clear {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: 6px;
    color: var(--clr-text);
    opacity: 0.55;
    cursor: pointer;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: opacity var(--transition);
  }

  .dish-search-clear[hidden] {
    display: none;
  }

  @media (hover: hover) {
    .dish-search-clear:hover {
      opacity: 1;
    }
  }

  .dishes-controls {
    justify-content: flex-start;
    gap: 8px;
    flex-wrap: wrap;
  }

  .type-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 12px;
    border-radius: 20px;
    border: solid 1.5px var(--clr-border);
    background: var(--clr-white);
    color: var(--clr-text);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: none;
    cursor: pointer;
    transition: var(--transition);
  }

  .type-pill.active {
    background: var(--clr-primary);
    border-color: var(--clr-primary);
    color: var(--clr-white);
  }

  .type-pill-label {
    opacity: 0.5;
  }

  .type-pill-value {
    font-weight: 700;
  }

  .type-pill i {
    font-size: 0.65rem;
  }

  .type-filter-wrap {
    position: relative;
  }

  .type-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: max-content;
    background: var(--clr-white);
    border: 1.5px solid var(--clr-border);
    border-radius: var(--border-radius);
    z-index: 200;
    max-height: 220px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  #dishes-list {
    align-items: stretch;
    gap: 5px;
  }

  @media (hover: hover) {
    .type-pill:hover {
      border-color: var(--clr-border2);
    }
  }

  @media (min-width: 768px) {
    .detail-page {
      padding: 28px 24px 80px;
    }
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";
  import { supabase } from "../lib/supabase.ts";
  import {
    initCache,
    getOfficialRestaurant,
    getOfficialByHandle,
    officialUrl,
    getOfficialDishes,
    getOfficialRestaurantStat,
    getOfficialDishStat,
    addOfficialToMyList,
    getMyOfficialRating,
    getMyOfficialAverage,
    getMyOfficialStatus,
    fetchOfficialStats,
    checkOfficialOwnership,
    deleteOfficialDish,
    type OfficialRestaurant,
    type OfficialDish,
  } from "../lib/data.ts";
  import {
    paintRatingBadge,
    buildGlobalRatingPill,
    fillRestaurantName,
    updateSortPills,
    makeCrown,
  } from "../scripts/store.ts";

  // ─── Estado del módulo ──────────────────────────────────────────────────────

  let official: OfficialRestaurant | null = null;
  let officialDishes: OfficialDish[] = [];
  // userId = null → visitante anónimo (puede navegar la carta pero no calificar).
  let userId: string | null = null;
  // isOwner = true → el usuario es DUEÑO de este perfil (fila en official_owners).
  // Es una CAPACIDAD, no un modo: habilita el interruptor a modo administrador,
  // pero por sí sola NO cambia la vista (el dueño ve como visitante y puede calificar).
  let isOwner = false;
  // adminMode = true → el dueño activó el "Modo administrador": barra de gestión
  // visible y cards en modo edición (editar/eliminar plato). false = vista visitante
  // idéntica a la de cualquier usuario. Arranca SIEMPRE en false en cada page-load.
  let adminMode = false;

  type SortField = "rating" | "name";
  let sortField: SortField = "rating";
  let sortDir: "asc" | "desc" = "desc";
  let dishSearch = "";
  let dishTypeFilter = ""; // por typeName (los oficiales no tienen typeId)

  // IDs del/los mejor(es) plato(s) de la carta según TU nota. Recalculado antes de
  // cada render (la corona 👑 se mueve al cambiar tu nota).
  let topOfficialDishIds = new Set<string>();

  /** Mejor(es) plato(s) según TU nota personal (≥2 platos calificados por ti). */
  function computeTopMyOfficialDishIds(): Set<string> {
    const rated = officialDishes
      .map((od) => {
        const r = getMyRatingFor(od.id);
        return r !== null ? { id: od.id, rating: r } : null;
      })
      .filter((x): x is { id: string; rating: number } => x !== null);
    if (rated.length < 2) return new Set();
    const max = Math.max(...rated.map((x) => x.rating));
    return new Set(rated.filter((x) => x.rating === max).map((x) => x.id));
  }

  // ─── Auth ───────────────────────────────────────────────────────────────────

  async function ensureAuthState(): Promise<boolean> {
    const {
      data: { session },
    } = await supabase.auth.getSession();
    if (!session) {
      userId = null;
      return false;
    }
    userId = session.user.id;
    await initCache(userId);
    return true;
  }

  /** TU calificación de un plato oficial (null si anónimo / no calificado). */
  function getMyRatingFor(officialDishId: string): number | null {
    if (!userId) return null;
    return getMyOfficialRating(officialDishId);
  }

  // ─── Intención pendiente (reanudar tras redirect de Google) ─────────────────

  function storeIntent(officialDishId?: string): void {
    if (!official) return;
    localStorage.setItem("staurant_return_to", officialUrl(official));
    localStorage.setItem(
      "staurant_pending",
      JSON.stringify({
        officialId: official.id,
        officialDishId: officialDishId ?? null,
      }),
    );
  }

  // ─── Flujo de calificación ──────────────────────────────────────────────────

  function rateFlow(od: OfficialDish): void {
    if (userId) {
      void continueRate(od);
      return;
    }
    (window as any).authModal?.open({
      title: "Inicia sesión para calificar",
      onSuccess: async () => {
        if (await ensureAuthState()) continueRate(od);
      },
      onBeforeGoogle: () => storeIntent(od.id),
    });
  }

  /** Con sesión: agrega el oficial a mi lista (sin clon) y abre el modal de
   *  calificación aquí mismo. La nota se guarda en official_ratings; la membresía
   *  queda VISITADA al calificar. Se pueden calificar varios platos del tirón. */
  function continueRate(od: OfficialDish): void {
    if (!userId || !official) return;
    // Idempotente: registra la pertenencia + cachea perfil/carta para "Mi inicio".
    addOfficialToMyList(official, officialDishes);
    renderAll();
    (window as any).dishForm?.openOfficial(od, getMyOfficialRating(od.id));
  }

  /** Abre el modal del plato. Con sesión → flujo de calificación normal. Anónimo
   *  → modal en modo lectura: ve foto y detalles libremente; al intentar calificar
   *  se pide login y, tras entrar, se reanuda la calificación de ESE plato. */
  function openOfficialModal(od: OfficialDish): void {
    if (userId) {
      void continueRate(od);
      return;
    }
    (window as any).dishForm?.openOfficial(od, null, {
      onRequireAuth: () => rateFlow(od),
    });
  }

  // ─── Render (mismos componentes que /restaurante) ───────────────────────────

  /** Convierte lo que escribió el dueño (handle "@x", "x" o URL completa) en una
   *  URL navegable de la red. Si ya es http(s), se respeta tal cual. */
  function socialUrl(base: string, raw: string): string {
    const v = raw.trim();
    if (/^https?:\/\//i.test(v)) return v;
    return base + v.replace(/^@/, "");
  }

  /** Enlace de llamada directa. Conserva el + inicial y dígitos; quita el resto. */
  function telUrl(raw: string): string {
    const v = raw.trim();
    const digits = v.replace(/[^\d]/g, "");
    return "tel:" + (v.startsWith("+") ? "+" : "") + digits;
  }

  /** Rellena la fila de redes del header con solo los íconos que tienen valor. */
  function fillSocials(div: Element, o: OfficialRestaurant) {
    const row = div.querySelector<HTMLElement>(".rh-socials");
    if (!row) return;
    const links: [string, string | null][] = [
      [".rh-social-wa", o.phone ? telUrl(o.phone) : null],
      [".rh-social-ig", o.instagram ? socialUrl("https://instagram.com/", o.instagram) : null],
      [".rh-social-fb", o.facebook ? socialUrl("https://facebook.com/", o.facebook) : null],
      [".rh-social-tt", o.tiktok ? socialUrl("https://tiktok.com/@", o.tiktok) : null],
    ];
    let any = false;
    for (const [sel, href] of links) {
      const a = row.querySelector<HTMLAnchorElement>(sel);
      if (!a) continue;
      if (href) {
        a.href = href;
        a.hidden = false;
        any = true;
      } else {
        a.remove();
      }
    }
    if (any) row.hidden = false;
    else row.remove();
  }

  function buildHeaderElement(): Element {
    const tpl = document.getElementById(
      "tpl-restaurant-header",
    ) as HTMLTemplateElement;
    const div = (tpl.content.cloneNode(true) as DocumentFragment).querySelector(
      ".rh-card",
    )!;
    div.removeAttribute("style");
    div.classList.add("is-official");

    // Nombre + sello verificado
    fillRestaurantName(div.querySelector("h1")!, official!.name, true);

    // Conteo de platos
    const pill = div.querySelector(".dish-count-pill");
    if (pill)
      pill.innerHTML = `<i class="bi bi-journal-text"></i> ${officialDishes.length} ${officialDishes.length === 1 ? "plato" : "platos"}`;

    // Ciudad
    const citiesEl = div.querySelector(".rh-cities") as HTMLElement | null;
    const citiesListEl = div.querySelector(".rh-cities-list");
    if (citiesEl && citiesListEl && official!.cities.length > 0) {
      citiesListEl.textContent = official!.cities.join(" · ");
      citiesEl.hidden = false;
    }

    // Badge grande = TU promedio; pill secundario = 🌐 promedio del público.
    const stat = getOfficialRestaurantStat(official!.id);
    const myAvg = userId ? getMyOfficialAverage(official!.id) : null;
    const badge = div.querySelector(".rating-badge")!;
    const pillsRow = div.querySelector<HTMLElement>(".rh-pills");

    paintRatingBadge(badge, myAvg);
    if (stat && stat.ratingsCount > 0)
      pillsRow?.insertBefore(
        buildGlobalRatingPill(stat.avgRating, stat.ratingsCount),
        pillsRow.firstChild,
      );

    // Notas
    const notesEl = div.querySelector<HTMLElement>(".rh-notes");
    if (official!.notes) {
      if (notesEl) notesEl.textContent = official!.notes;
    } else {
      notesEl?.remove();
    }

    // Redes + WhatsApp: se muestra SOLO el ícono con valor; los vacíos quedan
    // ocultos (sin huecos). La fila entera se oculta si no hay ninguno.
    fillSocials(div, official!);

    // Sin menú de editar/eliminar: no es el restaurante del usuario todavía.
    div.querySelector(".rh-menu")?.remove();

    return div;
  }

  function buildDishCardElement(od: OfficialDish): Element {
    const tpl = document.getElementById("tpl-dish-card") as HTMLTemplateElement;
    const article = (
      tpl.content.cloneNode(true) as DocumentFragment
    ).querySelector("article")!;
    // Ficha editorial de la carta oficial (estilos scopeados a .official-dish,
    // sin tocar las cards personales que reusan .dish-card).
    article.classList.add("official-dish");
    article.setAttribute("data-id", od.id);
    article.querySelector("h4")!.textContent = od.name;

    // La foto del plato NO se muestra en la card: solo dentro del modal de
    // detalles/calificación (DishForm.openOfficial). Se elimina el <img> siempre
    // → cero espacio reservado, con o sin foto.
    article.querySelector(".dish-thumb")?.remove();

    const infoEl = article.querySelector<HTMLElement>(".dish-info")!;

    // Tipo → eyebrow (etiqueta pequeña ARRIBA del nombre vía CSS order).
    const typeTagEl = article.querySelector<HTMLElement>(".dish-type-tag");
    if (od.typeName && typeTagEl) typeTagEl.textContent = od.typeName;
    else typeTagEl?.remove();

    // Notas / descripción de la carta (antes de la fila meta).
    const notesEl = article.querySelector<HTMLElement>(".dish-notes");
    if (od.notes) {
      if (notesEl) notesEl.textContent = od.notes;
    } else {
      notesEl?.remove();
    }

    // Fila meta al pie: pill secundario del otro lente. El precio NO va en la
    // card — se muestra solo dentro del modal de detalle (DishForm.openOfficial).
    const stat = getOfficialDishStat(od.id);
    const globalAvg = stat && stat.ratingsCount > 0 ? stat.avgRating : null;
    const myRating = getMyRatingFor(od.id);
    const meta = document.createElement("div");
    meta.className = "od-meta flex-row";

    // Pill secundario = 🌐 nota de la comunidad (si existe).
    if (stat && stat.ratingsCount > 0)
      meta.appendChild(buildGlobalRatingPill(stat.avgRating, stat.ratingsCount));

    if (meta.children.length) infoEl.appendChild(meta);

    // Badge grande = TU nota. Vacío = estrella que invita a tocar y calificar.
    const badge = article.querySelector(".rating-badge")!;
    const badgeScore = myRating;

    // ── Modo ADMINISTRADOR: la card se edita, no se califica ─────────────────
    // El badge muestra el promedio del público (informativo, sin botón) y en su
    // lugar aparecen controles para editar / eliminar el plato de la carta. En
    // vista visitante (adminMode=false) el dueño cae al flujo normal y califica.
    if (adminMode) {
      paintRatingBadge(badge, globalAvg);
      const actions = article.querySelector<HTMLElement>(".dish-actions");
      if (actions) {
        actions.className = "owner-dish-actions";
        actions.innerHTML = "";
        const editBtn = document.createElement("button");
        editBtn.type = "button";
        editBtn.className = "owner-dish-btn";
        editBtn.setAttribute("aria-label", "Editar plato");
        editBtn.innerHTML = `<i class="bi bi-pencil"></i>`;
        editBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          (window as any).officialManage?.openDishEdit(od, distinctTypeNames());
        });
        const delBtn = document.createElement("button");
        delBtn.type = "button";
        delBtn.className = "owner-dish-btn is-delete";
        delBtn.setAttribute("aria-label", "Eliminar plato");
        delBtn.innerHTML = `<i class="bi bi-trash"></i>`;
        delBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          (window as any).confirmDialog?.show(
            `¿Eliminar "${od.name}" de la carta?`,
            () => void removeOfficialDish(od),
          );
        });
        actions.append(editBtn, delBtn);
      }
      return article;
    }

    paintRatingBadge(badge, badgeScore, { button: true });
    if (topOfficialDishIds.has(od.id))
      badge.appendChild(makeCrown("Tu plato estrella"));
    badge.addEventListener("click", (e) => {
      e.stopPropagation();
      openOfficialModal(od);
    });

    // Sin menú de acciones personales; tocar la card abre el detalle del plato.
    article.querySelector(".dish-actions")?.remove();
    article.classList.add("is-rateable");
    article.addEventListener("click", () => openOfficialModal(od));

    return article;
  }

  function getFilteredSortedDishes(): OfficialDish[] {
    let ds = officialDishes;
    if (dishSearch) {
      const q = dishSearch.toLowerCase();
      ds = ds.filter(
        (d) =>
          d.name.toLowerCase().includes(q) ||
          (d.notes ?? "").toLowerCase().includes(q) ||
          (d.typeName ?? "").toLowerCase().includes(q),
      );
    }
    if (dishTypeFilter) ds = ds.filter((d) => (d.typeName ?? "") === dishTypeFilter);
    return [...ds].sort((a, b) => {
      let cmp = 0;
      if (sortField === "name") cmp = a.name.localeCompare(b.name);
      else {
        const score = (id: string): number => getMyRatingFor(id) ?? -1;
        cmp = score(a.id) - score(b.id);
      }
      return sortDir === "asc" ? cmp : -cmp;
    });
  }

  function renderDishes(): void {
    const listEl = document.getElementById("dishes-list");
    const sortBarEl = document.querySelector<HTMLElement>(".sort-bar");
    if (!listEl) return;

    if (sortBarEl) sortBarEl.hidden = officialDishes.length < 2;

    topOfficialDishIds = computeTopMyOfficialDishIds();
    const filtered = getFilteredSortedDishes();
    if (filtered.length === 0) {
      const isFiltering = !!dishSearch || !!dishTypeFilter;
      listEl.innerHTML = isFiltering
        ? `<div class="empty-state flex-column">
             <i class="bi bi-search"></i>
             <p>Sin resultados para la búsqueda.</p>
           </div>`
        : adminMode
          ? `<div class="empty-state flex-column">
               <i class="bi bi-egg-fried"></i>
               <p>Tu carta está vacía. Agrega tu primer plato para que la gente pueda verlo y calificarlo.</p>
               <button id="empty-add-dish" class="boton create-from-search" type="button">
                 <i class="bi bi-plus-lg"></i> Agregar primer plato
               </button>
             </div>`
          : `<div class="empty-state flex-column">
               <i class="bi bi-egg-fried"></i>
               <p>Este restaurante aún no tiene platos en su carta.</p>
             </div>`;
      // CTA del empty state (solo en modo admin): abre el editor de carta.
      if (adminMode && official) {
        const addBtn = document.getElementById("empty-add-dish");
        if (addBtn)
          addBtn.onclick = () =>
            (window as any).officialManage?.openDishCreate(
              official!.id,
              distinctTypeNames(),
            );
      }
      return;
    }

    listEl.innerHTML = "";
    listEl.classList.toggle("stagger-in", !dishSearch && !dishTypeFilter);
    filtered.forEach((od) => listEl.appendChild(buildDishCardElement(od)));
  }

  function renderAll(): void {
    // Guard de página: /oficial y /restaurante comparten estructura (#dishes-list,
    // .sort-pill…) y este módulo persiste entre navegaciones ViewTransition. Si no
    // estamos en /oficial (sin #oficial-header) no renderizamos, para no inyectar la
    // carta oficial dentro de /restaurante al llegar un stats:synced / official:rated.
    const headerEl = document.getElementById("oficial-header");
    if (!headerEl) return;
    if (official) headerEl.replaceChildren(buildHeaderElement());
    renderDishes();
    updateTypeFilterUI();
    updateModeUI();
  }

  // ─── Filtro por tipo ────────────────────────────────────────────────────────

  function distinctTypeNames(): string[] {
    const set = new Set<string>();
    for (const d of officialDishes) if (d.typeName) set.add(d.typeName);
    return [...set].sort((a, b) => a.localeCompare(b));
  }

  function updateTypeFilterUI(): void {
    const btn = document.getElementById(
      "dish-type-btn",
    ) as HTMLButtonElement | null;
    const valueEl = document.getElementById("dish-type-value");
    if (!btn || !valueEl) return;
    const names = distinctTypeNames();
    if (names.length === 0) {
      dishTypeFilter = "";
      btn.hidden = true;
      return;
    }
    btn.hidden = false;
    if (dishTypeFilter && !names.includes(dishTypeFilter)) dishTypeFilter = "";
    valueEl.textContent = dishTypeFilter || "Todos";
    btn.classList.toggle("active", !!dishTypeFilter);
  }

  function renderTypeDropdown(): void {
    const dropdownEl = document.getElementById("dish-type-dropdown");
    if (!dropdownEl) return;
    dropdownEl.innerHTML = "";

    const noneOpt = document.createElement("div");
    noneOpt.className = "type-option is-none";
    noneOpt.textContent = "Todos los tipos";
    noneOpt.addEventListener("mousedown", (e) => e.preventDefault());
    noneOpt.addEventListener("click", () => selectType(""));
    dropdownEl.appendChild(noneOpt);

    distinctTypeNames().forEach((name) => {
      const opt = document.createElement("div");
      opt.className = "type-option" + (name === dishTypeFilter ? " is-selected" : "");
      opt.textContent = name;
      opt.addEventListener("mousedown", (e) => e.preventDefault());
      opt.addEventListener("click", () => selectType(name));
      dropdownEl.appendChild(opt);
    });
  }

  function selectType(name: string): void {
    dishTypeFilter = name;
    const valueEl = document.getElementById("dish-type-value");
    const btn = document.getElementById("dish-type-btn");
    if (valueEl) valueEl.textContent = name || "Todos";
    btn?.classList.toggle("active", !!name);
    closeTypeDropdown();
    renderDishes();
  }

  function openTypeDropdown(): void {
    const dropdownEl = document.getElementById("dish-type-dropdown");
    const btn = document.getElementById("dish-type-btn");
    if (!dropdownEl || !btn) return;
    renderTypeDropdown();
    dropdownEl.hidden = false;
    btn.classList.add("is-open");
  }

  function closeTypeDropdown(): void {
    const dropdownEl = document.getElementById("dish-type-dropdown");
    const btn = document.getElementById("dish-type-btn");
    dropdownEl?.setAttribute("hidden", "");
    btn?.classList.remove("is-open");
  }

  // ─── Orden / búsqueda ───────────────────────────────────────────────────────

  function updateSortUI(): void {
    updateSortPills(sortField, sortDir);
  }

  function wireControls(): void {
    // Orden
    document.querySelectorAll<HTMLButtonElement>(".sort-pill").forEach((btn) => {
      btn.onclick = () => {
        const field = btn.dataset.field as SortField;
        if (sortField === field) sortDir = sortDir === "asc" ? "desc" : "asc";
        else {
          sortField = field;
          sortDir = field === "name" ? "asc" : "desc";
        }
        updateSortUI();
        renderDishes();
      };
    });

    // Búsqueda
    const searchEl = document.getElementById(
      "dish-search",
    ) as HTMLInputElement | null;
    const clearEl = document.getElementById(
      "dish-search-clear",
    ) as HTMLButtonElement | null;
    const syncClear = () => {
      if (clearEl) clearEl.hidden = dishSearch.length === 0;
    };
    if (searchEl) {
      searchEl.value = dishSearch;
      syncClear();
      searchEl.oninput = () => {
        dishSearch = searchEl.value;
        syncClear();
        renderDishes();
      };
    }
    if (clearEl) {
      clearEl.onclick = () => {
        dishSearch = "";
        if (searchEl) {
          searchEl.value = "";
          searchEl.focus();
        }
        syncClear();
        renderDishes();
      };
    }

    // Filtro por tipo
    const typeBtn = document.getElementById("dish-type-btn");
    const typeDropdown = document.getElementById("dish-type-dropdown");
    if (typeBtn && typeDropdown) {
      typeBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (typeDropdown.hidden) openTypeDropdown();
        else closeTypeDropdown();
      });
      document.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        if (!t.closest("#dish-type-btn") && !t.closest("#dish-type-dropdown"))
          closeTypeDropdown();
      });
    }

    updateSortUI();
  }

  // ─── Re-render en sincronizaciones globales ─────────────────────────────────

  document.addEventListener("stats:synced", () => {
    if (official) renderAll();
  });

  // Tras calificar (official_ratings): repinta tu nota en la card y refresca el
  // promedio global (el RPC ya incluye tu nueva calificación).
  document.addEventListener("official:rated", () => {
    if (!official) return;
    renderAll();
    void fetchOfficialStats();
  });

  // ─── Gestión del dueño ──────────────────────────────────────────────────────

  /** Re-lee la carta oficial desde Supabase y re-renderiza. */
  async function refreshCarta(): Promise<void> {
    if (!official) return;
    officialDishes = await getOfficialDishes(official.id);
    renderAll();
  }

  /** Elimina un plato de la carta (optimista: lo quita y re-pinta). */
  async function removeOfficialDish(od: OfficialDish): Promise<void> {
    const ok = await deleteOfficialDish(od.id);
    if (ok) {
      officialDishes = officialDishes.filter((d) => d.id !== od.id);
      renderAll();
      void fetchOfficialStats();
    } else {
      (window as any).noticeDialog?.show("No se pudo eliminar el plato.", {
        variant: "error",
      });
    }
  }

  /** Muestra u oculta banner-visitante / barra-admin según capacidad y modo.
   *  - No dueño            → ambos ocultos.
   *  - Dueño, vista visita → banner visible (interruptor a admin), barra oculta.
   *  - Dueño, modo admin   → barra visible, banner oculto. */
  function updateModeUI(): void {
    const banner = document.getElementById("visitor-banner");
    const bar = document.getElementById("owner-bar");
    if (banner) banner.hidden = !isOwner || adminMode;
    if (bar) bar.hidden = !isOwner || !adminMode;
  }

  /** Cambia entre vista visitante y modo administrador (solo si eres dueño). */
  function setAdminMode(on: boolean): void {
    if (!isOwner) return;
    adminMode = on;
    updateModeUI();
    renderAll();
    // Al entrar/salir de admin, sube al inicio para reencuadrar la vista.
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  /** Conecta el interruptor de modo y los botones de gestión (solo si eres dueño). */
  function wireOwnerBar(): void {
    updateModeUI();
    if (!isOwner || !official) return;
    const enterBtn = document.getElementById("enter-admin-btn");
    const exitBtn = document.getElementById("exit-admin-btn");
    if (enterBtn) enterBtn.onclick = () => setAdminMode(true);
    if (exitBtn) exitBtn.onclick = () => setAdminMode(false);
    const om = () => (window as any).officialManage;
    const statsBtn = document.getElementById("owner-stats-btn");
    const editBtn = document.getElementById("owner-edit-btn");
    const addBtn = document.getElementById("owner-add-dish-btn");
    if (statsBtn)
      statsBtn.onclick = () => navigate(`/panel?id=${encodeURIComponent(official!.id)}`);
    if (editBtn) editBtn.onclick = () => om()?.openProfileEdit(official!);
    if (addBtn)
      addBtn.onclick = () => om()?.openDishCreate(official!.id, distinctTypeNames());
  }

  // Tras crear / editar / borrar un plato desde OfficialManage: re-lee la carta.
  document.addEventListener("official:carta-changed", () => {
    void refreshCarta();
    void fetchOfficialStats();
  });

  // Tras editar el perfil: refresca la cabecera con los nuevos datos.
  document.addEventListener("official:profile-changed", (e) => {
    const detail = (e as CustomEvent).detail as {
      official?: OfficialRestaurant;
    };
    if (detail?.official && official && detail.official.id === official.id) {
      official = detail.official;
      renderAll();
    }
  });

  // ─── Init en astro:page-load ────────────────────────────────────────────────

  document.addEventListener("astro:page-load", async () => {
    // #oficial-header es exclusivo de esta página: evita que este handler se dispare
    // sobre /restaurante (que comparte #restaurant-header) y rebote a /explorar.
    const headerEl = document.getElementById("oficial-header");
    if (!headerEl) return;

    // Dos formas de llegar:
    //  · Legacy: /oficial?id=<uuid>
    //  · URL personalizada: /oficial/@handle  (o /oficial/handle, sin @)
    // El rewrite de Netlify (_redirects) sirve esta misma página en la ruta bonita;
    // el segmento se lee de location.pathname y se resuelve en cliente por handle.
    const idParam = new URLSearchParams(window.location.search).get("id") ?? "";
    const seg = decodeURIComponent(
      window.location.pathname.replace(/^\/oficial\/?/, "").replace(/\/+$/, ""),
    );
    const handleParam = seg.replace(/^@/, "").toLowerCase();
    if (!idParam && !handleParam) {
      window.location.href = "/explorar";
      return;
    }

    // Skeleton mientras carga
    const listEl = document.getElementById("dishes-list");
    if (listEl && officialDishes.length === 0) {
      listEl.innerHTML = "";
      for (let i = 0; i < 4; i++) {
        const sk = document.createElement("div");
        sk.className = "skeleton-card skeleton-dish";
        listEl.appendChild(sk);
      }
    }

    const authed = await ensureAuthState();
    // Anónimo: initCache no corre (no dispara stats), pedimos stats directo.
    if (!authed) void fetchOfficialStats();

    // Resolver el perfil: por id (legacy) o por handle (URL personalizada). Sin
    // id no conocemos aún el uuid, así que la carta se pide después con official.id.
    official = idParam
      ? await getOfficialRestaurant(idParam)
      : await getOfficialByHandle(handleParam);

    if (!official) {
      window.location.href = "/explorar";
      return;
    }

    officialDishes = await getOfficialDishes(official.id);

    // Canonicalizar la barra de direcciones a la URL personalizada. Así cualquier
    // entrada por ?id= se "asciende" a /oficial/@handle, y lo que el usuario copie
    // o comparta desde la barra ya sale bonito. Sin recargar (mismo documento).
    if (official.handle) {
      const pretty = `/oficial/@${official.handle}`;
      if (window.location.pathname + window.location.search !== pretty)
        history.replaceState(history.state, "", pretty);
    }

    document.title = `${official.name} · STAURANT`;

    // Header según sesión: logueado → ← Volver (a la pestaña del inicio que
    // corresponda); anónimo (QR) → topbar pública con logo + Iniciar sesión.
    const backLink = document.getElementById(
      "back-link",
    ) as HTMLAnchorElement | null;
    const publicTopbar = document.getElementById("public-topbar");
    if (authed) {
      const status = getMyOfficialStatus(official.id);
      if (backLink) {
        backLink.href =
          status === "visited"
            ? "/?tab=visitados"
            : status === "pending"
              ? "/?tab=pendientes"
              : "/explorar";
        backLink.hidden = false;
      }
      if (publicTopbar) publicTopbar.hidden = true;
    } else {
      if (backLink) backLink.hidden = true;
      if (publicTopbar) publicTopbar.hidden = false;
    }

    // ¿Soy dueño de este perfil? (fila en official_owners). Debe resolverse ANTES
    // de renderAll para saber si mostrar el interruptor de modo administrador.
    isOwner = authed ? await checkOfficialOwnership(official.id) : false;
    // Cada entrada arranca en vista visitante: el dueño ve su restaurante como los
    // demás y activa gestión manualmente. (El módulo persiste entre ViewTransitions.)
    adminMode = false;

    wireControls();
    wireOwnerBar();
    renderAll();

    // Reanudar la calificación pendiente tras volver del login con Google.
    if (userId) {
      const raw = localStorage.getItem("staurant_pending");
      if (raw) {
        localStorage.removeItem("staurant_pending");
        try {
          const p = JSON.parse(raw) as {
            officialId: string;
            officialDishId: string | null;
          };
          if (p.officialId === official.id && p.officialDishId) {
            const od = officialDishes.find((d) => d.id === p.officialDishId);
            if (od) continueRate(od);
          }
        } catch {
          /* intención corrupta → ignorar */
        }
      }
    }
  });
</script>
