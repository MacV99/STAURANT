---
import Layout1 from "../layouts/Layout1.astro";
import DishCard from "../components/DishCard.astro";
import RestaurantHeader from "../components/RestaurantHeader.astro";
import SortBar from "../components/SortBar.astro";
import AuthModal from "../components/AuthModal.astro";
import NoticeDialog from "../components/NoticeDialog.astro";
import type { Dish, Restaurant } from "../lib/data";

// Plantillas para clonar en runtime (mismo patrón que restaurante.astro): así la
// carta pública del QR usa EXACTAMENTE las mismas cards que el detalle personal.
const tplDish: Dish = {
  id: "",
  restaurantId: "",
  typeId: null,
  name: "...",
  rating: 5,
  notes: " ",
  createdAt: "",
  updatedAt: "",
  officialDishId: null,
};
const tplRestaurant: Restaurant = {
  id: "",
  name: "...",
  status: "visited",
  notes: " ",
  cities: [],
  createdAt: "",
  updatedAt: "",
  officialRestaurantId: "x",
};
---

<Layout1 title="Restaurante · STAURANT" bare>
  <div class="detail-page flex-column">
    <div class="public-topbar flex-row">
      <a href="/" class="pt-brand flex-row" aria-label="STAURANT">
        <img src="/img/logo2.png" alt="STAURANT" class="pt-logo" />
      </a>
      <a id="login-link" href="/login" class="pt-action flex-row" hidden>
        <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
      </a>
      <a id="home-link" href="/" class="pt-action flex-row" hidden>
        <i class="bi bi-house-door"></i> Mi inicio
      </a>
    </div>

    <div id="restaurant-header" class="restaurant-header"></div>

    <div class="dishes-section flex-column">
      <div class="dishes-top flex-row">
        <h2 class="dishes-title">Platos</h2>
      </div>

      <div class="dish-search-wrap">
        <i class="bi bi-search-fill dish-search-icon"></i>
        <input
          id="dish-search"
          class="dish-search-input"
          type="search"
          placeholder="Buscar plato..."
          autocomplete="off"
          spellcheck="false"
        />
        <button
          id="dish-search-clear"
          class="dish-search-clear"
          type="button"
          aria-label="Limpiar búsqueda"
          hidden
        >
          <i class="bi bi-x-circle-fill"></i>
        </button>
      </div>

      <div class="dishes-controls flex-row">
        <SortBar
          pills={[
            { field: "rating", label: "Rating" },
            { field: "name", label: "Nombre" },
          ]}
        />
        <div class="type-filter-wrap">
          <button id="dish-type-btn" class="type-pill">
            <span class="type-pill-label">Tipo</span>
            <span id="dish-type-value" class="type-pill-value">Todos</span>
            <i class="bi bi-chevron-down"></i>
          </button>
          <div id="dish-type-dropdown" class="type-dropdown" hidden></div>
        </div>
      </div>

      <div id="dishes-list" class="flex-column"></div>
    </div>
  </div>

  <AuthModal />
  <NoticeDialog />

  <template id="tpl-dish-card">
    <DishCard dish={tplDish} typeName="..." />
  </template>

  <template id="tpl-restaurant-header">
    <RestaurantHeader restaurant={tplRestaurant} avg={5} dishCount={0} />
  </template>
</Layout1>

<style is:global>
  #dish-type-dropdown .type-option {
    padding: 8px 12px;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--clr-text);
    cursor: pointer;
    text-transform: uppercase;
    transition: background 0.1s ease;
    border-bottom: 1px solid var(--clr-border);
  }

  #dish-type-dropdown .type-option:last-child {
    border-bottom: none;
  }

  #dish-type-dropdown .type-option.is-selected {
    color: var(--clr-primary);
    font-weight: 700;
  }

  #dish-type-dropdown .type-option.is-none {
    color: var(--clr-text);
    opacity: 0.55;
    text-transform: none;
    letter-spacing: 0;
    border-bottom: 1px solid var(--clr-border);
  }

  #dish-type-dropdown .type-option.is-empty {
    color: var(--clr-text);
    opacity: 0.5;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    cursor: default;
    text-align: center;
    padding: 14px;
  }

  @media (hover: hover) {
    #dish-type-dropdown .type-option:hover,
    #dish-type-dropdown .type-option:focus {
      background: var(--clr-white2);
    }
  }

  /* Precio del plato en la carta oficial (dentro de la DishCard reusada) */
  .dish-card .od-price {
    display: block;
    width: fit-content;
    margin-top: 5px;
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.3px;
    color: var(--clr-primary);
  }

  /* Card de la carta pública: toda la tarjeta invita a calificar */
  .dish-card.is-rateable {
    cursor: pointer;
  }

  @media (hover: hover) {
    .dish-card.is-rateable:hover {
      border-color: var(--clr-border2);
    }
  }
</style>

<style>
  .detail-page {
    width: 100%;
    max-width: 760px;
    padding: 20px 16px 80px;
    align-items: stretch;
    gap: 24px;
  }

  .public-topbar {
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 12px;
  }

  .pt-brand {
    justify-content: flex-start;
    text-decoration: none;
  }

  .pt-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  .pt-action {
    justify-content: flex-end;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--clr-primary);
    letter-spacing: 0.3px;
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1.5px solid var(--clr-border);
    transition: var(--transition);
    white-space: nowrap;
  }

  .pt-action[hidden] {
    display: none;
  }

  .pt-action i {
    font-size: 0.95rem;
  }

  @media (hover: hover) {
    .pt-action:hover {
      border-color: var(--clr-primary);
      background: var(--clr-white2);
    }
  }

  .restaurant-header {
    width: 100%;
  }

  .dishes-section {
    align-items: stretch;
    gap: 12px;
  }

  .dishes-top {
    justify-content: flex-start;
  }

  .dishes-title {
    font-size: 1rem;
    letter-spacing: 2px;
    color: var(--clr-text);
  }

  .dish-search-wrap {
    position: relative;
    width: 100%;
  }

  .dish-search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--clr-text);
    opacity: 0.4;
    font-size: 0.85rem;
    pointer-events: none;
  }

  .dish-search-input {
    width: 100%;
    padding: 9px 14px 9px 34px;
    border-radius: var(--border-radius);
    border: 1.5px solid var(--clr-border);
    background: var(--clr-white);
    font-size: 0.88rem;
    color: var(--clr-text);
    transition: border-color var(--transition);
  }

  .dish-search-input::placeholder {
    color: var(--clr-text);
    opacity: 0.5;
  }

  .dish-search-input:focus {
    outline: none;
    border-color: var(--clr-border2);
  }

  .dish-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .dish-search-input:not(:placeholder-shown) {
    padding-right: 38px;
  }

  .dish-search-clear {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: 6px;
    color: var(--clr-text);
    opacity: 0.55;
    cursor: pointer;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: opacity var(--transition);
  }

  .dish-search-clear[hidden] {
    display: none;
  }

  @media (hover: hover) {
    .dish-search-clear:hover {
      opacity: 1;
    }
  }

  .dishes-controls {
    justify-content: flex-start;
    gap: 8px;
    flex-wrap: wrap;
  }

  .type-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 12px;
    border-radius: 20px;
    border: solid 1.5px var(--clr-border);
    background: var(--clr-white);
    color: var(--clr-text);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: none;
    cursor: pointer;
    transition: var(--transition);
  }

  .type-pill.active {
    background: var(--clr-primary);
    border-color: var(--clr-primary);
    color: var(--clr-white);
  }

  .type-pill-label {
    opacity: 0.5;
  }

  .type-pill-value {
    font-weight: 700;
  }

  .type-pill i {
    font-size: 0.65rem;
  }

  .type-filter-wrap {
    position: relative;
  }

  .type-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: max-content;
    background: var(--clr-white);
    border: 1.5px solid var(--clr-border);
    border-radius: var(--border-radius);
    z-index: 200;
    max-height: 220px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  #dishes-list {
    align-items: stretch;
    gap: 5px;
  }

  @media (hover: hover) {
    .type-pill:hover {
      border-color: var(--clr-border2);
    }
  }

  @media (min-width: 768px) {
    .detail-page {
      padding: 28px 24px 80px;
    }
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";
  import { supabase } from "../lib/supabase.ts";
  import {
    initCache,
    getRestaurants,
    getDishesByRestaurant,
    getOfficialRestaurant,
    getOfficialDishes,
    getOfficialRestaurantStat,
    getOfficialDishStat,
    adoptOfficialRestaurant,
    syncOfficialMenus,
    markAsVisited,
    fetchOfficialStats,
    type OfficialRestaurant,
    type OfficialDish,
  } from "../lib/data.ts";
  import { getRatingClass } from "../scripts/store.ts";

  // ─── Estado del módulo ──────────────────────────────────────────────────────

  let official: OfficialRestaurant | null = null;
  let officialDishes: OfficialDish[] = [];
  // userId = null → visitante anónimo (puede navegar la carta pero no calificar).
  let userId: string | null = null;

  type SortField = "rating" | "name";
  let sortField: SortField = "rating";
  let sortDir: "asc" | "desc" = "desc";
  let dishSearch = "";
  let dishTypeFilter = ""; // por typeName (los oficiales no tienen typeId)

  // ─── Auth ───────────────────────────────────────────────────────────────────

  async function ensureAuthState(): Promise<boolean> {
    const {
      data: { session },
    } = await supabase.auth.getSession();
    if (!session) {
      userId = null;
      return false;
    }
    userId = session.user.id;
    await initCache(userId);
    return true;
  }

  // ─── Intención pendiente (reanudar tras redirect de Google) ─────────────────

  function storeIntent(officialDishId?: string): void {
    if (!official) return;
    localStorage.setItem("staurant_return_to", `/oficial?id=${official.id}`);
    localStorage.setItem(
      "staurant_pending",
      JSON.stringify({
        officialId: official.id,
        officialDishId: officialDishId ?? null,
      }),
    );
  }

  // ─── Flujo de calificación ──────────────────────────────────────────────────

  function rateFlow(od: OfficialDish): void {
    if (userId) {
      void continueRate(od);
      return;
    }
    (window as any).authModal?.open({
      title: "Inicia sesión para calificar",
      onSuccess: async () => {
        if (await ensureAuthState()) await continueRate(od);
      },
      onBeforeGoogle: () => storeIntent(od.id),
    });
  }

  /** Con sesión: adopta el restaurante (queda VISITADO), y lleva al usuario a su
   *  vista REAL (/restaurante) con el modal de calificación abierto en ese plato.
   *  Así la experiencia es idéntica a calificar un oficial desde el perfil. */
  async function continueRate(od: OfficialDish): Promise<void> {
    if (!userId || !official) return;

    let rid =
      getRestaurants().find((r) => r.officialRestaurantId === official!.id)?.id ??
      null;
    if (!rid) {
      const created = await adoptOfficialRestaurant(official.id);
      if (!created) {
        (window as any).noticeDialog?.show(
          "No se pudo preparar la calificación. Intenta de nuevo.",
          { variant: "error" },
        );
        return;
      }
      rid = created.id;
    }

    // Calificar un plato implica que visitó el restaurante.
    markAsVisited(rid);

    let personal = getDishesByRestaurant(rid).find(
      (d) => d.officialDishId === od.id,
    );
    if (!personal) {
      await syncOfficialMenus();
      personal = getDishesByRestaurant(rid).find(
        (d) => d.officialDishId === od.id,
      );
    }
    if (!personal) {
      (window as any).noticeDialog?.show(
        "No se pudo preparar la calificación. Intenta de nuevo.",
        { variant: "error" },
      );
      return;
    }

    // La página /restaurante lee esta señal y abre el DishForm en ese plato.
    sessionStorage.setItem("staurant_open_rate", personal.id);
    navigate(`/restaurante?id=${rid}`);
  }

  // ─── Render (mismos componentes que /restaurante) ───────────────────────────

  function buildGlobalRatingPill(avg: number, count: number): HTMLElement {
    const pill = document.createElement("span");
    pill.className = "global-rating-pill";
    pill.title = `Promedio global basado en ${count} ${count === 1 ? "calificación" : "calificaciones"}`;
    pill.innerHTML = `<i class="bi bi-globe2"></i> ${avg} <span class="grp-count">· ${count}</span>`;
    return pill;
  }

  function buildHeaderElement(): Element {
    const tpl = document.getElementById(
      "tpl-restaurant-header",
    ) as HTMLTemplateElement;
    const div = (tpl.content.cloneNode(true) as DocumentFragment).querySelector(
      ".rh-card",
    )!;
    div.removeAttribute("style");
    div.classList.add("is-official");

    // Nombre + sello verificado
    const h1 = div.querySelector("h1")!;
    h1.textContent = "";
    const tailSpan = document.createElement("span");
    tailSpan.className = "name-tail-nowrap";
    tailSpan.textContent = official!.name;
    const verified = document.createElement("i");
    verified.className = "bi bi-patch-check-fill verified-badge";
    verified.title = "Restaurante verificado";
    tailSpan.appendChild(verified);
    h1.appendChild(tailSpan);

    // Conteo de platos
    const pill = div.querySelector(".dish-count-pill");
    if (pill)
      pill.innerHTML = `<i class="bi bi-journal-text"></i> ${officialDishes.length} ${officialDishes.length === 1 ? "plato" : "platos"}`;

    // Ciudad
    const citiesEl = div.querySelector(".rh-cities") as HTMLElement | null;
    const citiesListEl = div.querySelector(".rh-cities-list");
    if (citiesEl && citiesListEl && official!.city) {
      citiesListEl.textContent = official!.city;
      citiesEl.hidden = false;
    }

    // Badge de rating GLOBAL
    const stat = getOfficialRestaurantStat(official!.id);
    const avg = stat && stat.ratingsCount > 0 ? stat.avgRating : null;
    const badge = div.querySelector(".rating-badge")!;
    if (avg === null) {
      badge.className = "rating-badge badge-empty";
      badge.innerHTML = '<i class="bi bi-star"></i>';
    } else {
      badge.className = `rating-badge ${getRatingClass(avg)}`;
      badge.innerHTML = `<span class="rating-num">${avg}</span>`;
    }
    if (stat && stat.ratingsCount > 0) {
      const pillsRow = div.querySelector<HTMLElement>(".rh-pills");
      pillsRow?.insertBefore(
        buildGlobalRatingPill(stat.avgRating, stat.ratingsCount),
        pillsRow.firstChild,
      );
    }

    // Notas
    const notesEl = div.querySelector<HTMLElement>(".rh-notes");
    if (official!.notes) {
      if (notesEl) notesEl.textContent = official!.notes;
    } else {
      notesEl?.remove();
    }

    // Sin menú de editar/eliminar: no es el restaurante del usuario todavía.
    div.querySelector(".rh-menu")?.remove();

    return div;
  }

  function buildDishCardElement(od: OfficialDish): Element {
    const tpl = document.getElementById("tpl-dish-card") as HTMLTemplateElement;
    const article = (
      tpl.content.cloneNode(true) as DocumentFragment
    ).querySelector("article")!;
    article.setAttribute("data-id", od.id);
    article.querySelector("h4")!.textContent = od.name;

    const infoEl = article.querySelector<HTMLElement>(".dish-info")!;

    // Tipo
    const typeTagEl = article.querySelector<HTMLElement>(".dish-type-tag");
    if (od.typeName && typeTagEl) typeTagEl.textContent = od.typeName;
    else typeTagEl?.remove();

    // Precio (dato exclusivo de la carta oficial)
    if (od.price !== null) {
      const price = document.createElement("span");
      price.className = "od-price";
      price.textContent = `$${od.price.toLocaleString("es-CO")}`;
      infoEl.appendChild(price);
    }

    // Pill de rating global del plato
    const stat = getOfficialDishStat(od.id);
    if (stat && stat.ratingsCount > 0) {
      infoEl.appendChild(
        buildGlobalRatingPill(stat.avgRating, stat.ratingsCount),
      );
    }

    // Notas / descripción de la carta
    const notesEl = article.querySelector<HTMLElement>(".dish-notes");
    if (od.notes) {
      if (notesEl) notesEl.textContent = od.notes;
    } else {
      notesEl?.remove();
    }

    // Badge = rating GLOBAL, clickeable para calificar (igual que en el detalle).
    const avg = stat && stat.ratingsCount > 0 ? stat.avgRating : null;
    const badge = article.querySelector(".rating-badge")!;
    if (avg === null) {
      badge.className = "rating-badge badge-empty badge-btn";
      badge.innerHTML = '<i class="bi bi-star"></i>';
    } else {
      badge.className = `rating-badge ${getRatingClass(avg)} badge-btn`;
      badge.innerHTML = `<span class="rating-num">${avg}</span>`;
    }
    badge.addEventListener("click", (e) => {
      e.stopPropagation();
      rateFlow(od);
    });

    // Sin menú de acciones personales; tocar la card califica.
    article.querySelector(".dish-actions")?.remove();
    article.classList.add("is-rateable");
    article.addEventListener("click", () => rateFlow(od));

    return article;
  }

  function getFilteredSortedDishes(): OfficialDish[] {
    let ds = officialDishes;
    if (dishSearch) {
      const q = dishSearch.toLowerCase();
      ds = ds.filter(
        (d) =>
          d.name.toLowerCase().includes(q) ||
          (d.notes ?? "").toLowerCase().includes(q) ||
          (d.typeName ?? "").toLowerCase().includes(q),
      );
    }
    if (dishTypeFilter) ds = ds.filter((d) => (d.typeName ?? "") === dishTypeFilter);
    return [...ds].sort((a, b) => {
      let cmp = 0;
      if (sortField === "name") cmp = a.name.localeCompare(b.name);
      else {
        const ra = getOfficialDishStat(a.id)?.avgRating ?? -1;
        const rb = getOfficialDishStat(b.id)?.avgRating ?? -1;
        cmp = ra - rb;
      }
      return sortDir === "asc" ? cmp : -cmp;
    });
  }

  function renderDishes(): void {
    const listEl = document.getElementById("dishes-list");
    const sortBarEl = document.querySelector<HTMLElement>(".sort-bar");
    if (!listEl) return;

    if (sortBarEl) sortBarEl.hidden = officialDishes.length < 2;

    const filtered = getFilteredSortedDishes();
    if (filtered.length === 0) {
      const isFiltering = !!dishSearch || !!dishTypeFilter;
      listEl.innerHTML = isFiltering
        ? `<div class="empty-state flex-column">
             <i class="bi bi-search"></i>
             <p>Sin resultados para la búsqueda.</p>
           </div>`
        : `<div class="empty-state flex-column">
             <i class="bi bi-egg-fried"></i>
             <p>Este restaurante aún no tiene platos en su carta.</p>
           </div>`;
      return;
    }

    listEl.innerHTML = "";
    listEl.classList.toggle("stagger-in", !dishSearch && !dishTypeFilter);
    filtered.forEach((od) => listEl.appendChild(buildDishCardElement(od)));
  }

  function renderAll(): void {
    const headerEl = document.getElementById("restaurant-header");
    if (headerEl && official) headerEl.replaceChildren(buildHeaderElement());
    renderDishes();
    updateTypeFilterUI();
  }

  // ─── Filtro por tipo ────────────────────────────────────────────────────────

  function distinctTypeNames(): string[] {
    const set = new Set<string>();
    for (const d of officialDishes) if (d.typeName) set.add(d.typeName);
    return [...set].sort((a, b) => a.localeCompare(b));
  }

  function updateTypeFilterUI(): void {
    const btn = document.getElementById(
      "dish-type-btn",
    ) as HTMLButtonElement | null;
    const valueEl = document.getElementById("dish-type-value");
    if (!btn || !valueEl) return;
    const names = distinctTypeNames();
    if (names.length === 0) {
      dishTypeFilter = "";
      btn.hidden = true;
      return;
    }
    btn.hidden = false;
    if (dishTypeFilter && !names.includes(dishTypeFilter)) dishTypeFilter = "";
    valueEl.textContent = dishTypeFilter || "Todos";
    btn.classList.toggle("active", !!dishTypeFilter);
  }

  function renderTypeDropdown(): void {
    const dropdownEl = document.getElementById("dish-type-dropdown");
    if (!dropdownEl) return;
    dropdownEl.innerHTML = "";

    const noneOpt = document.createElement("div");
    noneOpt.className = "type-option is-none";
    noneOpt.textContent = "Todos los tipos";
    noneOpt.addEventListener("mousedown", (e) => e.preventDefault());
    noneOpt.addEventListener("click", () => selectType(""));
    dropdownEl.appendChild(noneOpt);

    distinctTypeNames().forEach((name) => {
      const opt = document.createElement("div");
      opt.className = "type-option" + (name === dishTypeFilter ? " is-selected" : "");
      opt.textContent = name;
      opt.addEventListener("mousedown", (e) => e.preventDefault());
      opt.addEventListener("click", () => selectType(name));
      dropdownEl.appendChild(opt);
    });
  }

  function selectType(name: string): void {
    dishTypeFilter = name;
    const valueEl = document.getElementById("dish-type-value");
    const btn = document.getElementById("dish-type-btn");
    if (valueEl) valueEl.textContent = name || "Todos";
    btn?.classList.toggle("active", !!name);
    closeTypeDropdown();
    renderDishes();
  }

  function openTypeDropdown(): void {
    const dropdownEl = document.getElementById("dish-type-dropdown");
    const btn = document.getElementById("dish-type-btn");
    if (!dropdownEl || !btn) return;
    renderTypeDropdown();
    dropdownEl.hidden = false;
    btn.classList.add("is-open");
  }

  function closeTypeDropdown(): void {
    const dropdownEl = document.getElementById("dish-type-dropdown");
    const btn = document.getElementById("dish-type-btn");
    dropdownEl?.setAttribute("hidden", "");
    btn?.classList.remove("is-open");
  }

  // ─── Orden / búsqueda ───────────────────────────────────────────────────────

  function updateSortUI(): void {
    document.querySelectorAll<HTMLButtonElement>(".sort-pill").forEach((btn) => {
      const isActive = btn.dataset.field === sortField;
      btn.classList.toggle("active", isActive);
      const icon = btn.querySelector("i");
      if (icon)
        icon.className = isActive
          ? `bi bi-arrow-${sortDir === "asc" ? "up" : "down"}`
          : "bi bi-arrow-down-up";
    });
  }

  function wireControls(): void {
    // Orden
    document.querySelectorAll<HTMLButtonElement>(".sort-pill").forEach((btn) => {
      btn.onclick = () => {
        const field = btn.dataset.field as SortField;
        if (sortField === field) sortDir = sortDir === "asc" ? "desc" : "asc";
        else {
          sortField = field;
          sortDir = field === "name" ? "asc" : "desc";
        }
        updateSortUI();
        renderDishes();
      };
    });

    // Búsqueda
    const searchEl = document.getElementById(
      "dish-search",
    ) as HTMLInputElement | null;
    const clearEl = document.getElementById(
      "dish-search-clear",
    ) as HTMLButtonElement | null;
    const syncClear = () => {
      if (clearEl) clearEl.hidden = dishSearch.length === 0;
    };
    if (searchEl) {
      searchEl.value = dishSearch;
      syncClear();
      searchEl.oninput = () => {
        dishSearch = searchEl.value;
        syncClear();
        renderDishes();
      };
    }
    if (clearEl) {
      clearEl.onclick = () => {
        dishSearch = "";
        if (searchEl) {
          searchEl.value = "";
          searchEl.focus();
        }
        syncClear();
        renderDishes();
      };
    }

    // Filtro por tipo
    const typeBtn = document.getElementById("dish-type-btn");
    const typeDropdown = document.getElementById("dish-type-dropdown");
    if (typeBtn && typeDropdown) {
      typeBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (typeDropdown.hidden) openTypeDropdown();
        else closeTypeDropdown();
      });
      document.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        if (!t.closest("#dish-type-btn") && !t.closest("#dish-type-dropdown"))
          closeTypeDropdown();
      });
    }

    updateSortUI();
  }

  // ─── Re-render en sincronizaciones globales ─────────────────────────────────

  document.addEventListener("stats:synced", () => {
    if (official) renderAll();
  });

  // ─── Init en astro:page-load ────────────────────────────────────────────────

  document.addEventListener("astro:page-load", async () => {
    const headerEl = document.getElementById("restaurant-header");
    if (!headerEl) return;

    const id = new URLSearchParams(window.location.search).get("id") ?? "";
    if (!id) {
      window.location.href = "/explorar";
      return;
    }

    // Skeleton mientras carga
    const listEl = document.getElementById("dishes-list");
    if (listEl && officialDishes.length === 0) {
      listEl.innerHTML = "";
      for (let i = 0; i < 4; i++) {
        const sk = document.createElement("div");
        sk.className = "skeleton-card skeleton-dish";
        listEl.appendChild(sk);
      }
    }

    const authed = await ensureAuthState();
    // Anónimo: initCache no corre (no dispara stats), pedimos stats directo.
    if (!authed) void fetchOfficialStats();

    // Si ya tiene ESTE restaurante en su perfil → llevarlo a su vista REAL.
    if (authed) {
      const adopted = getRestaurants().find(
        (r) => r.officialRestaurantId === id,
      );
      if (adopted) {
        navigate(`/restaurante?id=${adopted.id}`);
        return;
      }
    }

    const [off, ds] = await Promise.all([
      getOfficialRestaurant(id),
      getOfficialDishes(id),
    ]);
    official = off;
    officialDishes = ds;

    if (!official) {
      window.location.href = "/explorar";
      return;
    }

    document.title = `${official.name} · STAURANT`;

    // Barra pública: anónimo ve "Iniciar sesión"; con cuenta ve "Mi inicio".
    const loginLink = document.getElementById("login-link");
    const homeLink = document.getElementById("home-link");
    if (loginLink) loginLink.hidden = authed;
    if (homeLink) homeLink.hidden = !authed;

    wireControls();
    renderAll();

    // Reanudar la calificación pendiente tras volver del login con Google.
    if (userId) {
      const raw = localStorage.getItem("staurant_pending");
      if (raw) {
        localStorage.removeItem("staurant_pending");
        try {
          const p = JSON.parse(raw) as {
            officialId: string;
            officialDishId: string | null;
          };
          if (p.officialId === official.id && p.officialDishId) {
            const od = officialDishes.find((d) => d.id === p.officialDishId);
            if (od) await continueRate(od);
          }
        } catch {
          /* intención corrupta → ignorar */
        }
      }
    }
  });
</script>
