---
import Layout1 from "../layouts/Layout1.astro";
import NoticeDialog from "../components/NoticeDialog.astro";
import DishForm from "../components/DishForm.astro";
import AuthModal from "../components/AuthModal.astro";
---

<Layout1 title="Restaurante oficial · STAURANT">
  <div class="oficial-page flex-column">
    <a id="oficial-back" href="/explorar" class="back-link flex-row">
      <i class="bi bi-arrow-left"></i> Explorar
    </a>

    <div id="oficial-header" class="oficial-header"></div>

    <div class="oficial-dishes flex-column">
      <h2 class="oficial-dishes-title">Carta</h2>
      <div id="oficial-dishes-list" class="flex-column"></div>
    </div>
  </div>

  <NoticeDialog />
  <AuthModal />
  <DishForm />
</Layout1>

<style>
  .oficial-page {
    width: 100%;
    max-width: 760px;
    padding: 20px 16px 100px;
    align-items: stretch;
    gap: 24px;
  }

  .back-link {
    justify-content: flex-start;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--clr-primary);
    letter-spacing: 1px;
    width: fit-content;
    padding: 6px 0;
    transition: var(--transition);
  }

  .oficial-dishes {
    align-items: stretch;
    gap: 12px;
  }

  .oficial-dishes-title {
    font-size: 1rem;
    letter-spacing: 2px;
    color: var(--clr-text);
  }

  #oficial-dishes-list {
    align-items: stretch;
    gap: 5px;
  }

  @media (hover: hover) {
    .back-link:hover {
      color: var(--clr-text);
    }
  }

  @media (min-width: 768px) {
    .oficial-page {
      padding: 28px 24px 80px;
    }
  }
</style>

<style is:global>
  /* Header del restaurante oficial */
  .oficial-card {
    background:
      linear-gradient(
        315deg,
        rgba(212, 160, 23, 0.14) 0%,
        rgba(255, 248, 230, 0) 60%
      ),
      var(--clr-white);
    border: 1px solid rgba(212, 160, 23, 0.5);
    border-radius: 20px;
    padding: 22px 20px;
    align-items: stretch;
    gap: 12px;
  }

  .oficial-card .oc-top {
    justify-content: flex-start;
    gap: 14px;
  }

  .oficial-card .oc-meta {
    align-items: flex-start;
    gap: 5px;
    flex: 1;
    min-width: 0;
  }

  .oficial-card h1 {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: var(--clr-text);
    word-break: break-word;
    line-height: 1.25;
  }

  .oficial-card .oc-pills {
    justify-content: flex-start;
    gap: 6px;
    flex-wrap: wrap;
  }

  .oficial-card .oc-line {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.82rem;
    color: var(--clr-text);
    opacity: 0.7;
  }

  .oficial-card .oc-notes {
    font-size: 0.85rem;
    color: var(--clr-text);
    line-height: 1.5;
    opacity: 0.8;
  }

  .oc-adopt-btn {
    width: 100%;
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
  }

  /* Etiqueta informativa (no clickeable) cuando ya está en tu lista */
  .oc-owned-tag {
    width: 100%;
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
    padding: 12px 16px;
    border-radius: var(--border-radius);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    color: #1a7a38;
    background: #d8f5e2;
    border: 1px solid #a8e0b8;
  }

  .oc-owned-tag i {
    font-size: 0.95rem;
  }

  /* Plato oficial (solo lectura) */
  .oficial-dish {
    background: var(--clr-white);
    border: 1px solid var(--clr-border);
    border-radius: 14px;
    padding: 14px 16px;
    justify-content: space-between;
    gap: 12px;
  }

  .oficial-dish .od-info {
    flex: 1;
    min-width: 0;
  }

  .oficial-dish h4 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--clr-text);
  }

  .oficial-dish .od-notes {
    font-size: 0.8rem;
    color: var(--clr-text);
    margin-top: 3px;
    line-height: 1.4;
    opacity: 0.75;
  }

  .oficial-dish .od-price {
    display: block;
    width: fit-content;
    margin-top: 5px;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.3px;
    color: var(--clr-primary);
  }

  .oficial-dish .od-thumb {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid var(--clr-border);
    align-self: flex-start;
  }

  /* Acción de calificar por plato (carta pública) */
  .oficial-dish .od-action {
    margin-top: 10px;
  }

  .od-rate-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: fit-content;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1.5px solid var(--clr-primary);
    background: transparent;
    color: var(--clr-primary);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.4px;
    cursor: pointer;
    transition: var(--transition);
  }

  .od-rate-btn i {
    font-size: 0.9rem;
  }

  /* Estado "ya calificaste": muestra tu nota + acción editar */
  .od-rate-btn.is-rated {
    border-color: var(--clr-border);
    color: var(--clr-text);
  }

  .od-rate-btn .od-my-score {
    font-weight: 800;
    color: var(--clr-primary);
  }

  @media (hover: hover) {
    .od-rate-btn:hover {
      background: var(--clr-primary);
      color: var(--clr-white);
    }

    .od-rate-btn.is-rated:hover {
      background: var(--clr-white2);
      color: var(--clr-text);
    }
  }

  @media (min-width: 768px) {
    .oficial-card {
      padding: 24px 28px;
    }

    .oficial-card h1 {
      font-size: 1.6rem;
    }
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";
  import { supabase } from "../lib/supabase.ts";
  import {
    initCache,
    getRestaurants,
    getDishesByRestaurant,
    getOfficialRestaurant,
    getOfficialDishes,
    getOfficialRestaurantStat,
    getOfficialDishStat,
    adoptOfficialRestaurant,
    syncOfficialMenus,
    markAsVisited,
    fetchOfficialStats,
    type OfficialRestaurant,
    type OfficialDish,
  } from "../lib/data.ts";
  import { getRatingClass } from "../scripts/store.ts";

  let official: OfficialRestaurant | null = null;
  let dishes: OfficialDish[] = [];
  let adopting = false;
  // userId = null → visitante anónimo (puede navegar la carta pero no calificar).
  let userId: string | null = null;

  // ─── Auth / caché del visitante ─────────────────────────────────────────────

  /** Sincroniza el estado de sesión: si hay usuario, deja el caché personal listo.
   *  Devuelve true si quedó autenticado. */
  async function ensureAuthState(): Promise<boolean> {
    const {
      data: { session },
    } = await supabase.auth.getSession();
    if (!session) {
      userId = null;
      return false;
    }
    userId = session.user.id;
    await initCache(userId);
    return true;
  }

  /** Calificación PERSONAL del visitante para un plato oficial (o null). */
  function getMyRatingFor(officialDishId: string): number | null {
    if (!userId || !official) return null;
    const rid = getRestaurants().find(
      (r) => r.officialRestaurantId === official!.id,
    )?.id;
    if (!rid) return null;
    return (
      getDishesByRestaurant(rid).find((d) => d.officialDishId === officialDishId)
        ?.rating ?? null
    );
  }

  // ─── Intención pendiente (reanudar tras redirect de Google) ─────────────────

  /** Persiste a dónde volver y qué acción reanudar tras el login con Google. */
  function storeIntent(officialDishId?: string): void {
    if (!official) return;
    localStorage.setItem("staurant_return_to", `/oficial?id=${official.id}`);
    localStorage.setItem(
      "staurant_pending",
      JSON.stringify({
        officialId: official.id,
        officialDishId: officialDishId ?? null,
      }),
    );
  }

  // ─── Flujo de calificación ──────────────────────────────────────────────────

  /** Punto de entrada del botón "Calificar": gatea auth sin sacar de la carta. */
  function rateFlow(od: OfficialDish): void {
    if (userId) {
      void continueRate(od);
      return;
    }
    (window as any).authModal?.open({
      title: "Inicia sesión para calificar",
      onSuccess: async () => {
        if (await ensureAuthState()) {
          renderDishes();
          await continueRate(od);
        }
      },
      onBeforeGoogle: () => storeIntent(od.id),
    });
  }

  /** Con sesión activa: adopta el restaurante (queda VISITADO), ubica el plato
   *  personal clonado y abre el DishForm para poner la nota con el drum. */
  async function continueRate(od: OfficialDish): Promise<void> {
    if (!userId || !official) return;

    let rid =
      getRestaurants().find((r) => r.officialRestaurantId === official!.id)?.id ??
      null;
    if (!rid) {
      const created = await adoptOfficialRestaurant(official.id);
      if (!created) {
        (window as any).noticeDialog?.show(
          "No se pudo preparar la calificación. Intenta de nuevo.",
          { variant: "error" },
        );
        return;
      }
      rid = created.id;
    }

    // Calificar un plato implica que visitó el restaurante.
    markAsVisited(rid);

    let personal = getDishesByRestaurant(rid).find(
      (d) => d.officialDishId === od.id,
    );
    if (!personal) {
      // Plato oficial nuevo aún no clonado localmente → sincronizar y reintentar.
      await syncOfficialMenus();
      personal = getDishesByRestaurant(rid).find(
        (d) => d.officialDishId === od.id,
      );
    }
    if (!personal) {
      (window as any).noticeDialog?.show(
        "No se pudo preparar la calificación. Intenta de nuevo.",
        { variant: "error" },
      );
      return;
    }

    (window as any).dishForm?.open("edit", rid, personal);
  }

  /** Botón "Agregar a mi colección" del header (adopta y navega al detalle). */
  async function doAdopt(): Promise<void> {
    if (!official) return;
    if (!userId) {
      (window as any).authModal?.open({
        title: "Inicia sesión para guardar",
        onSuccess: async () => {
          if (await ensureAuthState()) {
            renderHeader();
            await doAdopt();
          }
        },
        onBeforeGoogle: () => storeIntent(),
      });
      return;
    }

    // Candado anti-duplicado: si ya quedó vinculado (otra pestaña, sync, doble
    // clic) navegamos al existente en vez de crear otro.
    const already = getRestaurants().find(
      (r) => r.officialRestaurantId === official!.id,
    );
    if (already) {
      navigate(`/restaurante?id=${already.id}`);
      return;
    }

    adopting = true;
    renderHeader();
    const created = await adoptOfficialRestaurant(official.id);
    adopting = false;
    if (created) {
      navigate(`/restaurante?id=${created.id}`);
    } else {
      renderHeader();
      (window as any).noticeDialog?.show(
        "No se pudo agregar el restaurante. Inténtalo de nuevo.",
        { variant: "error" },
      );
    }
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function globalRatingPill(avg: number, count: number): string {
    return `<span class="global-rating-pill" title="Promedio global basado en ${count} ${count === 1 ? "calificación" : "calificaciones"}"><i class="bi bi-globe2"></i> ${avg} <span class="grp-count">· ${count}</span></span>`;
  }

  function ratingBadge(avg: number | null): string {
    if (avg === null) {
      return `<span class="rating-badge badge-empty"><i class="bi bi-star"></i></span>`;
    }
    return `<span class="rating-badge ${getRatingClass(avg)}"><span class="rating-num">${avg}</span></span>`;
  }

  function renderHeader() {
    const headerEl = document.getElementById("oficial-header");
    if (!headerEl || !official) return;

    const stat = getOfficialRestaurantStat(official.id);
    const avg = stat && stat.ratingsCount > 0 ? stat.avgRating : null;
    const adoptedRestaurant = getRestaurants().find(
      (r) => r.officialRestaurantId === official!.id,
    );

    const card = document.createElement("div");
    card.className = "oficial-card flex-column";

    const top = document.createElement("div");
    top.className = "oc-top flex-row";
    top.innerHTML = ratingBadge(avg);

    const meta = document.createElement("div");
    meta.className = "oc-meta flex-column";

    const h1 = document.createElement("h1");
    h1.textContent = official.name;
    const verified = document.createElement("i");
    verified.className = "bi bi-patch-check-fill verified-badge";
    verified.title = "Restaurante verificado";
    h1.appendChild(verified);
    meta.appendChild(h1);

    const pills = document.createElement("div");
    pills.className = "oc-pills flex-row";
    let pillsHtml = "";
    if (official.city) {
      pillsHtml += `<span class="oc-line"><i class="bi bi-geo-alt"></i> ${escapeHtml(official.city)}</span>`;
    }
    if (stat && stat.ratingsCount > 0) {
      pillsHtml += globalRatingPill(stat.avgRating, stat.ratingsCount);
    }
    pills.innerHTML = pillsHtml;
    if (pills.childElementCount > 0) meta.appendChild(pills);

    if (official.address) {
      const addr = document.createElement("span");
      addr.className = "oc-line";
      addr.innerHTML = `<i class="bi bi-pin-map"></i> ${escapeHtml(official.address)}`;
      meta.appendChild(addr);
    }

    top.appendChild(meta);
    card.appendChild(top);

    if (official.notes) {
      const notes = document.createElement("p");
      notes.className = "oc-notes";
      notes.textContent = official.notes;
      card.appendChild(notes);
    }

    // Si ya está en tu lista → solo etiqueta informativa (sin acción).
    // Si no lo tienes → botón para agregarlo a tu colección.
    if (adoptedRestaurant) {
      const tag = document.createElement("div");
      tag.className = "oc-owned-tag flex-row";
      tag.innerHTML = `<i class="bi bi-check-circle-fill"></i> Ya está en tu lista`;
      card.appendChild(tag);
    } else {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "boton oc-adopt-btn flex-row";
      if (adopting) {
        btn.disabled = true;
        btn.innerHTML = `<i class="bi bi-hourglass-split"></i> Agregando...`;
      } else {
        btn.innerHTML = `<i class="bi bi-plus-lg"></i> Agregar a mi colección`;
        btn.onclick = () => void doAdopt();
      }
      card.appendChild(btn);
    }

    headerEl.replaceChildren(card);
  }

  function renderDishes() {
    const listEl = document.getElementById("oficial-dishes-list");
    if (!listEl) return;

    if (dishes.length === 0) {
      listEl.innerHTML = `<div class="empty-state flex-column">
           <i class="bi bi-egg-fried"></i>
           <p>Este restaurante aún no tiene platos en su carta.</p>
         </div>`;
      return;
    }

    listEl.innerHTML = "";
    dishes.forEach((d) => {
      const stat = getOfficialDishStat(d.id);
      const avg = stat && stat.ratingsCount > 0 ? stat.avgRating : null;

      const article = document.createElement("article");
      article.className = "oficial-dish flex-row";
      article.innerHTML = ratingBadge(avg);

      const info = document.createElement("div");
      info.className = "od-info";
      const h4 = document.createElement("h4");
      h4.textContent = d.name;
      info.appendChild(h4);
      if (d.typeName) {
        const tag = document.createElement("span");
        tag.className = "dish-type-tag";
        tag.textContent = d.typeName;
        info.appendChild(tag);
      }
      if (d.price !== null) {
        const price = document.createElement("span");
        price.className = "od-price";
        price.textContent = `$${d.price.toLocaleString("es-CO")}`;
        info.appendChild(price);
      }
      if (stat && stat.ratingsCount > 0) {
        const pillWrap = document.createElement("div");
        pillWrap.style.marginTop = "4px";
        pillWrap.innerHTML = globalRatingPill(stat.avgRating, stat.ratingsCount);
        info.appendChild(pillWrap);
      }
      if (d.notes) {
        const notes = document.createElement("p");
        notes.className = "od-notes";
        notes.textContent = d.notes;
        info.appendChild(notes);
      }

      // Acción de calificar. Muestra la nota personal si ya calificó.
      const action = document.createElement("div");
      action.className = "od-action";
      const myRating = getMyRatingFor(d.id);
      const rateBtn = document.createElement("button");
      rateBtn.type = "button";
      rateBtn.className = "od-rate-btn" + (myRating !== null ? " is-rated" : "");
      rateBtn.innerHTML =
        myRating !== null
          ? `<i class="bi bi-star-fill"></i> Tu nota <span class="od-my-score">${myRating}</span> · Editar`
          : `<i class="bi bi-star"></i> Calificar`;
      rateBtn.onclick = () => rateFlow(d);
      action.appendChild(rateBtn);
      info.appendChild(action);

      article.appendChild(info);

      if (d.imageUrl) {
        const thumb = document.createElement("img");
        thumb.className = "od-thumb";
        thumb.src = d.imageUrl;
        thumb.alt = d.name;
        thumb.loading = "lazy";
        article.appendChild(thumb);
      }

      listEl.appendChild(article);
    });
  }

  function renderAll() {
    renderHeader();
    renderDishes();
  }

  document.addEventListener("stats:synced", () => {
    if (official) renderAll();
  });
  document.addEventListener("cache:synced", () => {
    if (official) renderDishes();
  });
  // Tras calificar en el DishForm: repinta la nota propia y refresca el promedio
  // global (el RPC agrega la nueva calificación del usuario).
  document.addEventListener("dish:updated", () => {
    if (!official) return;
    renderDishes();
    void fetchOfficialStats();
  });

  document.addEventListener("astro:page-load", async () => {
    const headerEl = document.getElementById("oficial-header");
    if (!headerEl) return;

    const id = new URLSearchParams(window.location.search).get("id") ?? "";
    if (!id) {
      window.location.href = "/explorar";
      return;
    }

    // Skeleton mientras carga
    const listEl = document.getElementById("oficial-dishes-list");
    if (listEl && dishes.length === 0) {
      listEl.innerHTML = "";
      for (let i = 0; i < 3; i++) {
        const sk = document.createElement("div");
        sk.className = "skeleton-card skeleton-dish";
        listEl.appendChild(sk);
      }
    }

    // Carta PÚBLICA: un visitante anónimo puede navegarla. Si hay sesión, dejamos
    // el caché personal listo para mostrar y gestionar sus calificaciones.
    const authed = await ensureAuthState();
    // Sin sesión no corre initCache (que dispara fetchOfficialStats), así que
    // pedimos las stats globales directo para pintar los promedios de la carta.
    if (!authed) void fetchOfficialStats();

    const [off, ds] = await Promise.all([
      getOfficialRestaurant(id),
      getOfficialDishes(id),
    ]);
    official = off;
    dishes = ds;

    if (!official) {
      window.location.href = "/explorar";
      return;
    }

    document.title = `${official.name} · STAURANT`;
    renderAll();

    // Reanudar la acción pendiente tras volver del login con Google.
    if (userId) {
      const raw = localStorage.getItem("staurant_pending");
      if (raw) {
        localStorage.removeItem("staurant_pending");
        try {
          const p = JSON.parse(raw) as {
            officialId: string;
            officialDishId: string | null;
          };
          if (p.officialId === official.id) {
            if (p.officialDishId) {
              const od = dishes.find((d) => d.id === p.officialDishId);
              if (od) await continueRate(od);
            } else {
              await doAdopt();
            }
          }
        } catch {
          /* intención corrupta → ignorar */
        }
      }
    }
  });
</script>
