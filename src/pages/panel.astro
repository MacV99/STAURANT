---
/**
 * Panel de gestión del dueño (dashboard de estadísticas). Ruta: /panel?id=…
 * Solo accesible si el usuario es dueño del perfil oficial (official_owners); si no,
 * redirige. Los datos vienen del RPC get_official_owner_stats (agregados, sin filas
 * crudas). Las gráficas son CSS puro — sin librerías, respeta el bundle PWA.
 *
 * Estructura: KPIs → "Lo más destacado" (mejor / más votado / por mejorar) →
 * satisfacción + distribución → actividad 30 días (barras por día) → ranking con
 * pestañas. El ranking de "Mejores" ordena con promedio ponderado por votos
 * (un 9.0 con 1 voto no le gana a un 8.8 con 20).
 *
 * NOTA: los elementos de las gráficas se crean con createElement en el <script>, así
 * que su CSS vive en <style is:global> (prefijado con .panel-page). El CSS scoped de
 * Astro NO alcanza nodos creados por JS.
 */
import Layout1 from "../layouts/Layout1.astro";
---

<Layout1 title="Panel · STAURANT" bare>
  <div class="panel-page flex-column">
    <a id="panel-back" href="/" class="back-link flex-row">
      <i class="bi bi-arrow-left"></i> Volver al restaurante
    </a>

    <header class="panel-head flex-column">
      <span class="panel-eyebrow flex-row">
        <i class="bi bi-shield-check"></i> Panel de gestión
      </span>
      <h1 id="panel-title" class="panel-title">—</h1>
    </header>

    {/* KPIs */}
    <section class="kpi-grid">
      <div class="kpi kpi-hero">
        <div class="kpi-hero-main flex-column">
          <span class="kpi-lbl">Promedio general</span>
          <span class="kpi-num" id="kpi-avg">—</span>
          <span class="kpi-sub" id="kpi-avg-sub"></span>
        </div>
        <div class="kpi-hero-side flex-column">
          <span class="kpi-lbl">Satisfacción</span>
          <span class="kpi-sat" id="kpi-sat">—</span>
          <span class="kpi-sub">notas de 8 o más</span>
        </div>
      </div>
      <div class="kpi flex-column">
        <i class="bi bi-bookmark-heart kpi-icon"></i>
        <span class="kpi-num" id="kpi-members">—</span>
        <span class="kpi-lbl">Lo tienen en su lista</span>
      </div>
      <div class="kpi flex-column">
        <i class="bi bi-people kpi-icon"></i>
        <span class="kpi-num" id="kpi-raters">—</span>
        <span class="kpi-lbl">Han calificado</span>
        <span class="kpi-sub" id="kpi-raters-sub"></span>
      </div>
      <div class="kpi flex-column">
        <i class="bi bi-star kpi-icon"></i>
        <span class="kpi-num" id="kpi-total">—</span>
        <span class="kpi-lbl">Calificaciones</span>
        <span class="kpi-sub" id="kpi-total-sub"></span>
      </div>
      <div class="kpi flex-column">
        <i class="bi bi-journal-text kpi-icon"></i>
        <span class="kpi-num" id="kpi-dishes">—</span>
        <span class="kpi-lbl">Platos calificados</span>
        <span class="kpi-sub" id="kpi-dishes-sub"></span>
      </div>
    </section>

    {/* Lo más destacado */}
    <section class="panel-card flex-column">
      <h2 class="card-title">Lo más destacado</h2>
      <div id="highlights" class="highlights"></div>
    </section>

    {/* Satisfacción + distribución */}
    <section class="panel-card flex-column">
      <h2 class="card-title">Cómo te califican</h2>
      <p class="card-hint">Reparto de todas las notas recibidas (1 a 10).</p>
      <div id="sentiment" class="sentiment flex-column"></div>
      <div id="hist" class="hist"></div>
    </section>

    {/* Actividad */}
    <section class="panel-card flex-column">
      <h2 class="card-title">Actividad · últimos 30 días</h2>
      <p class="card-hint" id="act-summary">Calificaciones recibidas por día.</p>
      <div id="activity" class="activity"></div>
      <div class="activity-axis flex-row">
        <span id="act-start">—</span>
        <span>Hoy</span>
      </div>
    </section>

    {/* Ranking */}
    <section class="panel-card flex-column">
      <h2 class="card-title flex-row">
        Ranking de platos <span id="rank-count" class="card-count"></span>
      </h2>
      <div id="rank-tabs" class="rank-tabs flex-row" role="tablist"></div>
      <p class="card-hint" id="rank-hint"></p>
      <div id="rank" class="rank flex-column"></div>
      <button id="rank-more" class="boton2 rank-more" hidden>Ver todos</button>
    </section>
  </div>
</Layout1>

<style>
  .panel-page {
    width: 100%;
    max-width: 760px;
    padding: 20px 16px 80px;
    align-items: stretch;
    gap: 16px;
  }

  .back-link {
    justify-content: flex-start;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--clr-primary);
    letter-spacing: 1px;
    width: fit-content;
    padding: 6px 0;
    transition: var(--transition);
  }

  .panel-head {
    align-items: flex-start;
    gap: 6px;
  }

  .panel-eyebrow {
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--clr-text-soft);
  }

  .panel-title {
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.6px;
    line-height: 1.1;
    color: var(--clr-text);
  }

  /* ── KPIs ── */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 0; /* anula el padding global de <section> */
    align-items: stretch; /* <section> global centra → recuadros de distinto alto */
  }

  .kpi {
    position: relative;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 3px;
    padding: 16px;
    border-radius: 14px;
    background: var(--clr-white);
    border: 1px solid var(--clr-border);
  }

  .kpi-icon {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: 1rem;
    color: var(--clr-text-soft);
  }

  .kpi-hero {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    gap: 16px;
    padding: 20px;
  }

  .kpi-hero-main,
  .kpi-hero-side {
    align-items: flex-start;
    gap: 4px;
  }

  .kpi-hero-side {
    align-items: flex-end;
    text-align: right;
    justify-content: center;
    padding-left: 16px;
    border-left: 1px solid var(--clr-border);
  }

  .kpi-num {
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1;
    color: var(--clr-text);
  }

  .kpi-hero .kpi-num {
    font-size: 3rem;
  }

  .kpi-sat {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1;
    color: var(--clr-success);
  }

  .kpi-lbl {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--clr-text-soft);
  }

  .kpi-sub {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--clr-text-soft);
  }

  /* ── Tarjetas ── */
  .panel-card {
    align-items: stretch;
    gap: 4px;
    padding: 20px 18px;
    border-radius: 16px;
    background: var(--clr-white);
    border: 1px solid var(--clr-border);
  }

  .card-title {
    justify-content: flex-start;
    gap: 8px;
    align-items: baseline;
    margin-bottom: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--clr-text);
  }

  .card-count {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--clr-text-soft);
  }

  .card-hint {
    font-size: 0.78rem;
    color: var(--clr-text-soft);
    margin-bottom: 10px;
  }

  .card-hint:empty {
    display: none;
  }

  .activity-axis {
    justify-content: space-between;
    margin-top: 8px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--clr-text-soft);
  }

  .rank-more {
    align-self: center;
    margin-top: 10px;
    padding: 8px 18px;
    font-size: 0.78rem;
  }

  @media (hover: hover) {
    .back-link:hover {
      color: var(--clr-text);
    }
  }

  @media (min-width: 768px) {
    .panel-page {
      padding: 28px 24px 80px;
    }

    .kpi-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<style is:global>
  /* ── Elementos creados por JS: CSS global prefijado con .panel-page ── */

  /* Colores por banda (mismos cortes que los badges: ≤4 · 5–7 · 8+). */
  .panel-page .is-low  { --band: var(--clr-danger); }
  .panel-page .is-mid  { --band: var(--clr-warning); }
  .panel-page .is-high { --band: var(--clr-success); }

  /* Lo más destacado */
  .panel-page .highlights {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .panel-page .hl {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--clr-white2);
    border: 1px solid var(--clr-border);
    min-width: 0;
  }

  .panel-page .hl-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    font-size: 1.05rem;
    color: var(--band, var(--clr-text));
    background: color-mix(in srgb, var(--band, var(--clr-text)) 14%, transparent);
  }

  .panel-page .hl-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .panel-page .hl-lbl {
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--clr-text-soft);
  }

  .panel-page .hl-name {
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--clr-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .panel-page .hl-meta {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--clr-text-soft);
  }

  .panel-page .hl-score {
    flex-shrink: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--band, var(--clr-text));
  }

  /* Satisfacción: barra apilada de 3 tramos + leyenda */
  .panel-page .sentiment {
    align-items: stretch; /* .flex-column centra por defecto → la barra quedaba en 0 px */
    gap: 8px;
    margin-bottom: 16px;
  }

  /* Una sola barra con gradiente de cortes duros (sin hijos recortados por
     overflow) y animada con transform: animar width/height hacía que Chrome
     dejara "rayas" de color de lado a lado de la pantalla. */
  .panel-page .sent-bar {
    height: 12px;
    border-radius: 6px;
    transform-origin: left center;
    animation: panel-grow-x 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes panel-grow-x {
    from { transform: scaleX(0); }
  }

  @keyframes panel-grow-y {
    from { transform: scaleY(0); }
  }

  .panel-page .sent-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--clr-text-soft);
  }

  .panel-page .sent-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .panel-page .sent-legend b {
    color: var(--clr-text);
  }

  .panel-page .sent-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--band);
  }

  /* Histograma (una columna por nota 1-10) */
  .panel-page .hist {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 150px;
    padding-top: 20px; /* aire para el número sobre la barra más alta */
  }

  .panel-page .hist-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    height: 100%;
    justify-content: flex-end;
  }

  .panel-page .hist-bar-wrap {
    width: 100%;
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .panel-page .hist-bar {
    position: relative;
    width: 100%;
    max-width: 34px;
    height: 0;
    min-height: 2px;
    border-radius: 6px 6px 2px 2px;
    background: var(--band);
    transform-origin: bottom center;
    animation: panel-grow-y 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* Nota sin votos: línea base neutra (no parece un dato). */
  .panel-page .hist-bar.is-zero {
    background: var(--clr-border);
  }

  .panel-page .hist-val {
    position: absolute;
    top: -17px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--clr-text);
  }

  .panel-page .hist-lbl {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--clr-text-soft);
  }

  /* Actividad: una barra por día */
  .panel-page .activity {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 90px;
  }

  .panel-page .act-day {
    flex: 1;
    height: 0;
    min-height: 2px;
    border-radius: 3px 3px 1px 1px;
    background: var(--clr-accent-bg);
    transform-origin: bottom center;
    animation: panel-grow-y 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .panel-page .act-day.is-zero {
    background: var(--clr-border);
  }

  .panel-page .act-day.is-today:not(.is-zero) {
    background: var(--clr-success);
  }

  .panel-page .activity-empty {
    flex: 1;
    align-self: center;
    text-align: center;
    font-size: 0.82rem;
    color: var(--clr-text-soft);
  }

  .panel-page .trend {
    font-weight: 700;
  }
  .panel-page .trend.is-up { color: var(--clr-success); }
  .panel-page .trend.is-down { color: var(--clr-danger); }

  /* Ranking: pestañas */
  .panel-page .rank-tabs {
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
  }

  .panel-page .rank-tab {
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--clr-border);
    background: var(--clr-white2);
    color: var(--clr-text);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-transform: none;
    cursor: pointer;
    transition: var(--transition);
  }

  .panel-page .rank-tab.is-active {
    background: var(--clr-accent-bg);
    border-color: var(--clr-accent-bg);
    color: var(--clr-on-accent);
  }

  /* Ranking: filas */
  .panel-page .rank {
    align-items: stretch;
    gap: 8px;
  }

  .panel-page .rank-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 12px;
    background: var(--clr-white2);
    border: 1px solid var(--clr-border);
  }

  .panel-page .rank-row.is-unrated {
    opacity: 0.6;
  }

  .panel-page .rank-pos {
    flex-shrink: 0;
    width: 26px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--clr-text-soft);
  }

  .panel-page .rank-pos.is-podium {
    font-size: 1.05rem;
  }

  .panel-page .rank-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .panel-page .rank-name {
    font-size: 0.86rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--clr-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .panel-page .rank-track {
    height: 6px;
    border-radius: 3px;
    background: var(--clr-border);
    overflow: hidden;
  }

  .panel-page .rank-fill {
    height: 100%;
    width: 0; /* el JS pone el ancho final; la entrada se anima con transform */
    border-radius: 3px;
    background: var(--band, transparent);
    transform-origin: left center;
    animation: panel-grow-x 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .panel-page .rank-side {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .panel-page .rank-avg {
    /* Ancla el ::after de .badge-* (raya de color inferior). Sin esto se posicionaba
       contra la página y dibujaba una línea de lado a lado de la pantalla. */
    position: relative;
    min-width: 46px;
    text-align: center;
    padding: 5px 10px;
    border-radius: 10px;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1;
  }

  .panel-page .rank-avg.is-empty {
    background: transparent;
    border: 1px dashed var(--clr-border2);
    color: var(--clr-text-soft);
  }

  .panel-page .rank-votes {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--clr-text-soft);
    white-space: nowrap;
  }

  .panel-page .panel-empty {
    padding: 20px;
    text-align: center;
    font-size: 0.86rem;
    color: var(--clr-text-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .panel-page .sent-bar,
    .panel-page .hist-bar,
    .panel-page .act-day,
    .panel-page .rank-fill {
      animation: none;
    }
  }

  @media (min-width: 768px) {
    .panel-page .highlights {
      grid-template-columns: repeat(3, 1fr);
    }

    .panel-page .hl {
      flex-direction: column;
      align-items: flex-start;
    }

    .panel-page .hl-body {
      width: 100%;
    }
  }
</style>

<script>
  import { supabase } from "../lib/supabase.ts";
  import {
    initCache,
    checkOfficialOwnership,
    getOfficialRestaurant,
    getOfficialOwnerStats,
    type OfficialOwnerStats,
    type OfficialOwnerDishStat,
  } from "../lib/data.ts";

  type Band = "low" | "mid" | "high";
  type RankTab = "best" | "improve" | "votes" | "unrated";

  /** Votos "de confianza" del promedio ponderado: un plato con pocos votos se
   *  acerca al promedio general hasta juntar suficientes. */
  const CONFIDENCE_VOTES = 3;
  const RANK_PREVIEW = 10;

  // Estado del ranking (sobrevive a re-renders dentro de la página).
  let rankTab: RankTab = "best";
  let rankShowAll = false;

  /** Banda de color según la nota (mismos cortes que los badges). */
  function band(avg: number): Band {
    if (avg <= 4) return "low";
    if (avg <= 7) return "mid";
    return "high";
  }

  function setText(id: string, value: string): void {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }

  function plural(n: number, one: string, many: string): string {
    return `${n} ${n === 1 ? one : many}`;
  }

  function isRated(d: OfficialOwnerDishStat): d is OfficialOwnerDishStat & { avgRating: number } {
    return d.avgRating !== null && d.votes > 0;
  }

  /** Promedio ponderado por votos (bayesiano) para ordenar sin premiar 1 voto suelto. */
  function weighted(d: OfficialOwnerDishStat & { avgRating: number }, global: number): number {
    return (d.votes * d.avgRating + CONFIDENCE_VOTES * global) / (d.votes + CONFIDENCE_VOTES);
  }

  /** Grupos de satisfacción a partir del histograma 1-10. */
  function sentimentGroups(s: OfficialOwnerStats): { low: number; mid: number; high: number; total: number } {
    let low = 0, mid = 0, high = 0;
    for (const d of s.distribution) {
      const b = band(d.bucket);
      if (b === "low") low += d.count;
      else if (b === "mid") mid += d.count;
      else high += d.count;
    }
    return { low, mid, high, total: low + mid + high };
  }

  const pct = (n: number, total: number) => (total > 0 ? Math.round((n / total) * 100) : 0);

  // ─── KPIs ─────────────────────────────────────────────────────────────────
  function renderKPIs(s: OfficialOwnerStats): void {
    const avgEl = document.getElementById("kpi-avg");
    if (avgEl) {
      avgEl.textContent = s.avgOverall !== null ? s.avgOverall.toFixed(1) : "—";
      avgEl.style.color =
        s.avgOverall !== null ? `var(--clr-${{ low: "danger", mid: "warning", high: "success" }[band(s.avgOverall)]})` : "";
    }
    setText(
      "kpi-avg-sub",
      s.totalRatings > 0
        ? `${plural(s.totalRatings, "calificación", "calificaciones")} de ${plural(s.raters, "persona", "personas")}`
        : "aún sin calificaciones",
    );

    const g = sentimentGroups(s);
    setText("kpi-sat", g.total > 0 ? `${pct(g.high, g.total)}%` : "—");

    setText("kpi-members", String(s.members));
    setText("kpi-raters", String(s.raters));
    setText(
      "kpi-raters-sub",
      s.members > 0 ? `${pct(s.raters, s.members)}% de quienes lo guardaron` : "",
    );
    setText("kpi-total", String(s.totalRatings));
    setText(
      "kpi-total-sub",
      s.raters > 0 ? `${(s.totalRatings / s.raters).toFixed(1)} por persona` : "",
    );
    const rated = s.dishes.filter(isRated).length;
    setText("kpi-dishes", String(rated));
    setText("kpi-dishes-sub", `de ${plural(s.dishes.length, "plato", "platos")} en la carta`);
  }

  // ─── Lo más destacado ─────────────────────────────────────────────────────
  function highlightCard(opts: {
    icon: string;
    label: string;
    name: string;
    meta: string;
    score?: number;
    band?: Band;
  }): HTMLElement {
    const el = document.createElement("div");
    el.className = `hl${opts.band ? ` is-${opts.band}` : ""}`;
    el.innerHTML = `
      <span class="hl-icon"><i class="bi ${opts.icon}"></i></span>
      <span class="hl-body">
        <span class="hl-lbl"></span>
        <span class="hl-name"></span>
        <span class="hl-meta"></span>
      </span>
      ${opts.score !== undefined ? `<span class="hl-score">${opts.score.toFixed(1)}</span>` : ""}`;
    el.querySelector(".hl-lbl")!.textContent = opts.label;
    el.querySelector(".hl-name")!.textContent = opts.name;
    el.querySelector(".hl-meta")!.textContent = opts.meta;
    return el;
  }

  function renderHighlights(s: OfficialOwnerStats): void {
    const host = document.getElementById("highlights");
    if (!host) return;
    host.innerHTML = "";
    const rated = s.dishes.filter(isRated);
    if (rated.length === 0) {
      host.innerHTML = `<div class="panel-empty">Cuando tus clientes califiquen platos, aquí verás los destacados.</div>`;
      return;
    }
    const global = s.avgOverall ?? 7;

    const best = [...rated].sort((a, b) => weighted(b, global) - weighted(a, global))[0];
    host.appendChild(
      highlightCard({
        icon: "bi-trophy-fill",
        label: "Mejor valorado",
        name: best.name,
        meta: plural(best.votes, "voto", "votos"),
        score: best.avgRating,
        band: band(best.avgRating),
      }),
    );

    const most = [...rated].sort((a, b) => b.votes - a.votes || b.avgRating - a.avgRating)[0];
    host.appendChild(
      highlightCard({
        icon: "bi-fire",
        label: "El más calificado",
        name: most.name,
        meta: plural(most.votes, "voto", "votos"),
        score: most.avgRating,
        band: band(most.avgRating),
      }),
    );

    // "Por mejorar": el peor con al menos 2 votos (1 voto suelto no es tendencia).
    const weak = rated
      .filter((d) => d.votes >= 2 && d.avgRating < 7)
      .sort((a, b) => a.avgRating - b.avgRating)[0];
    host.appendChild(
      weak
        ? highlightCard({
            icon: "bi-exclamation-triangle-fill",
            label: "Para revisar",
            name: weak.name,
            meta: plural(weak.votes, "voto", "votos"),
            score: weak.avgRating,
            band: band(weak.avgRating),
          })
        : highlightCard({
            icon: "bi-hand-thumbs-up-fill",
            label: "Para revisar",
            name: "Todo en orden",
            meta: "Ningún plato bajo 7 con 2+ votos",
            band: "high",
          }),
    );
  }

  // ─── Satisfacción + histograma ────────────────────────────────────────────
  function renderSentiment(s: OfficialOwnerStats): void {
    const host = document.getElementById("sentiment");
    if (!host) return;
    const g = sentimentGroups(s);
    if (g.total === 0) {
      host.innerHTML = "";
      return;
    }
    const parts: Array<[Band, number, string]> = [
      ["high", g.high, "8 a 10"],
      ["mid", g.mid, "5 a 7"],
      ["low", g.low, "1 a 4"],
    ];
    // Barra única: gradiente con cortes duros en los % acumulados.
    const bandVar: Record<Band, string> = {
      high: "var(--clr-success)",
      mid: "var(--clr-warning)",
      low: "var(--clr-danger)",
    };
    let acc = 0;
    const stops: string[] = [];
    for (const [b, n] of parts) {
      const from = acc;
      acc += (n / g.total) * 100;
      stops.push(`${bandVar[b]} ${from}% ${acc}%`);
    }
    const bar = document.createElement("div");
    bar.className = "sent-bar";
    bar.style.background = `linear-gradient(to right, ${stops.join(", ")})`;
    const legend = document.createElement("div");
    legend.className = "sent-legend";
    for (const [b, n, label] of parts) {
      const item = document.createElement("span");
      item.className = `is-${b}`;
      item.innerHTML = `<i class="sent-dot"></i><b>${pct(n, g.total)}%</b> ${label}`;
      legend.appendChild(item);
    }
    host.innerHTML = "";
    host.append(bar, legend);
  }

  function renderHistogram(s: OfficialOwnerStats): void {
    const host = document.getElementById("hist");
    if (!host) return;
    host.innerHTML = "";
    const max = Math.max(1, ...s.distribution.map((d) => d.count));
    s.distribution.forEach((d) => {
      const col = document.createElement("div");
      col.className = "hist-col";
      col.title = `Nota ${d.bucket}: ${plural(d.count, "calificación", "calificaciones")}`;

      const wrap = document.createElement("div");
      wrap.className = "hist-bar-wrap";
      const bar = document.createElement("div");
      bar.className = `hist-bar is-${band(d.bucket)}${d.count === 0 ? " is-zero" : ""}`;
      if (d.count > 0) {
        const val = document.createElement("span");
        val.className = "hist-val";
        val.textContent = String(d.count);
        bar.appendChild(val);
        bar.style.height = `${(d.count / max) * 100}%`;
      }
      wrap.appendChild(bar);

      const lbl = document.createElement("span");
      lbl.className = "hist-lbl";
      lbl.textContent = String(d.bucket);

      col.append(wrap, lbl);
      host.appendChild(col);
    });
  }

  // ─── Actividad (barras por día, 30 días) ──────────────────────────────────
  function renderActivity(s: OfficialOwnerStats): void {
    const host = document.getElementById("activity");
    if (!host) return;
    host.innerHTML = "";

    // Eje de 30 días terminando hoy; se vuelcan los conteos del RPC sobre él.
    const days: string[] = [];
    const today = new Date();
    for (let i = 29; i >= 0; i--) {
      const dt = new Date(today);
      dt.setDate(today.getDate() - i);
      days.push(dt.toISOString().slice(0, 10));
    }
    const map = new Map(s.timeline.map((t) => [t.day, t.count]));
    const counts = days.map((d) => map.get(d) ?? 0);

    const fmt = (iso: string) =>
      new Date(`${iso}T12:00:00`).toLocaleDateString("es-CO", { day: "numeric", month: "short" });
    setText("act-start", fmt(days[0]));

    const total = counts.reduce((a, b) => a + b, 0);
    const summaryEl = document.getElementById("act-summary");
    if (total === 0) {
      host.innerHTML = `<div class="activity-empty">Sin calificaciones en los últimos 30 días.</div>`;
      if (summaryEl) summaryEl.textContent = "Calificaciones recibidas por día.";
      return;
    }

    // Últimos 7 días vs los 7 anteriores.
    const last7 = counts.slice(-7).reduce((a, b) => a + b, 0);
    const prev7 = counts.slice(-14, -7).reduce((a, b) => a + b, 0);
    if (summaryEl) {
      let trend = "";
      if (prev7 > 0) {
        const diff = Math.round(((last7 - prev7) / prev7) * 100);
        const cls = diff > 0 ? "is-up" : diff < 0 ? "is-down" : "";
        const arrow = diff > 0 ? "↑" : diff < 0 ? "↓" : "=";
        trend = ` <span class="trend ${cls}">${arrow} ${Math.abs(diff)}%</span> vs. la semana anterior`;
      } else if (last7 > 0) {
        trend = ` <span class="trend is-up">nuevo</span> esta semana`;
      }
      summaryEl.innerHTML = `<b>${total}</b> en 30 días · <b>${last7}</b> esta semana${trend}`;
    }

    const max = Math.max(1, ...counts);
    counts.forEach((c, i) => {
      const bar = document.createElement("div");
      bar.className = "act-day";
      if (c === 0) bar.classList.add("is-zero");
      if (i === counts.length - 1) bar.classList.add("is-today");
      bar.title = `${fmt(days[i])}: ${plural(c, "calificación", "calificaciones")}`;
      host.appendChild(bar);
      if (c > 0) bar.style.height = `${(c / max) * 100}%`;
    });
  }

  // ─── Ranking con pestañas ─────────────────────────────────────────────────
  function rankRow(d: OfficialOwnerDishStat, pos: number | null): HTMLElement {
    const row = document.createElement("div");
    row.className = "rank-row";
    const rated = isRated(d);
    if (!rated) row.classList.add("is-unrated");

    const posEl = document.createElement("span");
    posEl.className = "rank-pos";
    if (pos !== null && pos <= 3 && rankTab === "best") {
      posEl.classList.add("is-podium");
      posEl.textContent = ["🥇", "🥈", "🥉"][pos - 1];
    } else {
      posEl.textContent = pos !== null ? String(pos) : "·";
    }

    const main = document.createElement("div");
    main.className = "rank-main";
    const name = document.createElement("span");
    name.className = "rank-name";
    name.textContent = d.name;
    const track = document.createElement("div");
    track.className = "rank-track";
    const fill = document.createElement("div");
    fill.className = rated ? `rank-fill is-${band(d.avgRating)}` : "rank-fill";
    if (rated) {
      fill.style.width = `${(d.avgRating / 10) * 100}%`;
    }
    track.appendChild(fill);
    main.append(name, track);

    const side = document.createElement("div");
    side.className = "rank-side";
    const avgEl = document.createElement("span");
    if (rated) {
      avgEl.className = `rank-avg badge-${band(d.avgRating)}`;
      avgEl.textContent = d.avgRating.toFixed(1);
    } else {
      avgEl.className = "rank-avg is-empty";
      avgEl.textContent = "—";
    }
    const votes = document.createElement("span");
    votes.className = "rank-votes";
    votes.textContent = rated ? plural(d.votes, "voto", "votos") : "Sin calificar";
    side.append(avgEl, votes);

    row.append(posEl, main, side);
    return row;
  }

  function renderRanking(s: OfficialOwnerStats): void {
    const host = document.getElementById("rank");
    const tabsEl = document.getElementById("rank-tabs");
    const moreBtn = document.getElementById("rank-more") as HTMLButtonElement | null;
    if (!host || !tabsEl || !moreBtn) return;

    const rated = s.dishes.filter(isRated);
    const unrated = s.dishes.filter((d) => !isRated(d));
    setText("rank-count", `${rated.length} de ${s.dishes.length} calificados`);

    if (s.dishes.length === 0) {
      tabsEl.innerHTML = "";
      host.innerHTML = `<div class="panel-empty">Aún no hay platos en la carta.</div>`;
      moreBtn.hidden = true;
      return;
    }

    const global = s.avgOverall ?? 7;
    const lists: Record<RankTab, { label: string; hint: string; items: OfficialOwnerDishStat[] }> = {
      best: {
        label: "Mejores",
        hint: "Ordenado por nota y cantidad de votos: un plato con pocos votos no se adelanta solo por eso.",
        items: [...rated].sort((a, b) => weighted(b, global) - weighted(a, global)),
      },
      improve: {
        label: "Por mejorar",
        hint: "Notas más bajas primero.",
        items: [...rated].sort((a, b) => a.avgRating - b.avgRating || b.votes - a.votes),
      },
      votes: {
        label: "Más votados",
        hint: "Los platos que más califican tus clientes.",
        items: [...rated].sort((a, b) => b.votes - a.votes || b.avgRating - a.avgRating),
      },
      unrated: {
        label: `Sin calificar (${unrated.length})`,
        hint: "Platos de la carta que nadie ha calificado todavía.",
        items: unrated,
      },
    };

    // Pestañas
    tabsEl.innerHTML = "";
    (Object.keys(lists) as RankTab[]).forEach((key) => {
      if (key === "unrated" && unrated.length === 0) return;
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = `rank-tab${key === rankTab ? " is-active" : ""}`;
      btn.setAttribute("role", "tab");
      btn.setAttribute("aria-selected", String(key === rankTab));
      btn.textContent = lists[key].label;
      btn.onclick = () => {
        rankTab = key;
        rankShowAll = false;
        renderRanking(s);
      };
      tabsEl.appendChild(btn);
    });

    const current = lists[rankTab];
    setText("rank-hint", current.hint);
    host.innerHTML = "";
    if (current.items.length === 0) {
      host.innerHTML = `<div class="panel-empty">Nada por aquí todavía.</div>`;
      moreBtn.hidden = true;
      return;
    }
    const visible = rankShowAll ? current.items : current.items.slice(0, RANK_PREVIEW);
    visible.forEach((d, i) => host.appendChild(rankRow(d, rankTab === "unrated" ? null : i + 1)));

    const hiddenCount = current.items.length - visible.length;
    moreBtn.hidden = hiddenCount <= 0 && !rankShowAll;
    moreBtn.textContent = rankShowAll ? "Ver menos" : `Ver todos (${current.items.length})`;
    moreBtn.onclick = () => {
      rankShowAll = !rankShowAll;
      renderRanking(s);
    };
  }

  document.addEventListener("astro:page-load", async () => {
    const page = document.querySelector(".panel-page");
    if (!page) return; // no es esta página

    const id = new URLSearchParams(window.location.search).get("id") ?? "";
    if (!id) { window.location.href = "/"; return; }

    const backEl = document.getElementById("panel-back") as HTMLAnchorElement | null;
    if (backEl) backEl.href = `/oficial?id=${encodeURIComponent(id)}`;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { window.location.href = "/login"; return; }
    await initCache(session.user.id);

    // Solo el dueño ve el panel.
    const owner = await checkOfficialOwnership(id);
    if (!owner) { window.location.href = `/oficial?id=${encodeURIComponent(id)}`; return; }

    const [official, stats] = await Promise.all([
      getOfficialRestaurant(id),
      getOfficialOwnerStats(id),
    ]);

    if (official) {
      setText("panel-title", official.name);
      document.title = `Panel · ${official.name}`;
    }
    if (!stats) {
      const rank = document.getElementById("rank");
      if (rank) rank.innerHTML = `<div class="panel-empty">No se pudieron cargar las estadísticas.</div>`;
      return;
    }

    // Al entrar a otro panel, empezar en "Mejores" con la lista corta.
    rankTab = "best";
    rankShowAll = false;

    renderKPIs(stats);
    renderHighlights(stats);
    renderSentiment(stats);
    renderHistogram(stats);
    renderActivity(stats);
    renderRanking(stats);
  });
</script>
