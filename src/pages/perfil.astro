---
import Layout1 from "../layouts/Layout1.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";
---

<Layout1 title="Perfil · STAURANT">
  <div class="profile-page flex-column">
    <!-- Perfil -->
    <div class="profile-card flex-column">
      <div class="profile-avatar flex-row" id="profile-avatar">
        <i class="bi bi-person-fill"></i>
      </div>

      <div class="profile-info flex-column">
        <p id="profile-name-display" class="profile-name">—</p>
        <p id="profile-username-display" class="profile-username" hidden></p>
        <p id="profile-email" class="profile-email">—</p>
      </div>

      <button id="btn-edit-profile" class="btn-edit">
        <i class="bi bi-pencil"></i> Editar perfil
      </button>
    </div>

    <!-- Modal editar perfil -->
    <div class="overlay" id="edit-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="modal-card flex-column">
        <div class="modal-header flex-row">
          <h2 class="modal-title" id="modal-title">Editar perfil</h2>
          <button class="modal-close btn-icon-close boton2" id="btn-modal-close" aria-label="Cerrar">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>

        <form id="profile-form" class="flex-column" novalidate>
          <label for="profile-name" class="flex-column">
            <span class="field-label">Nombre</span>
            <input
              type="text"
              id="profile-name"
              autocomplete="name"
              placeholder="Tu nombre"
            />
          </label>

          <label for="profile-username" class="flex-column">
            <span class="field-label">Nombre de usuario</span>
            <input
              type="text"
              id="profile-username"
              autocomplete="username"
              placeholder="tu_usuario"
              autocapitalize="off"
              spellcheck="false"
            />
            <span class="field-hint">Para que otros te encuentren. Solo letras, números y _</span>
          </label>

          <!-- Campos de contraseña: solo para usuarios email -->
          <div id="pw-fields">
            <div class="form-section-label flex-row">
              <span class="field-label">Contraseña</span>
              <span class="field-hint">Dejar vacío para no cambiarla</span>
            </div>
            <label for="pw-new" class="flex-column">
              <span class="field-label">Nueva contraseña</span>
              <div class="pw-wrapper flex-row">
                <input
                  type="password"
                  id="pw-new"
                  autocomplete="new-password"
                  placeholder="••••••••"
                />
                <button
                  type="button"
                  class="pw-toggle"
                  id="toggle-pw-new"
                  aria-label="Mostrar contraseña"
                >
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </label>
            <label for="pw-confirm" class="flex-column">
              <span class="field-label">Confirmar contraseña</span>
              <div class="pw-wrapper flex-row">
                <input
                  type="password"
                  id="pw-confirm"
                  autocomplete="new-password"
                  placeholder="••••••••"
                />
                <button
                  type="button"
                  class="pw-toggle"
                  id="toggle-pw-confirm"
                  aria-label="Mostrar contraseña"
                >
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </label>
          </div>

          <p id="profile-msg" class="profile-msg" aria-live="polite"></p>
          <button type="submit" class="btn-primary">Guardar cambios</button>
        </form>
      </div>
    </div>

    <!-- Modal: solicitar restaurante oficial -->
    <div class="overlay" id="request-overlay" role="dialog" aria-modal="true" aria-labelledby="req-title">
      <div class="modal-card flex-column">
        <div class="modal-header flex-row">
          <h2 class="modal-title" id="req-title">Solicitar restaurante oficial</h2>
          <button class="modal-close btn-icon-close boton2" id="req-close" aria-label="Cerrar">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
        <form id="request-form" class="flex-column" novalidate>
          <label for="req-name" class="flex-column">
            <span class="field-label">Nombre del restaurante</span>
            <input type="text" id="req-name" placeholder="Ej: Pizza Napoli" autocomplete="off" />
            <span class="field-hint">Enviaremos tu solicitud al equipo. Te avisaremos cuando la aprueben.</span>
          </label>
          <p id="req-msg" class="profile-msg" aria-live="polite"></p>
          <button type="submit" class="btn-primary">Enviar solicitud</button>
        </form>
      </div>
    </div>

    <!-- Modal: bandeja de solicitudes pendientes (superadmin) -->
    <div class="overlay" id="inbox-overlay" role="dialog" aria-modal="true" aria-labelledby="inbox-title">
      <div class="modal-card flex-column">
        <div class="modal-header flex-row">
          <h2 class="modal-title" id="inbox-title">Solicitudes pendientes</h2>
          <button class="modal-close btn-icon-close boton2" id="inbox-close" aria-label="Cerrar">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
        <div id="inbox-list" class="inbox-list flex-column">
          <p class="top3-empty">Cargando…</p>
        </div>
      </div>
    </div>

    <!-- Modal: crear oficial para un usuario (superadmin) -->
    <div class="overlay" id="assign-overlay" role="dialog" aria-modal="true" aria-labelledby="assign-title">
      <div class="modal-card flex-column">
        <div class="modal-header flex-row">
          <h2 class="modal-title" id="assign-title">Crear oficial para un usuario</h2>
          <button class="modal-close btn-icon-close boton2" id="assign-close" aria-label="Cerrar">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
        <form id="assign-form" class="flex-column" novalidate>
          <label for="assign-search" class="flex-column">
            <span class="field-label">Usuario</span>
            <input type="text" id="assign-search" placeholder="Buscar por @usuario o nombre" autocomplete="off" />
          </label>
          <div id="assign-results" class="inbox-list" hidden></div>
          <div id="assign-selected" class="assign-chip flex-row" hidden>
            <i class="bi bi-person-check-fill"></i>
            <span id="assign-selected-label"></span>
            <button type="button" id="assign-clear" class="assign-clear" aria-label="Cambiar">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
          <label for="assign-name" class="flex-column">
            <span class="field-label">Nombre del restaurante</span>
            <input type="text" id="assign-name" placeholder="Nombre del restaurante" autocomplete="off" />
          </label>
          <p id="assign-msg" class="profile-msg" aria-live="polite"></p>
          <button type="submit" class="btn-primary">Crear y asignar</button>
        </form>
      </div>
    </div>

    <!-- Mi restaurante: acceso a gestión (solo si el usuario es dueño de un oficial) -->
    <a id="my-restaurant-card" class="dash-card mgmt-card flex-row" href="#" hidden>
      <div class="mgmt-icon flex-row"><i class="bi bi-shop"></i></div>
      <div class="mgmt-text flex-column">
        <span class="mgmt-heading">Mi restaurante</span>
        <span class="mgmt-sub" id="my-restaurant-name">—</span>
      </div>
      <i class="bi bi-chevron-right install-card-arrow"></i>
    </a>

    <!-- Solicitar restaurante oficial (usuario normal). Contenido dinámico según
         el estado de su solicitud: solicitar / en revisión / aprobada→crear. -->
    <div id="request-official-card" class="dash-card req-card flex-column" hidden></div>

    <!-- Bandeja del superadmin: solicitudes pendientes (solo visible para admin) -->
    <button id="admin-inbox-card" class="dash-card mgmt-card flex-row" type="button" hidden>
      <div class="mgmt-icon flex-row"><i class="bi bi-inbox-fill"></i></div>
      <div class="mgmt-text flex-column">
        <span class="mgmt-heading">Solicitudes</span>
        <span class="mgmt-sub" id="admin-inbox-sub">—</span>
      </div>
      <i class="bi bi-chevron-right install-card-arrow"></i>
    </button>

    <!-- Crear oficial para un usuario (solo superadmin) -->
    <button id="admin-assign-card" class="dash-card mgmt-card flex-row" type="button" hidden>
      <div class="mgmt-icon flex-row"><i class="bi bi-shop-window"></i></div>
      <div class="mgmt-text flex-column">
        <span class="mgmt-heading">Crear oficial</span>
        <span class="mgmt-sub">Asignar a un usuario</span>
      </div>
      <i class="bi bi-chevron-right install-card-arrow"></i>
    </button>

    <!-- Instalar app -->
    <div class="dash-card install-card-btn flex-row" id="install-profile-card" role="button" tabindex="0" aria-label="Instalar STAURANT">
      <img src="/img/icon-192.png" alt="" class="install-card-icon" />
      <div class="install-card-text flex-column">
        <span class="install-card-heading">Instalar STAURANT</span>
        <span class="install-card-sub">Agrega la app a tu pantalla de inicio</span>
      </div>
      <i class="bi bi-chevron-right install-card-arrow"></i>
    </div>

    <!-- Columna derecha: stats + top 3 -->
    <div class="dash-col flex-column">
      <div class="dash-card flex-column">
        <h2 class="dash-title flex-row">
          <i class="bi bi-bar-chart-fill"></i> Tu actividad
        </h2>
        <div class="stats-grid">
          <div class="stat-cell flex-column">
            <span class="stat-number accent-green" id="sn-visited">—</span>
            <span class="stat-label">Visitados</span>
          </div>
          <div class="stat-cell flex-column">
            <span class="stat-number" id="sn-pending">—</span>
            <span class="stat-label">Pendientes</span>
          </div>
          <div class="stat-cell flex-column">
            <span class="stat-number" id="sn-dishes">—</span>
            <span class="stat-label">Platos</span>
          </div>
          <div class="stat-cell flex-column">
            <span class="stat-number" id="sn-avg">—</span>
            <span class="stat-label">Promedio</span>
          </div>
        </div>
      </div>

      <div class="dash-card flex-column">
        <h2 class="dash-title flex-row">
          <i class="bi bi-trophy-fill"></i> Top 3 platos
        </h2>
        <div id="top3-dishes-list" class="top3-list flex-column">
          <p class="top3-empty">Añade platos para ver tus favoritos</p>
        </div>
      </div>

      <div class="dash-card flex-column">
        <h2 class="dash-title flex-row">
          <i class="bi bi-star-fill"></i> Top 3 restaurantes
        </h2>
        <div id="top3-restaurants-list" class="top3-list flex-column">
          <p class="top3-empty">Califica platos para ver tus favoritos</p>
        </div>
      </div>

      <div class="dash-card flex-column">
        <h2 class="dash-title flex-row">
          <i class="bi bi-fork-knife"></i> Top 3 más probados
        </h2>
        <div id="top3-most-tried-list" class="top3-list flex-column">
          <p class="top3-empty">Añade platos para ver tus favoritos</p>
        </div>
      </div>
    </div>

    <label class="theme-card flex-row" for="theme-toggle">
      <span class="theme-label flex-row">
        <i class="bi bi-moon-stars-fill"></i> Modo oscuro
      </span>
      <input type="checkbox" id="theme-toggle" class="theme-switch" role="switch" />
    </label>

    <!-- Al final, lejos de "Editar perfil", para no tocarlo sin querer. -->
    <button id="btn-logout" class="btn-danger-outline">
      <i class="bi bi-box-arrow-right"></i> Cerrar sesión
    </button>
  </div>

  <ConfirmDialog />
</Layout1>

<style>
  .profile-page {
    width: 100%;
    max-width: 480px;
    padding: 20px 16px 80px;
    align-items: stretch;
    gap: 16px;
  }

  .dash-col {
    align-items: stretch;
    gap: 16px;
  }

  /* ── Cards ── */

  .profile-card,
  .dash-card {
    background: var(--clr-white);
    border: solid 1px var(--clr-border);
    border-radius: 20px;
    padding: 24px 20px;
    align-items: stretch;
    justify-content: flex-start;
    gap: 20px;
  }

  /* ── Profile card internals ── */

  .profile-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--clr-white2);
    border: solid 2px var(--clr-border);
    font-size: 2rem;
    color: var(--clr-primary);
    align-self: center;
  }

  .profile-info {
    gap: 4px;
    text-align: center;
  }

  .profile-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--clr-text);
  }

  .profile-username {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--clr-primary);
    letter-spacing: 0.2px;
  }

  .profile-username[hidden] {
    display: none;
  }

  .profile-email {
    font-size: 0.88rem;
    color: var(--clr-text);
    opacity: 0.5;
    word-break: break-all;
  }

  .btn-edit {
    gap: 7px;
    width: 100%;
    background: var(--clr-white2);
    border: solid 1.5px var(--clr-border);
    color: var(--clr-text);
    border-radius: 12px;
    padding: 11px;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: none;
    cursor: pointer;
    transition: var(--transition);
  }

  /* ── Modo oscuro ── */
  .theme-card {
    justify-content: space-between;
    gap: 12px;
    background: var(--clr-white);
    border: solid 1px var(--clr-border);
    border-radius: 20px;
    padding: 16px 20px;
    cursor: pointer;
  }

  .theme-label {
    gap: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--clr-text);
  }

  .theme-card .theme-switch {
    position: relative;
    flex-shrink: 0;
    width: 46px;
    height: 26px;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--clr-border2);
    appearance: none;
    cursor: pointer;
    transition: var(--transition);
  }

  .theme-card .theme-switch::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--clr-white);
    transition: transform var(--transition);
  }

  .theme-card .theme-switch:checked {
    background: var(--clr-accent-bg);
  }

  .theme-card .theme-switch:checked::after {
    transform: translateX(20px);
  }

  .theme-card .theme-switch:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .btn-danger-outline {
    gap: 8px;
    width: 100%;
    background: var(--clr-danger-bg);
    border: solid 1.5px var(--clr-danger-border-soft);
    color: var(--clr-danger);
    border-radius: 12px;
    padding: 11px;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: none;
    cursor: pointer;
    transition: var(--transition);
  }

  /* ── Modal ── */

  .modal-card {
    background: var(--clr-white);
    border-radius: 20px;
    padding: 24px 20px;
    width: 100%;
    max-width: 420px;
    align-items: stretch;
    gap: 20px;
  }

  .modal-header {
    justify-content: space-between;
  }

  .modal-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--clr-text);
    margin: 0;
  }

  .field-label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--clr-text);
    text-transform: uppercase;
  }

  .field-hint {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--clr-text);
    opacity: 0.5;
    letter-spacing: 0;
    text-transform: none;
  }

  .form-section-label {
    justify-content: flex-start;
    align-items: baseline;
    gap: 8px;
    padding-top: 4px;
    border-top: 1px solid var(--clr-border);
  }

  form {
    align-items: stretch;
    gap: 12px;
  }

  label {
    align-items: stretch;
    gap: 5px;
  }

  label input {
    border-radius: var(--border-radius);
    width: 100%;
  }

  /* ── Password toggle dentro del input ── */

  #pw-fields {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .pw-wrapper {
    position: relative;
  }

  .pw-wrapper input {
    flex: 1;
    padding-right: 44px;
    border-radius: var(--border-radius);
  }

  .pw-toggle {
    position: absolute;
    right: 0;
    top: 0;
    height: 100%;
    width: 42px;
    background: transparent;
    border: none;
    color: var(--clr-text);
    opacity: 0.4;
    font-size: 0.95rem;
    letter-spacing: 0;
    text-transform: none;
    padding: 0;
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    cursor: pointer;
    transition: opacity 0.12s ease;
  }

  /* ── Messages ── */

  .profile-msg {
    font-size: 0.85rem;
    min-height: 1.2em;
    color: var(--clr-primary);
    font-weight: 600;
  }

  .profile-msg.error {
    color: var(--clr-danger);
  }

  /* ── Buttons ── */

  .btn-primary {
    width: 100%;
    background: var(--clr-accent-bg);
    color: var(--clr-on-accent);
    border-color: var(--clr-accent-bg);
    border-radius: 12px;
    padding: 12px;
    font-size: 0.9rem;
    letter-spacing: 1px;
  }

  /* ── Dashboard ── */

  .dash-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--clr-text);
    opacity: 0.5;
    margin: 0;
    justify-content: flex-start;
    gap: 6px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .stat-cell {
    background: var(--clr-white2);
    border-radius: 14px;
    padding: 14px 8px;
    gap: 5px;
    text-align: center;
  }

  .stat-number {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--clr-text);
    line-height: 1;
    letter-spacing: -0.5px;
  }

  .stat-number.accent-green { color: var(--clr-primary); }
  .stat-number.accent-muted { color: var(--clr-text); opacity: 0.45; }

  .stat-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--clr-text);
    opacity: 0.45;
  }

  .top3-list {
    align-items: stretch;
    gap: 10px;
  }

  .top3-empty {
    font-size: 0.85rem;
    color: var(--clr-text);
    opacity: 0.45;
    text-align: center;
    padding: 8px 0;
  }

  /* ── Mi restaurante (gestión) ── */

  .mgmt-card {
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    text-decoration: none;
    cursor: pointer;
    transition: var(--transition);
  }

  .mgmt-card[hidden] {
    display: none;
  }

  .mgmt-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    flex-shrink: 0;
    background: var(--clr-white2);
    color: var(--clr-primary);
    font-size: 1.3rem;
    justify-content: center;
    align-items: center;
  }

  .mgmt-text {
    gap: 3px;
    flex: 1;
    align-items: flex-start;
    min-width: 0;
  }

  .mgmt-heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--clr-primary);
  }

  .mgmt-sub {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--clr-text);
    opacity: 0.5;
    text-transform: none;
    letter-spacing: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  /* ── Solicitar oficial ── */

  .req-card { gap: 14px; }
  .req-card[hidden] { display: none; }

  .req-head {
    gap: 4px;
    align-items: flex-start;
  }

  .req-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--clr-text);
  }

  .req-desc {
    font-size: 0.82rem;
    color: var(--clr-text);
    opacity: 0.55;
    line-height: 1.45;
  }

  .req-status {
    gap: 8px;
    align-items: center;
    justify-content: flex-start;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .req-status.pending { color: var(--clr-warning); }
  .req-status.approved { color: var(--clr-success); }

  /* ── Bandeja de solicitudes (superadmin) ── */

  .inbox-list {
    align-items: stretch;
    gap: 10px;
    max-height: 60vh;
    overflow-y: auto;
  }

  .admin-inbox-card[hidden] { display: none; }

  .assign-chip {
    gap: 8px;
    align-items: center;
    justify-content: flex-start;
    padding: 10px 12px;
    background: var(--clr-white2);
    border-radius: 12px;
    color: var(--clr-primary);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .assign-chip[hidden] { display: none; }
  #assign-results[hidden] { display: none; }

  .assign-clear {
    margin-left: auto;
    background: transparent;
    border: none;
    color: var(--clr-text);
    opacity: 0.5;
    cursor: pointer;
    padding: 2px 4px;
  }

  /* ── Install card ── */

  .install-card-btn {
    cursor: pointer;
    gap: 14px;
    align-items: center;
    transition: var(--transition);
    padding: 16px 20px;
    user-select: none;
  }

  .install-card-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    flex-shrink: 0;
  }

  .install-card-text {
    gap: 3px;
    flex: 1;
    align-items: flex-start;
  }

  .install-card-heading {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--clr-text);
  }

  .install-card-sub {
    font-size: 0.8rem;
    color: var(--clr-text);
    opacity: 0.5;
    line-height: 1.45;
  }

  .install-card-arrow {
    font-size: 0.85rem;
    color: var(--clr-text);
    opacity: 0.3;
    flex-shrink: 0;
  }

  /* ── Hover ── */

  @media (hover: hover) {
    .btn-edit:hover {
      border-color: var(--clr-border2);
      color: var(--clr-primary);
    }

    .btn-primary:hover {
      background: var(--clr-accent-bg-hover);
      border-color: var(--clr-accent-bg);
    }

    .btn-danger-outline:hover {
      background: var(--clr-danger-bg-strong);
      border-color: var(--clr-danger);
    }

    .pw-toggle:hover { opacity: 0.85; }
    .install-card-btn:hover {
      border-color: var(--clr-border2);
      background: var(--clr-white2);
    }
    .mgmt-card:hover {
      background: var(--clr-white2);
    }
  }

  @media (min-width: 768px) {
    .profile-page {
      max-width: 860px;
      padding: 32px 24px 80px;
      gap: 20px;
    }

    /* Profile card: 3 cols — avatar | info | botones */
    .profile-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 10px 24px;
      padding: 24px 28px;
      align-items: center;
    }

    .profile-avatar {
      grid-column: 1;
      grid-row: 1 / 3;
      width: 80px;
      height: 80px;
      font-size: 2.5rem;
    }

    .profile-info {
      grid-column: 2;
      grid-row: 1 / 3;
      align-items: flex-start;
      text-align: left;
      align-self: center;
    }

    .btn-edit {
      grid-column: 3;
      grid-row: 1 / 3;
      width: auto;
      min-width: 160px;
    }

    .btn-danger-outline {
      align-self: center;
      width: auto;
      min-width: 200px;
    }

    /* Dash col: actividad full-width, tops en segunda fila */
    .dash-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    .dash-col > .dash-card:first-child {
      grid-column: 1 / -1;
    }

    .dash-col > .dash-card:first-child .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .dash-card { padding: 28px 24px; }
    .stat-cell { padding: 16px 8px; }
    .stat-number { font-size: 1.9rem; }
  }
</style>

