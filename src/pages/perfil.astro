<script>
  import { navigate } from "astro:transitions/client";
  import { supabase } from "../lib/supabase.ts";
  import { getRatingBadgeHTML, createOverlay } from "../scripts/store.ts";
  import {
    clearCache,
    initCache,
    isCacheLoaded,
    getHomeEntries,
    getDishes,
    getMyRatedOfficialDishes,
    getMyOwnedOfficials,
    escapeHtml,
    isSuperAdmin,
    getMyOfficialRequest,
    requestOfficial,
    getPendingOfficialRequests,
    resolveOfficialRequest,
    adminCreateOfficialFor,
  } from "../lib/data.ts";
  import { searchUsers } from "../lib/social.ts";

  const PROFILE_CACHE_KEY = "staurant_profile_v1";

  // ─── Helpers de stats ───────────────────────────────────────────────────────

  interface RawRestaurant { id: string; status: string; name: string; href: string }
  interface RawDish { id: string; restaurantId: string; name: string; rating: number | null }

  /** Personales + oficiales de mi lista (mismo criterio que el Inicio). Antes solo
   *  contaba los personales: "Visitados" no cuadraba con el Inicio y los oficiales
   *  nunca entraban a los Top 3. */
  function statsSource(): { restaurants: RawRestaurant[]; dishes: RawDish[] } {
    const restaurants = getHomeEntries().map((e) => ({
      id: e.id,
      status: e.status,
      name: e.name,
      href: e.href,
    }));
    const dishes: RawDish[] = [
      ...getDishes().map((d) => ({
        id: d.id,
        restaurantId: d.restaurantId,
        name: d.name,
        rating: d.rating,
      })),
      ...getMyRatedOfficialDishes().map((o) => ({
        id: o.dish.id,
        restaurantId: o.dish.officialRestaurantId,
        name: o.dish.name,
        rating: o.rating,
      })),
    ];
    return { restaurants, dishes };
  }

  function renderStats({ restaurants, dishes }: { restaurants: RawRestaurant[]; dishes: RawDish[] }): void {
    const visited = restaurants.filter((r) => r.status === "visited").length;
    const pending = restaurants.filter((r) => r.status === "pending").length;
    const ratedDishes = dishes.filter((d) => d.rating !== null);
    const avgAll =
      ratedDishes.length > 0
        ? Math.round((ratedDishes.reduce((s, d) => s + d.rating!, 0) / ratedDishes.length) * 10) / 10
        : null;

    const set = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };
    set("sn-visited", String(visited));
    set("sn-pending", String(pending));
    set("sn-dishes", String(ratedDishes.length));
    set("sn-avg", avgAll !== null ? String(avgAll) : "—");

    const medals = ["🥇", "🥈", "🥉"];
    const restaurantMap = new Map(restaurants.map((r) => [r.id, r.name]));
    const hrefOf = (id: string) =>
      restaurants.find((r) => r.id === id)?.href ?? `/restaurante?id=${encodeURIComponent(id)}`;
    const dishesByRestaurant = new Map<string, typeof dishes>();
    for (const d of dishes) {
      const bucket = dishesByRestaurant.get(d.restaurantId) ?? [];
      bucket.push(d);
      dishesByRestaurant.set(d.restaurantId, bucket);
    }

    // ── Top 3 platos ──
    const dishesEl = document.getElementById("top3-dishes-list");
    if (dishesEl) {
      const top3Dishes = [...dishes].filter((d) => d.rating !== null).sort((a, b) => b.rating! - a.rating!).slice(0, 3);
      if (top3Dishes.length === 0) {
        dishesEl.innerHTML = '<p class="top3-empty">Añade platos para ver tus favoritos</p>';
      } else {
        dishesEl.innerHTML = top3Dishes
          .map((d, i) => {
            const restaurantName = escapeHtml(restaurantMap.get(d.restaurantId) ?? "");
            return `<a href="${hrefOf(d.restaurantId)}" class="top3-item flex-row">
              <span class="top3-medal">${medals[i]}</span>
              <span class="top3-info flex-column">
                <span class="top3-name">${escapeHtml(d.name)}</span>
                ${restaurantName ? `<span class="top3-restaurant">${restaurantName}</span>` : ""}
              </span>
              ${getRatingBadgeHTML(d.rating)}
            </a>`;
          })
          .join("");
      }
    }

    // ── Top 3 más probados (por cantidad de platos) ──
    const mostTriedEl = document.getElementById("top3-most-tried-list");
    if (mostTriedEl) {
      const top3MostTried = restaurants
        .map((r) => ({
          id: r.id,
          name: r.name,
          count: dishesByRestaurant.get(r.id)?.filter((d) => d.rating !== null).length ?? 0,
        }))
        .filter((r) => r.count > 0)
        .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
        .slice(0, 3);
      if (top3MostTried.length === 0) {
        mostTriedEl.innerHTML = '<p class="top3-empty">Añade platos para ver tus favoritos</p>';
      } else {
        mostTriedEl.innerHTML = top3MostTried
          .map((r, i) => {
            return `<a href="${hrefOf(r.id)}" class="top3-item flex-row">
              <span class="top3-medal">${medals[i]}</span>
              <span class="top3-info flex-column">
                <span class="top3-name">${escapeHtml(r.name)}</span>
              </span>
              <span class="top3-count-badge">
                <span class="count-num">${r.count}</span>
              </span>
            </a>`;
          })
          .join("");
      }
    }

    // ── Top 3 restaurantes ──
    const restaurantsEl = document.getElementById("top3-restaurants-list");
    if (restaurantsEl) {
      const top3Restaurants = restaurants
        .map((r) => {
          const rd = dishesByRestaurant.get(r.id);
          const rated = rd?.filter((d) => d.rating !== null) ?? [];
          if (rated.length === 0) return null;
          const avg = Math.round((rated.reduce((s, d) => s + d.rating!, 0) / rated.length) * 10) / 10;
          return { id: r.id, name: r.name, avg };
        })
        .filter((x): x is { id: string; name: string; avg: number } => x !== null)
        .sort((a, b) => b.avg - a.avg)
        .slice(0, 3);
      if (top3Restaurants.length === 0) {
        restaurantsEl.innerHTML = '<p class="top3-empty">Califica platos para ver tus favoritos</p>';
      } else {
        restaurantsEl.innerHTML = top3Restaurants
          .map((r, i) => {
            return `<a href="${hrefOf(r.id)}" class="top3-item flex-row">
              <span class="top3-medal">${medals[i]}</span>
              <span class="top3-info flex-column">
                <span class="top3-name">${escapeHtml(r.name)}</span>
              </span>
              ${getRatingBadgeHTML(r.avg)}
            </a>`;
          })
          .join("");
      }
    }
  }

  // ─── PRE-RENDER en astro:after-swap ────────────────────────────────────────

  document.addEventListener("astro:after-swap", () => {
    const emailEl = document.getElementById("profile-email");
    if (!emailEl) return;
    try {
      const profileCached = JSON.parse(localStorage.getItem(PROFILE_CACHE_KEY) ?? "null");
      if (profileCached) {
        emailEl.textContent = profileCached.email || "—";
        const nameDisplay = document.getElementById("profile-name-display");
        const nameInput = document.getElementById("profile-name") as HTMLInputElement | null;
        const avatarEl = document.getElementById("profile-avatar");
        if (profileCached.name) {
          if (nameDisplay) nameDisplay.textContent = profileCached.name;
          if (nameInput) nameInput.value = profileCached.name;
          if (avatarEl) avatarEl.textContent = profileCached.name.charAt(0).toUpperCase();
        }
        const unameDisplay = document.getElementById("profile-username-display");
        if (unameDisplay) {
          if (profileCached.username) {
            unameDisplay.textContent = `@${profileCached.username}`;
            unameDisplay.hidden = false;
          } else {
            unameDisplay.hidden = true;
          }
        }
      }
      // Pre-render de stats desde el caché (sin parpadeo al volver al perfil).
      if (isCacheLoaded()) renderStats(statsSource());
    } catch { /* ignore */ }
  });

  // ─── Lógica principal ───────────────────────────────────────────────────────

  document.addEventListener("astro:page-load", async () => {
    const emailEl = document.getElementById("profile-email");
    if (!emailEl) return;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) { window.location.href = "/login"; return; }

    const [, { data: profile }] = await Promise.all([
      initCache(session.user.id),
      supabase.from("profiles").select("name, username").eq("id", session.user.id).single(),
    ]);


    const user = session.user;
    const nameInput = document.getElementById("profile-name") as HTMLInputElement;
    const usernameInput = document.getElementById("profile-username") as HTMLInputElement;
    const nameDisplay = document.getElementById("profile-name-display")!;
    const msgEl = document.getElementById("profile-msg")!;
    const avatarEl = document.getElementById("profile-avatar")!;
    const pwNewInput = document.getElementById("pw-new") as HTMLInputElement;
    const pwConfirmInput = document.getElementById("pw-confirm") as HTMLInputElement;

    emailEl.textContent = user.email ?? "";

    if (profile?.name) {
      nameDisplay.textContent = profile.name;
      nameInput.value = profile.name;
      avatarEl.textContent = profile.name.charAt(0).toUpperCase();
    }
    const usernameDisplay = document.getElementById("profile-username-display")!;
    const showUsername = (uname: string | null | undefined) => {
      if (uname) {
        usernameDisplay.textContent = `@${uname}`;
        usernameDisplay.hidden = false;
      } else {
        usernameDisplay.hidden = true;
      }
    };
    if (profile?.username) usernameInput.value = profile.username;
    showUsername(profile?.username);

    // Saneo del username: minúsculas, sin espacios, solo [a-z0-9_].
    usernameInput.oninput = () => {
      const pos = usernameInput.selectionStart;
      usernameInput.value = usernameInput.value
        .toLowerCase()
        .replace(/[^a-z0-9_]/g, "");
      if (pos !== null) usernameInput.setSelectionRange(pos, pos);
    };

    localStorage.setItem(PROFILE_CACHE_KEY,
      JSON.stringify({ email: user.email ?? "", name: profile?.name ?? "", username: profile?.username ?? "" }));

    renderStats(statsSource());

    // Mi restaurante: si el usuario es dueño de un perfil oficial, mostramos el
    // acceso a su gestión (/oficial?id=…). Modelo actual: un restaurante por perfil.
    void getMyOwnedOfficials().then((owned) => {
      const card = document.getElementById("my-restaurant-card") as HTMLAnchorElement | null;
      if (!card) return;
      const mine = owned[0];
      if (!mine) { card.hidden = true; return; }
      const nameEl = document.getElementById("my-restaurant-name");
      if (nameEl) nameEl.textContent = mine.name;
      card.href = `/oficial?id=${encodeURIComponent(mine.id)}`;
      card.hidden = false;
    });

    // ── Solicitud de restaurante oficial + bandeja del superadmin ──────────────
    const reqOverlay = createOverlay("request-overlay")!;
    const inboxOverlay = createOverlay("inbox-overlay")!;

    /** Pinta la card "solicitar oficial" según el estado del usuario. */
    async function renderRequestCard(): Promise<void> {
      const card = document.getElementById("request-official-card")!;
      const superAdmin = await isSuperAdmin();
      const owned = await getMyOwnedOfficials();
      // El superadmin o quien ya es dueño no ve la card de solicitud.
      if (superAdmin || owned.length > 0) { card.hidden = true; return; }

      const req = await getMyOfficialRequest();
      if (req?.status === "pending") {
        card.innerHTML = `
          <div class="req-status pending flex-row">
            <i class="bi bi-hourglass-split"></i>
            <span>Solicitud en revisión</span>
          </div>
          <p class="req-desc">Pediste «${escapeHtml(req.proposedName)}». Te avisaremos cuando la aprobemos.</p>`;
        card.hidden = false;
        return;
      }
      // Aprobada → el restaurante ya se creó al aprobar; lo muestra la card
      // "Mi restaurante" (owned>0), así que esta card queda oculta.
      // Sin solicitud, o rechazada → puede (re)solicitar.
      card.innerHTML = `
        <div class="req-head flex-column">
          <span class="req-title">¿Tienes un restaurante?</span>
          <p class="req-desc">Solicita crear su perfil oficial en STAURANT.</p>
        </div>
        <button type="button" id="btn-request-official" class="btn-primary">Solicitar restaurante oficial</button>`;
      card.hidden = false;
      document.getElementById("btn-request-official")!.onclick = () => {
        (document.getElementById("req-name") as HTMLInputElement).value = "";
        (document.getElementById("req-msg")!).textContent = "";
        reqOverlay.open();
      };
    }
    void renderRequestCard();

    // Modal solicitar → enviar
    document.getElementById("req-close")!.onclick = reqOverlay.close;
    const requestForm = document.getElementById("request-form") as HTMLFormElement;
    requestForm.onsubmit = async (e) => {
      e.preventDefault();
      const nameEl = document.getElementById("req-name") as HTMLInputElement;
      const msgEl = document.getElementById("req-msg")!;
      const name = nameEl.value.trim();
      if (name.length < 2) { msgEl.textContent = "Escribe el nombre del restaurante."; msgEl.classList.add("error"); return; }
      const btn = requestForm.querySelector<HTMLButtonElement>("button[type='submit']")!;
      btn.disabled = true; btn.textContent = "Enviando…";
      const ok = await requestOfficial(name);
      btn.disabled = false; btn.textContent = "Enviar solicitud";
      reqOverlay.close();
      if (ok) {
        (window as any).noticeDialog?.show("¡Solicitud enviada! Te avisaremos cuando la aprobemos.");
        void renderRequestCard();
      } else {
        (window as any).noticeDialog?.show("No se pudo enviar la solicitud. Intenta de nuevo.");
      }
    };

    // ── Bandeja del superadmin ──
    async function renderInboxCard(): Promise<void> {
      const card = document.getElementById("admin-inbox-card")!;
      const assignCard = document.getElementById("admin-assign-card")!;
      if (!(await isSuperAdmin())) { card.hidden = true; assignCard.hidden = true; return; }
      const pending = await getPendingOfficialRequests();
      const sub = document.getElementById("admin-inbox-sub")!;
      sub.textContent = pending.length === 0
        ? "Sin solicitudes pendientes"
        : `${pending.length} pendiente${pending.length === 1 ? "" : "s"}`;
      card.hidden = false;
      assignCard.hidden = false;
    }
    void renderInboxCard();

    // ── Superadmin: crear oficial para un usuario (sin solicitud) ──
    let assignUserId: string | null = null;
    let assignSearchTimer: number | undefined;
    const assignOverlay = createOverlay("assign-overlay", {
      onClose: () => {
        assignUserId = null;
        (document.getElementById("assign-form") as HTMLFormElement).reset();
        document.getElementById("assign-results")!.hidden = true;
        document.getElementById("assign-selected")!.hidden = true;
        document.getElementById("assign-msg")!.textContent = "";
      },
    })!;

    const assignSearch = document.getElementById("assign-search") as HTMLInputElement;
    const assignResults = document.getElementById("assign-results")!;
    const assignSelected = document.getElementById("assign-selected")!;
    const assignSelectedLabel = document.getElementById("assign-selected-label")!;

    const pickUser = (id: string, label: string) => {
      assignUserId = id;
      assignSelectedLabel.textContent = label;
      assignSelected.hidden = false;
      assignResults.hidden = true;
      assignSearch.value = "";
    };

    assignSearch.oninput = () => {
      window.clearTimeout(assignSearchTimer);
      // Permitir escribir con "@" al frente: los usernames se guardan sin él.
      const q = assignSearch.value.trim().replace(/^@+/, "");
      if (q.length < 2) { assignResults.hidden = true; return; }
      assignSearchTimer = window.setTimeout(async () => {
        const users = await searchUsers(q);
        if (users.length === 0) {
          assignResults.innerHTML = '<p class="inbox-empty">Sin resultados.</p>';
        } else {
          assignResults.innerHTML = users.map((u) => {
            const label = u.username ? `@${escapeHtml(u.username)}` : escapeHtml(u.name || "Usuario");
            return `<button type="button" class="assign-result" data-id="${u.id}" data-label="${label}">
              <span class="r-name">${escapeHtml(u.name || "—")}</span>
              ${u.username ? `<span class="r-user">@${escapeHtml(u.username)}</span>` : ""}
            </button>`;
          }).join("");
          assignResults.querySelectorAll<HTMLButtonElement>(".assign-result").forEach((b) => {
            b.onclick = () => pickUser(b.dataset.id!, b.dataset.label!);
          });
        }
        assignResults.hidden = false;
      }, 250);
    };

    document.getElementById("assign-clear")!.onclick = () => {
      assignUserId = null;
      assignSelected.hidden = true;
    };
    document.getElementById("assign-close")!.onclick = assignOverlay.close;
    document.getElementById("admin-assign-card")!.onclick = () => assignOverlay.open();

    const assignForm = document.getElementById("assign-form") as HTMLFormElement;
    assignForm.onsubmit = async (e) => {
      e.preventDefault();
      const msgEl = document.getElementById("assign-msg")!;
      msgEl.classList.remove("error");
      const name = (document.getElementById("assign-name") as HTMLInputElement).value.trim();
      if (!assignUserId) { msgEl.textContent = "Selecciona un usuario."; msgEl.classList.add("error"); return; }
      if (name.length < 2) { msgEl.textContent = "Escribe el nombre del restaurante."; msgEl.classList.add("error"); return; }
      const btn = assignForm.querySelector<HTMLButtonElement>("button[type='submit']")!;
      btn.disabled = true; btn.textContent = "Creando…";
      const newId = await adminCreateOfficialFor(assignUserId, name);
      btn.disabled = false; btn.textContent = "Crear y asignar";
      assignOverlay.close();
      if (newId) {
        (window as any).noticeDialog?.show("Restaurante oficial creado y asignado.");
        navigate(`/oficial?id=${encodeURIComponent(newId)}`);
      } else {
        (window as any).noticeDialog?.show("No se pudo crear el restaurante. Intenta de nuevo.");
      }
    };

    async function renderInboxList(): Promise<void> {
      const list = document.getElementById("inbox-list")!;
      const pending = await getPendingOfficialRequests();
      if (pending.length === 0) {
        list.innerHTML = '<p class="inbox-empty">No hay solicitudes pendientes.</p>';
        return;
      }
      list.innerHTML = pending.map((r) => {
        const who = r.requesterUsername
          ? `@${escapeHtml(r.requesterUsername)}`
          : escapeHtml(r.requesterName ?? "Usuario");
        return `<div class="inbox-item" data-id="${r.id}">
          <div class="inbox-info">
            <span class="inbox-name">${escapeHtml(r.proposedName)}</span>
            <span class="inbox-user">${who}</span>
          </div>
          <div class="inbox-actions">
            <button type="button" class="inbox-btn accept" data-act="accept" aria-label="Aceptar"><i class="bi bi-check-lg"></i></button>
            <button type="button" class="inbox-btn reject" data-act="reject" aria-label="Rechazar"><i class="bi bi-x-lg"></i></button>
          </div>
        </div>`;
      }).join("");

      list.querySelectorAll<HTMLButtonElement>(".inbox-btn").forEach((btn) => {
        btn.onclick = async () => {
          const item = btn.closest(".inbox-item") as HTMLElement;
          const id = item.dataset.id!;
          const accept = btn.dataset.act === "accept";
          const doResolve = async () => {
            const ok = await resolveOfficialRequest(id, accept);
            if (ok) { await renderInboxList(); await renderInboxCard(); }
            else (window as any).noticeDialog?.show("No se pudo procesar la solicitud.");
          };
          if (accept) { void doResolve(); }
          else {
            const label = item.querySelector(".inbox-name")?.textContent ?? "esta solicitud";
            (window as any).confirmDialog?.show(`¿Rechazar «${label}»?`, () => { void doResolve(); });
          }
        };
      });
    }

    document.getElementById("inbox-close")!.onclick = inboxOverlay.close;
    document.getElementById("admin-inbox-card")!.onclick = () => {
      document.getElementById("inbox-list")!.innerHTML = '<p class="inbox-empty">Cargando…</p>';
      inboxOverlay.open();
      void renderInboxList();
    };

    // Mostrar campos de contraseña solo para usuarios email
    const hasEmailIdentity =
      user.identities?.some((i) => i.provider === "email") ?? false;
    const pwFields = document.getElementById("pw-fields")!;
    if (hasEmailIdentity) pwFields.style.display = "flex";

    // Modal open/close (ciclo de overlay vía helper compartido)
    const modal = createOverlay("edit-overlay", {
      onClose: () => {
        pwNewInput.value = "";
        pwConfirmInput.value = "";
        msgEl.textContent = "";
        msgEl.classList.remove("error");
      },
    })!;
    const openModal = () => { modal.open(); msgEl.textContent = ""; msgEl.classList.remove("error"); };
    const closeModal = modal.close;

    document.getElementById("btn-edit-profile")!.onclick = openModal;
    document.getElementById("btn-modal-close")!.onclick = closeModal;

    // Password toggles
    function setupPwToggle(inputId: string, btnId: string) {
      const input = document.getElementById(inputId) as HTMLInputElement;
      const btn = document.getElementById(btnId) as HTMLButtonElement;
      btn.onclick = () => {
        const show = input.type === "password";
        input.type = show ? "text" : "password";
        btn.querySelector("i")!.className = show ? "bi bi-eye-slash" : "bi bi-eye";
      };
    }
    setupPwToggle("pw-new", "toggle-pw-new");
    setupPwToggle("pw-confirm", "toggle-pw-confirm");

    const form = document.getElementById("profile-form") as HTMLFormElement;
    form.onsubmit = async (e) => {
      e.preventDefault();
      msgEl.textContent = "";
      msgEl.classList.remove("error");

      const name = nameInput.value.trim();
      const username = usernameInput.value.trim();
      const newPw = pwNewInput.value;
      const confirmPw = pwConfirmInput.value;

      if (username && username.length < 3) {
        msgEl.textContent = "El usuario debe tener al menos 3 caracteres.";
        msgEl.classList.add("error");
        return;
      }

      if (newPw) {
        if (newPw.length < 6) {
          msgEl.textContent = "La contraseña debe tener al menos 6 caracteres.";
          msgEl.classList.add("error");
          return;
        }
        if (newPw !== confirmPw) {
          msgEl.textContent = "Las contraseñas no coinciden.";
          msgEl.classList.add("error");
          return;
        }
      }

      const btn = form.querySelector<HTMLButtonElement>("button[type='submit']")!;
      btn.disabled = true;
      btn.textContent = "Guardando...";

      // username vacío → null (libera el handle y respeta el índice único).
      const { error: nameError } = await supabase
        .from("profiles")
        .update({ name, username: username || null })
        .eq("id", user.id);

      // 23505 = violación de unicidad (username ya tomado).
      if (nameError && (nameError as { code?: string }).code === "23505") {
        msgEl.textContent = "Ese nombre de usuario ya existe.";
        msgEl.classList.add("error");
        btn.disabled = false;
        btn.textContent = "Guardar cambios";
        return;
      }

      let pwError = null;
      if (newPw && !nameError) {
        const res = await supabase.auth.updateUser({ password: newPw });
        pwError = res.error;
      }

      const anyError = nameError || pwError;
      if (anyError) {
        msgEl.textContent = "Error al guardar. Intenta de nuevo.";
        msgEl.classList.add("error");
      } else {
        msgEl.textContent = "¡Guardado correctamente!";
        nameDisplay.textContent = name || "—";
        if (name) avatarEl.textContent = name.charAt(0).toUpperCase();
        showUsername(username || null);
        localStorage.setItem(PROFILE_CACHE_KEY,
          JSON.stringify({ email: user.email ?? "", name, username: username || "" }));
        pwNewInput.value = "";
        pwConfirmInput.value = "";
      }

      btn.disabled = false;
      btn.textContent = "Guardar cambios";
    };

    // Modo oscuro (preferencia local del dispositivo; Layout1 la aplica al cargar)
    const themeToggle = document.getElementById("theme-toggle") as HTMLInputElement;
    themeToggle.checked = document.documentElement.getAttribute("data-theme") === "dark";
    themeToggle.onchange = () => {
      const dark = themeToggle.checked;
      if (dark) document.documentElement.setAttribute("data-theme", "dark");
      else document.documentElement.removeAttribute("data-theme");
      try {
        localStorage.setItem("staurant_theme", dark ? "dark" : "light");
      } catch {
        /* sin almacenamiento: el cambio dura hasta recargar */
      }
    };

    // Cerrar sesión
    const logoutBtn = document.getElementById("btn-logout")!;
    logoutBtn.onclick = async () => {
      clearCache();
      await supabase.auth.signOut();
      navigate("/login");
    };
  });
</script>
