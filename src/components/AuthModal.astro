---
/**
 * Modal de autenticación inline. Pensado para gatear una acción (ej: calificar
 * en la carta pública) SIN sacar al usuario de la página donde está.
 *
 * API global (refrescada en cada astro:page-load):
 *   window.authModal.open({ onSuccess?, onBeforeGoogle?, title? })
 *   window.authModal.close()
 *
 * - Email/contraseña: 100% inline. Al lograr sesión → close() + onSuccess().
 * - Google: redirige a /auth/callback. onBeforeGoogle() se ejecuta ANTES para
 *   que el consumidor persista la intención y pueda reanudar al volver.
 */
---

<div id="auth-modal-overlay" class="overlay" aria-modal="true" role="dialog">
  <div class="form-box auth-modal-box flex-column" style="max-width:400px">
    <div class="form-header flex-row">
      <h2 id="auth-modal-title">Inicia sesión para calificar</h2>
      <button
        id="auth-modal-close"
        class="btn-close btn-icon-close boton2"
        aria-label="Cerrar"
      >
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <p class="auth-modal-sub">
      Guarda tu calificación y descubre qué probar en tu próxima visita.
    </p>

    <div class="auth-tabs">
      <button class="auth-tab active" data-tab="login" type="button">Iniciar sesión</button>
      <button class="auth-tab" data-tab="register" type="button">Registrarse</button>
    </div>

    <p id="auth-modal-error" class="auth-error" aria-live="polite"></p>

    <!-- Login -->
    <form id="am-form-login" class="flex-column" novalidate>
      <label class="flex-column">
        <span class="field-label">Email</span>
        <input type="email" id="am-login-email" autocomplete="email" placeholder="tu@email.com" required />
      </label>
      <label class="flex-column">
        <span class="field-label">Contraseña</span>
        <input type="password" id="am-login-password" autocomplete="current-password" placeholder="••••••••" required />
      </label>
      <button type="submit" class="btn-primary" id="am-btn-login">Entrar</button>
    </form>

    <div class="social-section flex-column">
      <div class="auth-divider flex-row"><span>o</span></div>
      <button id="am-btn-google" class="btn-google" type="button">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Continuar con Google
      </button>
    </div>

    <!-- Register -->
    <form id="am-form-register" class="flex-column" novalidate>
      <label class="flex-column">
        <span class="field-label">Nombre</span>
        <input type="text" id="am-reg-name" autocomplete="name" placeholder="Tu nombre" />
      </label>
      <label class="flex-column">
        <span class="field-label">Email</span>
        <input type="email" id="am-reg-email" autocomplete="email" placeholder="tu@email.com" required />
      </label>
      <label class="flex-column">
        <span class="field-label">Contraseña <span class="field-hint">(mín. 6 caracteres)</span></span>
        <input type="password" id="am-reg-password" autocomplete="new-password" placeholder="••••••••" required />
      </label>
      <button type="submit" class="btn-primary" id="am-btn-register">Crear cuenta</button>
    </form>
  </div>
</div>

<style>
  .auth-modal-box {
    align-items: stretch;
    gap: 16px;
  }

  /* La cabecera ya aporta separación (borde inferior + margen) desde el sistema
     base; sin esto se sumaría al gap del contenedor y quedaría un hueco doble. */
  .auth-modal-box .form-header {
    margin-bottom: 0;
  }

  .auth-modal-sub {
    font-size: 0.85rem;
    color: var(--clr-text);
    opacity: 0.7;
    line-height: 1.4;
  }

  .auth-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--clr-white2);
    border-radius: 12px;
    padding: 4px;
    gap: 4px;
  }

  .auth-tab {
    padding: 9px;
    border-radius: 9px;
    border: none;
    background: transparent;
    color: var(--clr-text);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-transform: none;
    cursor: pointer;
    transition: var(--transition);
  }

  .auth-tab.active {
    background: var(--clr-white);
    color: var(--clr-primary);
  }

  /* Oculto por defecto antes de que corra el JS */
  #am-form-register {
    display: none;
  }

  form {
    align-items: stretch;
    gap: 14px;
  }

  label {
    align-items: stretch;
    gap: 5px;
  }

  .field-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.8px;
    color: var(--clr-text);
    text-transform: uppercase;
  }

  .field-hint {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--clr-text);
    opacity: 0.6;
    font-size: 0.75rem;
  }

  label input {
    border-radius: var(--border-radius);
    width: 100%;
  }

  .auth-error {
    font-size: 0.85rem;
    color: var(--clr-danger);
    min-height: 1.2em;
    text-align: center;
    margin: -4px 0;
  }

  .auth-error.is-info {
    color: var(--clr-primary);
  }

  .social-section {
    align-items: stretch;
    gap: 14px;
  }

  .auth-divider {
    gap: 10px;
    color: var(--clr-text);
    font-size: 0.78rem;
    opacity: 0.4;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--clr-border);
  }

  .btn-google {
    gap: 10px;
    width: 100%;
    background: var(--clr-white);
    border: 1.5px solid var(--clr-border);
    border-radius: 12px;
    padding: 11px 16px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--clr-text);
    cursor: pointer;
    letter-spacing: 0.3px;
    text-transform: none;
    transition: var(--transition);
  }

  .btn-google svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .btn-google:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-primary {
    width: 100%;
    background: var(--clr-accent-bg);
    color: var(--clr-on-accent);
    border-color: var(--clr-accent-bg);
    font-size: 0.9rem;
    padding: 12px;
    border-radius: 12px;
    letter-spacing: 1px;
  }

  @media (hover: hover) {
    .btn-google:not(:disabled):hover {
      background: var(--clr-white2);
      border-color: var(--clr-border2);
    }

    .btn-primary:hover {
      background: var(--clr-accent-bg-hover);
      border-color: var(--clr-accent-bg);
    }

    .auth-tab:not(.active):hover {
      color: var(--clr-primary);
    }
  }
</style>

<script>
  import { supabase } from "../lib/supabase.ts";
  import { createOverlay } from "../scripts/store.ts";

  interface AuthModalOpts {
    onSuccess?: () => void | Promise<void>;
    onBeforeGoogle?: () => void;
    title?: string;
  }

  document.addEventListener("astro:page-load", () => {
    const overlayApi = createOverlay("auth-modal-overlay");
    if (!overlayApi) return; // no está en esta página
    const { overlay, close } = overlayApi;

    const titleEl = document.getElementById("auth-modal-title")!;
    const closeBtn = document.getElementById("auth-modal-close")!;
    const errorEl = document.getElementById("auth-modal-error")!;
    const tabBtns = document.querySelectorAll<HTMLButtonElement>(".auth-tab");
    const formLogin = document.getElementById("am-form-login") as HTMLFormElement;
    const formRegister = document.getElementById("am-form-register") as HTMLFormElement;
    const btnGoogle = document.getElementById("am-btn-google") as HTMLButtonElement;

    let opts: AuthModalOpts = {};

    function setError(msg: string, info = false) {
      errorEl.textContent = msg;
      errorEl.classList.toggle("is-info", info);
    }

    function showTab(tab: "login" | "register") {
      formLogin.style.display = tab === "login" ? "flex" : "none";
      formRegister.style.display = tab === "register" ? "flex" : "none";
      tabBtns.forEach((btn) =>
        btn.classList.toggle("active", btn.dataset.tab === tab),
      );
      setError("");
    }

    tabBtns.forEach((btn) => {
      btn.onclick = () => showTab(btn.dataset.tab as "login" | "register");
    });

    closeBtn.onclick = close;

    async function handleSuccess() {
      close();
      await opts.onSuccess?.();
    }

    // ─── Login ───────────────────────────────────────────────────────────────
    formLogin.onsubmit = async (e) => {
      e.preventDefault();
      setError("");
      const email = (document.getElementById("am-login-email") as HTMLInputElement).value.trim();
      const password = (document.getElementById("am-login-password") as HTMLInputElement).value;
      const btn = document.getElementById("am-btn-login") as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = "Entrando...";

      const { error } = await supabase.auth.signInWithPassword({ email, password });
      btn.disabled = false;
      btn.textContent = "Entrar";
      if (error) {
        const msg = error.message.toLowerCase();
        setError(
          msg.includes("invalid login credentials")
            ? "Email o contraseña incorrectos."
            : msg.includes("email not confirmed")
              ? "Debes confirmar tu email antes de entrar. Revisa tu correo."
              : msg.includes("too many requests")
                ? "Demasiados intentos. Espera unos minutos."
                : "Error al iniciar sesión. Intenta de nuevo.",
        );
        return;
      }
      await handleSuccess();
    };

    // ─── Register ────────────────────────────────────────────────────────────
    formRegister.onsubmit = async (e) => {
      e.preventDefault();
      setError("");
      const name = (document.getElementById("am-reg-name") as HTMLInputElement).value.trim();
      const email = (document.getElementById("am-reg-email") as HTMLInputElement).value.trim();
      const password = (document.getElementById("am-reg-password") as HTMLInputElement).value;
      const btn = document.getElementById("am-btn-register") as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = "Creando cuenta...";

      const { data, error } = await supabase.auth.signUp({
        email,
        password,
        options: { data: { full_name: name } },
      });
      btn.disabled = false;
      btn.textContent = "Crear cuenta";
      if (error) {
        const msg = error.message.toLowerCase();
        setError(
          msg.includes("already registered") || msg.includes("user already")
            ? "Ya existe una cuenta con ese email. Inicia sesión."
            : msg.includes("password")
              ? "La contraseña debe tener al menos 6 caracteres."
              : msg.includes("invalid email")
                ? "El formato del email no es válido."
                : "Error al crear la cuenta. Intenta de nuevo.",
        );
        return;
      }
      // Si Supabase tiene confirmación de email ACTIVA, signUp no devuelve sesión.
      if (data.session) {
        await handleSuccess();
      } else {
        setError("Cuenta creada. Revisa tu correo para confirmar y luego califica.", true);
      }
    };

    // ─── Google ──────────────────────────────────────────────────────────────
    btnGoogle.onclick = async () => {
      setError("");
      // El consumidor persiste su intención ANTES de redirigir para reanudar al volver.
      opts.onBeforeGoogle?.();
      btnGoogle.disabled = true;
      const { error } = await supabase.auth.signInWithOAuth({
        provider: "google",
        options: { redirectTo: `${window.location.origin}/auth/callback` },
      });
      if (error) {
        btnGoogle.disabled = false;
        setError("No se pudo conectar con Google. Intenta de nuevo.");
      }
    };

    // ─── API global ──────────────────────────────────────────────────────────
    function open(o: AuthModalOpts = {}) {
      opts = o;
      titleEl.textContent = o.title ?? "Inicia sesión para calificar";
      setError("");
      formLogin.reset();
      formRegister.reset();
      btnGoogle.disabled = false;
      showTab("login");
      overlay.classList.add("is-open");
    }

    (window as any).authModal = { open, close };
  });
</script>
