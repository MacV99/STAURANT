---
// Marco común de /terminos y /privacidad. Páginas públicas (sin login): las
// enlazan Google (pantalla de consentimiento OAuth), Meta y el registro.
// Sin navbar: un visitante anónimo no tiene a dónde ir dentro de la app.
import Layout1 from "../layouts/Layout1.astro";

interface Props {
  title: string;
  updated: string;
}

const { title, updated } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
---

<Layout1 title={`${title} · STAURANT`} bare>
  <div class="legal-page flex-column">
    <header class="legal-head flex-column">
      <a href="/" class="legal-logo" aria-label="Ir al inicio de STAURANT">
        <img src="/img/logo2.png" alt="STAURANT" width="1800" height="542" />
      </a>
      <h1>{title}</h1>
      <p class="legal-updated">Última actualización: {updated}</p>
    </header>

    <article class="legal-body flex-column">
      <slot />
    </article>

    <footer class="legal-foot flex-row">
      <a href="/terminos" aria-current={path === "/terminos" ? "page" : undefined}>
        Términos y condiciones
      </a>
      <span aria-hidden="true">·</span>
      <a href="/privacidad" aria-current={path === "/privacidad" ? "page" : undefined}>
        Política de privacidad
      </a>
      <span aria-hidden="true">·</span>
      <a href="/">Volver a STAURANT</a>
    </footer>
  </div>
</Layout1>

<style>
  .legal-page {
    width: 100%;
    max-width: 720px;
    padding: 32px 16px 64px;
    align-items: stretch;
    gap: 28px;
  }

  .legal-head {
    align-items: flex-start;
    gap: 10px;
  }

  .legal-logo img {
    height: 40px;
    width: auto;
    border-radius: var(--radius-sm);
  }

  .legal-head h1 {
    margin-top: 12px;
    color: var(--clr-text);
    font-size: 1.6rem;
    letter-spacing: 1px;
    text-indent: 0;
  }

  .legal-updated {
    color: var(--clr-text-soft);
    font-size: 0.85rem;
  }

  .legal-body {
    background: var(--clr-white);
    border: solid 1px var(--clr-border);
    border-radius: 20px;
    padding: 28px 20px;
    align-items: stretch;
    gap: 14px;
  }

  /* El contenido llega por <slot>: lleva el cid de la página, no el de este
     componente, así que se estiliza con :global dentro de .legal-body. */
  .legal-body :global(h2) {
    margin-top: 14px;
    color: var(--clr-text);
    font-size: 1.05rem;
    letter-spacing: 0.5px;
    text-indent: 0;
  }

  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }

  .legal-body :global(p),
  .legal-body :global(li) {
    color: var(--clr-text);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .legal-body :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 20px;
  }

  .legal-body :global(li) {
    list-style: disc;
  }

  .legal-body :global(a) {
    color: var(--clr-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-foot {
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 10px;
    color: var(--clr-text-soft);
    font-size: 0.85rem;
  }

  .legal-foot a {
    color: var(--clr-text-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-foot a[aria-current="page"] {
    color: var(--clr-text);
    font-weight: 600;
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .legal-page {
      padding-top: 48px;
    }

    .legal-body {
      padding: 36px 40px;
    }

    .legal-head h1 {
      font-size: 2rem;
    }
  }
</style>
