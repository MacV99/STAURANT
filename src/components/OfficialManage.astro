---
/**
 * Gestión del perfil oficial por su DUEÑO (fila en official_owners).
 * Contiene tres modales + su lógica, colocados juntos porque solo el dueño los usa:
 *   1. Editor de carta   → crear / editar un plato oficial (con precio, sin drum).
 *   2. Panel de stats    → agregados del RPC get_official_owner_stats (solo números).
 *   3. Editor de perfil  → nombre / ciudad / dirección / notas del restaurante.
 *
 * La seguridad real vive en RLS (Postgres). Este componente solo se monta y expone
 * su API cuando /oficial detecta propiedad; las escrituras fallan igual si no lo eres.
 *
 * API global (refrescada en cada page-load):
 *   window.officialManage = { openDishCreate, openDishEdit, openStats, openProfileEdit }
 * Eventos emitidos (los escucha /oficial para re-renderizar):
 *   official:carta-changed   { officialRestaurantId }
 *   official:profile-changed { official }
 */
import FormModal from "./FormModal.astro";
---

{/* ── 1. Editor de plato oficial ─────────────────────────────────────────── */}
<FormModal id="odf" title="Nuevo plato" maxWidth="420px">
  <input type="hidden" id="odf-id" />
  <input type="hidden" id="odf-restaurant-id" />

  <label for="odf-name">
    <span class="label-text flex-row"
      >Nombre del plato <span class="required">*</span></span
    >
    <input
      type="text"
      id="odf-name"
      required
      placeholder="Bandeja paisa, Sushi roll..."
    />
  </label>

  {/* Producto genérico (Coca-Cola, agua…): no lleva foto ni calificación. Solo
      se muestra nombre + precio en el modal. Compacto: label + ícono ⓘ cuyo
      contexto aparece al pasar el mouse / mantener presionado. */}
  <div class="odf-generic-row flex-row">
    <label class="odf-generic flex-row" for="odf-generic">
      <input type="checkbox" id="odf-generic" />
      <span class="odf-generic-title">Producto genérico</span>
    </label>
    <button
      type="button"
      class="odf-generic-info"
      aria-label="Qué es un producto genérico"
    >
      <i class="bi bi-info-circle"></i>
      <span class="odf-generic-tip" role="tooltip"
        >Bebidas y similares (Coca-Cola, agua…): sin foto ni calificación, solo
        nombre y precio.</span
      >
    </button>
  </div>

  <div class="cc-field flex-column" id="odf-type-field">
    <span class="label-text flex-row"
      >Tipo / categoría <span class="optional">(opcional)</span></span
    >
    <div class="cc-combobox" id="odf-type-combobox">
      <div class="cc-input-wrap flex-row">
        <input
          type="text"
          id="odf-type"
          class="cc-input"
          placeholder="ENTRADA, POSTRE, BEBIDA..."
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="characters"
          data-lpignore="true"
          data-1p-ignore
          spellcheck="false"
        />
        <button
          type="button"
          id="odf-type-clear"
          class="cc-clear"
          hidden
          aria-label="Quitar tipo"
        >
          <i class="bi bi-x-lg"></i>
        </button>
        <span class="cc-chevron" aria-hidden="true"
          ><i class="bi bi-chevron-down"></i></span
        >
      </div>
      <div id="odf-type-dropdown" class="cc-dropdown" hidden></div>
    </div>
  </div>

  <label for="odf-price">
    <span class="label-text flex-row"
      >Precio <span class="optional">(opcional)</span></span
    >
    <div class="price-wrap flex-row">
      <span class="price-prefix">$</span>
      <input
        type="text"
        id="odf-price"
        inputmode="numeric"
        placeholder="18.000"
      />
    </div>
  </label>

  <label for="odf-notes" id="odf-notes-field">
    <span class="label-text flex-row">Descripción</span>
    <textarea
      id="odf-notes"
      rows="2"
      placeholder="Ingredientes, acompañamientos, lo que quieras destacar..."
    ></textarea>
  </label>

  <div class="odf-image-field" id="odf-image-field">
    <span class="label-text flex-row"
      >Imagen <span class="optional">(opcional)</span></span
    >
    <p class="odf-image-hint">
      Usa una foto <strong>horizontal</strong> con el plato <strong>centrado</strong>.
    </p>
    <input type="hidden" id="odf-image-url" />
    {/* NO usar `hidden`/display:none: Safari e iOS no abren el selector nativo al
        disparar .click() sobre un file input con display:none. Se oculta con la
        técnica visually-hidden (fuera de pantalla pero "renderizado"). */}
    <input
      type="file"
      id="odf-image-file"
      accept="image/*"
      class="odf-visually-hidden"
    />
    {/* Dos estados en elementos SEPARADOS (nunca se solapan):
        · sin imagen → botón "Agregar foto".
        · con imagen → figure con la foto + acciones de texto Cambiar/Quitar. */}
    <button type="button" id="odf-image-add" class="odf-image-add">
      <i class="bi bi-camera"></i> <span>Agregar foto</span>
    </button>

    {/* Con imagen: foto a ancho completo + dos botones reales debajo. */}
    <div class="odf-image-view" id="odf-image-view" hidden>
      <figure class="odf-image-figure">
        <img id="odf-image-preview" alt="" />
        <div class="odf-image-loading" id="odf-image-loading" hidden>
          <span class="spinner"></span>
        </div>
      </figure>
      <div class="odf-image-actions">
        <button type="button" id="odf-image-change" class="odf-image-act">
          <i class="bi bi-arrow-repeat"></i> Cambiar
        </button>
        <button type="button" id="odf-image-remove" class="odf-image-act is-remove">
          <i class="bi bi-trash"></i> Quitar
        </button>
      </div>
    </div>
  </div>
</FormModal>

{/* ── 3. Editor del perfil ───────────────────────────────────────────────── */}
<FormModal id="opf" title="Editar restaurante" maxWidth="620px">
  <input type="hidden" id="opf-id" />

  {/* Rejilla: 1 columna en móvil, 2 en desktop (ver .form-grid en project.css). */}
  <div class="form-grid">
    <label for="opf-name" class="form-col-full">
      <span class="label-text flex-row"
        >Nombre <span class="required">*</span></span
      >
      <input type="text" id="opf-name" required placeholder="Nombre del restaurante" />
    </label>

    <div class="cc-field flex-column">
      <span class="label-text flex-row"
        >Ciudades <span class="optional">(opcional)</span></span
      >
      <div class="cc-combobox" id="opf-city-combobox">
        <div class="cc-input-wrap flex-row">
          <input
            type="text"
            id="opf-city"
            class="cc-input"
            placeholder="Agrega una o varias ciudades..."
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="characters"
            data-lpignore="true"
            data-1p-ignore
            spellcheck="false"
          />
          <span class="cc-chevron" aria-hidden="true"
            ><i class="bi bi-chevron-down"></i></span
          >
        </div>
        <div id="opf-city-dropdown" class="cc-dropdown" hidden></div>
      </div>
      <div id="opf-city-chips" class="cc-chips flex-row" hidden></div>
    </div>

    <label for="opf-phone">
      <span class="label-text flex-row"
        >Teléfono <span class="optional">(para pedidos)</span></span
      >
      <input
        type="tel"
        id="opf-phone"
        inputmode="tel"
        placeholder="+57 300 000 0000"
      />
    </label>

    <label for="opf-address" class="form-col-full">
      <span class="label-text flex-row"
        >Dirección <span class="optional">(opcional)</span></span
      >
      <input type="text" id="opf-address" placeholder="Cra 00 # 00-00" />
    </label>

    <fieldset class="opf-socials form-col-full">
      <span class="label-text flex-row"
        >Redes sociales <span class="optional">(solo enlace)</span></span
      >
      <div class="opf-social-rows">
        <div class="opf-social-row flex-row">
          <i class="bi bi-instagram" aria-hidden="true"></i>
          <input
            type="url"
            inputmode="url"
            id="opf-instagram"
            placeholder="https://instagram.com/..."
            autocomplete="off"
            spellcheck="false"
            aria-label="Instagram"
          />
        </div>
        <div class="opf-social-row flex-row">
          <i class="bi bi-facebook" aria-hidden="true"></i>
          <input
            type="url"
            inputmode="url"
            id="opf-facebook"
            placeholder="https://facebook.com/..."
            autocomplete="off"
            spellcheck="false"
            aria-label="Facebook"
          />
        </div>
        <div class="opf-social-row flex-row">
          <i class="bi bi-tiktok" aria-hidden="true"></i>
          <input
            type="url"
            inputmode="url"
            id="opf-tiktok"
            placeholder="https://tiktok.com/@..."
            autocomplete="off"
            spellcheck="false"
            aria-label="TikTok"
          />
        </div>
      </div>
    </fieldset>

    <label for="opf-notes" class="form-col-full">
      <span class="label-text flex-row">Descripción</span>
      <textarea id="opf-notes" rows="2" placeholder="Sobre el restaurante..."></textarea>
    </label>
  </div>

  {/* Zona de peligro: eliminar el perfil oficial (dueño o superadmin). */}
  <div class="opf-danger flex-column">
    <span class="opf-danger-title flex-row"><i class="bi bi-exclamation-triangle"></i> Zona de peligro</span>
    <p class="opf-danger-desc">Eliminar el restaurante borra su carta, calificaciones y dueños. No se puede deshacer.</p>
    <button type="button" id="opf-delete" class="opf-delete-btn flex-row">
      <i class="bi bi-trash3"></i> Eliminar restaurante
    </button>
  </div>
</FormModal>

<style>
  /* Base de form/label/footer/overlay viven en project.css. Aquí solo lo propio. */
  #odf-name,
  #odf-price,
  #odf-notes,
  #opf-name,
  #opf-address,
  #opf-notes {
    font-size: 0.9rem;
  }

  /* ── Producto genérico (checkbox compacto + ícono ⓘ con tooltip) ── */
  .odf-generic-row {
    justify-content: flex-start;
    align-items: center;
    gap: 6px;
    margin: -2px 0;
  }

  .odf-generic {
    justify-content: flex-start;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .odf-generic input[type="checkbox"] {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    accent-color: var(--clr-primary);
    cursor: pointer;
  }

  .odf-generic-title {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.2px;
    color: var(--clr-text);
  }

  /* Ícono ⓘ: el contexto vive en el tooltip (hover / foco / mantener presionado),
     no ocupa espacio en el formulario. */
  .odf-generic-info {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    border: none;
    background: none;
    color: var(--clr-text);
    opacity: 0.4;
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
    transition: opacity var(--transition);
    -webkit-tap-highlight-color: transparent;
  }

  .odf-generic-tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    width: max-content;
    max-width: 240px;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    background: var(--clr-text);
    color: var(--clr-white);
    font-size: 0.74rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.1px;
    text-align: left;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--transition),
      transform var(--transition);
    z-index: 10;
  }

  /* Flecha del tooltip. */
  .odf-generic-tip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--clr-text);
  }

  /* Aparece al pasar el mouse, enfocar (tab) o mantener presionado (:active). */
  .odf-generic-info:hover,
  .odf-generic-info:focus-visible {
    opacity: 0.9;
  }

  .odf-generic-info:hover .odf-generic-tip,
  .odf-generic-info:focus .odf-generic-tip,
  .odf-generic-info:active .odf-generic-tip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* Al marcar genérico se oculta la imagen. `.odf-image-field` fija display:flex
     → hace falta forzar el ocultado sobre el [hidden] del user-agent. */
  #odf-image-field[hidden] {
    display: none;
  }

  /* ── Zona de peligro (eliminar restaurante) ── */
  .opf-danger {
    margin-top: 20px;
    padding: 16px;
    gap: 8px;
    align-items: stretch;
    background: var(--clr-danger-bg);
    border: 1px solid var(--clr-danger-border-soft);
    border-radius: var(--radius-md);
  }

  .opf-danger-title {
    justify-content: flex-start;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--clr-danger);
  }

  .opf-danger-desc {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--clr-text);
    opacity: 0.7;
  }

  .opf-delete-btn {
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
    padding: 10px 16px;
    background: transparent;
    border: 1.5px solid var(--clr-danger-border-soft);
    color: var(--clr-danger);
    border-radius: var(--radius-md);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: var(--transition);
  }

  @media (hover: hover) {
    .opf-delete-btn:hover {
      background: var(--clr-danger-bg-strong);
      border-color: var(--clr-danger);
    }
  }

  /* ── Combobox creable (tipo / ciudad) — mismo look que DishForm/RestaurantForm ── */

  /* gap:0 → la única separación label/input es el `margin-bottom:5px` de
     `.label-text`, igual que en los campos <label> (Teléfono/Dirección). Así las
     dos columnas de la rejilla alinean sus inputs a la misma altura. */
  .cc-field {
    align-items: stretch;
    gap: 0;
  }

  .cc-combobox {
    position: relative;
  }

  .cc-input-wrap {
    align-items: center;
    border: 1.5px solid var(--clr-border);
    border-radius: var(--border-radius);
    background: var(--clr-white);
    overflow: hidden;
    transition: border-color var(--transition);
  }

  .cc-input-wrap:focus-within {
    border-color: var(--clr-border2);
  }

  .cc-input {
    flex: 1;
    border: none !important;
    background: transparent !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 10px 12px;
    font-size: 0.9rem;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--clr-text);
    min-width: 0;
  }

  .cc-input::placeholder {
    text-transform: none;
    color: var(--clr-text);
    opacity: 0.5;
  }

  .cc-clear {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 6px;
    color: var(--clr-text);
    opacity: 0.5;
    font-size: 0.75rem;
    flex-shrink: 0;
    transition: opacity var(--transition);
  }

  .cc-chevron {
    padding: 0 10px 0 4px;
    color: var(--clr-text);
    opacity: 0.4;
    font-size: 0.75rem;
    flex-shrink: 0;
    pointer-events: none;
    transition: transform 0.15s ease;
  }

  .cc-combobox.is-open .cc-chevron {
    transform: rotate(180deg);
  }

  .cc-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: var(--clr-white);
    border: 1.5px solid var(--clr-border);
    border-radius: var(--border-radius);
    z-index: 200;
    max-height: 220px;
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
  }

  @media (hover: hover) {
    .cc-clear:hover {
      opacity: 1;
    }
  }

  /* Redes: fieldset sin marco nativo (etiqueta arriba + filas ícono+input). */
  .opf-socials {
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Filas apiladas (una debajo de otra) en todos los tamaños: cada enlace ocupa
     el ancho completo, más cómodo para pegar URLs largas. */
  .opf-social-rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .opf-social-row {
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .opf-social-row i {
    font-size: 1.1rem;
    color: var(--clr-primary);
    width: 20px;
    text-align: center;
    flex-shrink: 0;
  }

  .opf-social-row input {
    flex: 1;
    min-width: 0;
    font-size: 0.9rem;
  }

  /* Precio con prefijo $ dentro del mismo marco del input. */
  .price-wrap {
    align-items: stretch;
    border: 1.5px solid var(--clr-border);
    border-radius: var(--border-radius);
    background: var(--clr-white);
    overflow: hidden;
    transition: border-color var(--transition);
  }

  .price-wrap:focus-within {
    border-color: var(--clr-border2);
  }

  .price-prefix {
    display: flex;
    align-items: center;
    padding: 0 4px 0 12px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--clr-text);
    opacity: 0.55;
  }

  .price-wrap #odf-price {
    flex: 1;
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding-left: 2px;
    min-width: 0;
  }

  /* File input oculto pero "renderizado" (visually-hidden). Necesario para que
     .click() abra el selector en Safari/iOS, donde display:none lo bloquea. */
  .odf-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Campo de imagen. Dos estados en elementos SEPARADOS (nunca se solapan),
     ambos a ANCHO COMPLETO del modal:
     · #odf-image-add  → botón "Agregar foto" (sin imagen).
     · #odf-image-view → foto + botones Cambiar/Quitar (con imagen). */
  .odf-image-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: stretch;
  }

  /* Guía de encuadre bajo el label: qué foto subir para que no se recorte feo. */
  .odf-image-hint {
    margin: -9px 0 0;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--clr-text);
    opacity: 0.7;
  }
  .odf-image-hint strong {
    font-weight: 700;
    opacity: 1;
  }

  /* Botón "Agregar foto": ancho completo, dashed, contenido centrado. */
  .odf-image-add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 14px;
    border: 1.5px dashed var(--clr-border2);
    border-radius: var(--border-radius);
    background: var(--clr-white2);
    color: var(--clr-primary);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.2px;
    cursor: pointer;
    transition: var(--transition);
  }

  .odf-image-add[hidden] {
    display: none;
  }

  .odf-image-add i {
    font-size: 1.1rem;
  }

  @media (hover: hover) {
    .odf-image-add:hover {
      background: var(--clr-border);
    }
  }

  /* Contenedor del estado "con imagen". */
  .odf-image-view {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .odf-image-view[hidden] {
    display: none;
  }

  /* Foto a ancho completo del modal. */
  .odf-image-figure {
    position: relative;
    width: 100%;
    margin: 0;
    border: 1px solid var(--clr-border);
    border-radius: var(--border-radius);
    overflow: hidden;
    background: var(--clr-white);
  }

  #odf-image-preview {
    display: block;
    width: 100%;
    max-height: 240px;
    object-fit: cover;
  }

  /* Cambiar / Quitar: dos botones reales, mitad y mitad. */
  .odf-image-actions {
    display: flex;
    gap: 8px;
  }

  .odf-image-act {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 8px;
    border: 1.5px solid var(--clr-border);
    border-radius: var(--border-radius);
    background: var(--clr-white);
    color: var(--clr-text);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.2px;
    cursor: pointer;
    transition: var(--transition);
  }

  .odf-image-act i {
    font-size: 0.9rem;
    opacity: 0.8;
  }

  /* Superficie danger suave: tinte rojo tenue en reposo (no corte blanco/rojo). */
  .odf-image-act.is-remove {
    background: var(--clr-danger-bg);
    color: var(--clr-danger);
    border-color: var(--clr-danger-border-soft);
  }

  .odf-image-act.is-remove i {
    opacity: 1;
  }

  @media (hover: hover) {
    .odf-image-act:hover {
      background: var(--clr-white2);
    }

    .odf-image-act.is-remove:hover {
      background: var(--clr-danger-bg-strong);
    }
  }

  /* Spinner: SOLO durante la subida activa, superpuesto a la foto. */
  .odf-image-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    z-index: 2;
  }

  .odf-image-loading[hidden] {
    display: none;
  }

  .odf-image-loading .spinner {
    width: 26px;
    height: 26px;
    border: 3px solid rgba(255, 255, 255, 0.4);
    border-top-color: var(--clr-white);
    border-radius: 50%;
    animation: odf-spin 0.7s linear infinite;
  }

  @keyframes odf-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<style is:global>
  /* Opciones del combobox creable — creadas via JS → scope global. */

  #odf-type-dropdown .cc-option,
  #opf-city-dropdown .cc-option {
    padding: 11px 14px;
    font-size: 0.88rem;
    color: var(--clr-text);
    cursor: pointer;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    border-bottom: 1px solid var(--clr-border);
    transition: background 0.1s ease;
  }

  #odf-type-dropdown .cc-option:last-child,
  #opf-city-dropdown .cc-option:last-child {
    border-bottom: none;
  }

  @media (hover: hover) {
    #odf-type-dropdown .cc-option:hover,
    #opf-city-dropdown .cc-option:hover {
      background: var(--clr-white2);
    }
  }

  #odf-type-dropdown .cc-option.is-selected,
  #opf-city-dropdown .cc-option.is-selected {
    color: var(--clr-primary);
    font-weight: 700;
  }

  #odf-type-dropdown .cc-option.is-create,
  #opf-city-dropdown .cc-option.is-create {
    color: var(--clr-primary);
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    justify-content: flex-start;
    gap: 6px;
    border-top: 1px solid var(--clr-border);
  }

  #odf-type-dropdown .cc-option.is-create i,
  #opf-city-dropdown .cc-option.is-create i {
    font-size: 0.7rem;
    flex-shrink: 0;
  }

  #odf-type-dropdown .cc-option.is-create .cc-create-name,
  #opf-city-dropdown .cc-option.is-create .cc-create-name {
    font-weight: 700;
    text-transform: uppercase;
  }

  #odf-type-dropdown .cc-option.is-empty,
  #opf-city-dropdown .cc-option.is-empty {
    color: var(--clr-text);
    opacity: 0.55;
    font-size: 0.82rem;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    cursor: default;
    text-align: center;
    padding: 14px;
  }

  /* Chips de ciudades agregadas (multi) — creadas via JS → scope global. */

  #opf-city-chips {
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    margin-top: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  #opf-city-chips::-webkit-scrollbar {
    display: none;
  }

  #opf-city-chips[hidden] {
    display: none;
  }

  #opf-city-chips .cc-chip-pin {
    color: var(--clr-primary);
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  #opf-city-chips .cc-chip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 4px 4px 4px 10px;
    border-radius: 50px;
    border: 1.5px solid var(--clr-border);
    background: var(--clr-white2);
    color: var(--clr-text);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  #opf-city-chips .cc-chip-x {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--clr-text);
    opacity: 0.5;
    font-size: 0.58rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: opacity 0.12s ease;
  }

  @media (hover: hover) {
    #opf-city-chips .cc-chip-x:hover {
      opacity: 1;
      color: var(--clr-danger);
    }
  }
</style>

<script>
  import type { OfficialDish, OfficialRestaurant } from "../lib/data.ts";
  import { navigate } from "astro:transitions/client";
  import {
    createOfficialDish,
    updateOfficialDish,
    updateOfficialRestaurant,
    deleteOfficial,
    uploadOfficialDishImage,
    deleteOfficialDishImage,
    getOfficialCities,
    getCities,
  } from "../lib/data.ts";
  import {
    emit,
    forceUppercase,
    createOverlay,
    wireCreatableCombobox,
    wireCreatableMultiCombobox,
    formatThousands,
    attachThousandsFormat,
  } from "../scripts/store.ts";

  document.addEventListener("astro:page-load", () => {
    // Guard: el componente solo existe en /oficial. Sin el overlay del editor de
    // carta, no estamos en esa página → no cablear nada.
    const dishApi = createOverlay("odf-overlay");
    if (!dishApi) return;
    // Destructurado tras el guard: las funciones internas (closures) conservan la
    // referencia no-nula sin que TS pierda el narrowing dentro de sus cuerpos.
    const { open: openDishModal, close: closeDishModal } = dishApi;

    // ── 1. Editor de carta ──────────────────────────────────────────────────
    const dishForm = document.getElementById("odf") as HTMLFormElement;
    const dishTitle = document.getElementById("odf-title")!;
    const dIdEl = document.getElementById("odf-id") as HTMLInputElement;
    const dRestEl = document.getElementById("odf-restaurant-id") as HTMLInputElement;
    const dNameEl = document.getElementById("odf-name") as HTMLInputElement;
    const dTypeEl = document.getElementById("odf-type") as HTMLInputElement;
    const dPriceEl = document.getElementById("odf-price") as HTMLInputElement;
    const dNotesEl = document.getElementById("odf-notes") as HTMLTextAreaElement;
    const dGenericEl = document.getElementById("odf-generic") as HTMLInputElement;
    const dImageFieldEl = document.getElementById("odf-image-field") as HTMLElement;
    const dErrEl = document.getElementById("odf-error")!;

    /** Genérico (Coca-Cola, agua…): sin foto ni calificación. Solo se oculta la
     *  imagen; la categoría se conserva (agrupa la carta: BEBIDA, etc.) y la
     *  descripción sigue disponible. En el modal público solo se ve nombre+precio. */
    function applyGenericUI(generic: boolean) {
      dImageFieldEl.hidden = generic;
    }
    dGenericEl.onchange = () => applyGenericUI(dGenericEl.checked);

    // Combobox creable de tipo/categoría. Las opciones = tipos ya usados en la
    // carta (se pasan como `suggestions` al abrir); `typeOptions` se lee en vivo.
    let typeOptions: string[] = [];
    const typeCombo = wireCreatableCombobox({
      combobox: document.getElementById("odf-type-combobox") as HTMLElement,
      input: dTypeEl,
      dropdown: document.getElementById("odf-type-dropdown") as HTMLElement,
      clearBtn: document.getElementById("odf-type-clear") as HTMLButtonElement,
      getOptions: () => typeOptions,
      createVerb: "Crear",
      emptyText: "Escribe para crear una categoría",
    });

    // Precio con separador de miles en tiempo real (el valor real se recupera
    // quitando los puntos en el submit).
    attachThousandsFormat(dPriceEl);

    // ── Campo de imagen ───────────────────────────────────────────────────────
    const dImgUrlEl = document.getElementById("odf-image-url") as HTMLInputElement;
    const dImgFileEl = document.getElementById("odf-image-file") as HTMLInputElement;
    const dImgAddEl = document.getElementById("odf-image-add") as HTMLButtonElement;
    const dImgViewEl = document.getElementById("odf-image-view")!;
    const dImgPreviewEl = document.getElementById("odf-image-preview") as HTMLImageElement;
    const dImgChangeEl = document.getElementById("odf-image-change")!;
    const dImgRemoveEl = document.getElementById("odf-image-remove")!;
    const dImgLoadingEl = document.getElementById("odf-image-loading")!;

    /** Pinta el estado del campo imagen según la URL actual. Sin foto → botón
     *  "Agregar foto"; con foto → figure con la foto + acciones Cambiar/Quitar.
     *  Los dos estados son elementos separados: nunca se solapan. */
    function renderImageField(url: string | null) {
      if (url) {
        dImgPreviewEl.onerror = () => renderImageField(null);
        dImgPreviewEl.src = url;
        dImgViewEl.hidden = false;
        dImgAddEl.hidden = true;
      } else {
        dImgPreviewEl.onerror = null;
        dImgPreviewEl.removeAttribute("src");
        dImgViewEl.hidden = true;
        dImgAddEl.hidden = false;
      }
      dImgLoadingEl.hidden = true;
    }

    // "Agregar" y "Cambiar" abren el selector de archivos.
    dImgAddEl.onclick = () => dImgFileEl.click();
    dImgChangeEl.onclick = () => dImgFileEl.click();

    dImgRemoveEl.onclick = (e) => {
      e.stopPropagation();
      // Quita la imagen recién subida del storage (huérfana) si no es la original.
      const cur = dImgUrlEl.value || null;
      if (cur && cur !== originalImageUrl) deleteOfficialDishImage(cur);
      dImgUrlEl.value = "";
      dImgFileEl.value = "";
      renderImageField(null);
    };

    dImgFileEl.onchange = async () => {
      const file = dImgFileEl.files?.[0];
      if (!file) return;
      dErrEl.textContent = "";
      const prev = dImgUrlEl.value || null;
      // Preview instantáneo con la foto local: se ve de inmediato, sin caja gris
      // de "cargando". El spinner solo se superpone mientras sube al servidor.
      const localUrl = URL.createObjectURL(file);
      dImgPreviewEl.onerror = null;
      dImgPreviewEl.src = localUrl;
      dImgViewEl.hidden = false;
      dImgAddEl.hidden = true;
      dImgLoadingEl.hidden = false;
      const res = await uploadOfficialDishImage(dRestEl.value, file);
      dImgLoadingEl.hidden = true;
      dImgFileEl.value = "";
      URL.revokeObjectURL(localUrl);
      if ("error" in res) {
        // Mensaje honesto según el motivo real (antes todo decía "≤ 5 MB").
        const MSG: Record<typeof res.error, string> = {
          type: "Ese archivo no es una imagen.",
          size: "La imagen supera los 5 MB.",
          permission: "No tienes permiso para editar la carta de este perfil.",
          upload: "No se pudo subir la imagen. Revisa tu conexión e intenta de nuevo.",
        };
        dErrEl.textContent = MSG[res.error];
        renderImageField(prev); // revierte al estado anterior (foto previa o vacío)
        return;
      }
      const url = res.url;
      // Reemplazo: borra la anterior si era una subida nueva (no la original).
      if (prev && prev !== originalImageUrl) deleteOfficialDishImage(prev);
      dImgUrlEl.value = url;
      renderImageField(url);
    };

    dNameEl.oninput = () => forceUppercase(dNameEl);
    document.getElementById("odf-close")!.onclick = closeDishModal;
    document.getElementById("odf-cancel")!.onclick = closeDishModal;

    /** Sugerencias de tipo (los type_name ya usados en la carta) → alimentan el
     *  combobox creable para evitar categorías duplicadas por typos. */
    function fillTypeSuggestions(suggestions: string[]) {
      typeOptions = [...new Set(suggestions)].sort((a, b) => a.localeCompare(b, "es"));
    }

    // URL de la imagen YA persistida en el plato (null al crear). Sirve para no
    // borrar del storage la foto original si el usuario sube otra y luego cancela.
    let originalImageUrl: string | null = null;

    function openDishCreate(officialRestaurantId: string, suggestions: string[] = []) {
      dishForm.reset();
      dErrEl.textContent = "";
      dishTitle.textContent = "Nuevo plato";
      dIdEl.value = "";
      dRestEl.value = officialRestaurantId;
      originalImageUrl = null;
      dImgUrlEl.value = "";
      renderImageField(null);
      dGenericEl.checked = false;
      applyGenericUI(false);
      fillTypeSuggestions(suggestions);
      typeCombo.setValue("");
      openDishModal();
      dNameEl.focus();
    }

    function openDishEdit(od: OfficialDish, suggestions: string[] = []) {
      dishForm.reset();
      dErrEl.textContent = "";
      dishTitle.textContent = "Editar plato";
      dIdEl.value = od.id;
      dRestEl.value = od.officialRestaurantId;
      dNameEl.value = od.name;
      dPriceEl.value = od.price !== null ? formatThousands(String(od.price)) : "";
      dNotesEl.value = od.notes ?? "";
      originalImageUrl = od.imageUrl ?? null;
      dImgUrlEl.value = originalImageUrl ?? "";
      renderImageField(originalImageUrl);
      dGenericEl.checked = od.isGeneric;
      applyGenericUI(od.isGeneric);
      fillTypeSuggestions(suggestions);
      typeCombo.setValue(od.typeName ?? "");
      openDishModal();
    }

    dishForm.onsubmit = async (e) => {
      e.preventDefault();
      dErrEl.textContent = "";
      const name = dNameEl.value.trim();
      if (!name) {
        dErrEl.textContent = "El nombre del plato es obligatorio.";
        dNameEl.focus();
        return;
      }
      // El input muestra el precio con puntos de miles; el valor real son los dígitos.
      const priceDigits = dPriceEl.value.replace(/\D/g, "");
      const price = priceDigits === "" ? null : Number(priceDigits);
      if (price !== null && Number.isNaN(price)) {
        dErrEl.textContent = "El precio debe ser un número válido.";
        dPriceEl.focus();
        return;
      }
      const isGeneric = dGenericEl.checked;
      // Genérico: sin foto. Conserva categoría y descripción. Si había una foto
      // recién subida (huérfana en storage), se descarta para no dejar basura.
      if (isGeneric) discardOrphanImage();
      const typeName = typeCombo.getValue() || null;
      const notes = dNotesEl.value.trim() || null;
      const imageUrl = isGeneric ? null : (dImgUrlEl.value || null);
      const officialRestaurantId = dRestEl.value;
      const id = dIdEl.value;

      const saved = id
        ? await updateOfficialDish(id, { name, typeName, price, notes, imageUrl, isGeneric })
        : await createOfficialDish({ officialRestaurantId, name, typeName, price, notes, imageUrl, isGeneric });

      if (!saved) {
        dErrEl.textContent = "No se pudo guardar. ¿Sigues siendo dueño de este perfil?";
        return;
      }
      // Al editar: si se reemplazó/quitó la foto original y ya se guardó, borra la
      // vieja del storage para no dejar huérfanos.
      if (originalImageUrl && originalImageUrl !== imageUrl) {
        deleteOfficialDishImage(originalImageUrl);
      }
      originalImageUrl = imageUrl;
      closeDishModal();
      emit("official:carta-changed", { officialRestaurantId });
    };

    // Cancelar/cerrar sin guardar: si se subió una foto nueva (distinta de la
    // original), es huérfana en el storage → bórrala.
    function discardOrphanImage() {
      const cur = dImgUrlEl.value || null;
      if (cur && cur !== originalImageUrl) deleteOfficialDishImage(cur);
    }
    const closeDishAndDiscard = () => {
      discardOrphanImage();
      closeDishModal();
    };
    document.getElementById("odf-close")!.onclick = closeDishAndDiscard;
    document.getElementById("odf-cancel")!.onclick = closeDishAndDiscard;

    // ── 3. Editor de perfil ─────────────────────────────────────────────────
    const profForm = document.getElementById("opf") as HTMLFormElement;
    const pIdEl = document.getElementById("opf-id") as HTMLInputElement;
    const pNameEl = document.getElementById("opf-name") as HTMLInputElement;
    const pCityEl = document.getElementById("opf-city") as HTMLInputElement;
    const pAddrEl = document.getElementById("opf-address") as HTMLInputElement;
    const pPhoneEl = document.getElementById("opf-phone") as HTMLInputElement;
    const pIgEl = document.getElementById("opf-instagram") as HTMLInputElement;
    const pFbEl = document.getElementById("opf-facebook") as HTMLInputElement;
    const pTtEl = document.getElementById("opf-tiktok") as HTMLInputElement;
    const pNotesEl = document.getElementById("opf-notes") as HTMLTextAreaElement;
    const pErrEl = document.getElementById("opf-error")!;
    const profApi = createOverlay("opf-overlay")!;

    // Combobox creable MULTI de ciudades (chips). Opciones = mis ciudades
    // personales + las de cualquier oficial, en MAYÚSCULAS (llegan async).
    let cityOptions: string[] = [];
    const cityCombo = wireCreatableMultiCombobox({
      combobox: document.getElementById("opf-city-combobox") as HTMLElement,
      input: pCityEl,
      dropdown: document.getElementById("opf-city-dropdown") as HTMLElement,
      chips: document.getElementById("opf-city-chips") as HTMLElement,
      getOptions: () => cityOptions,
      createVerb: "Agregar",
    });

    /** Ciudades existentes → opciones del combobox creable (deduplicadas en MAYÚS). */
    function fillCitySuggestions(cities: string[]) {
      cityOptions = [...new Set(cities.map((c) => c.trim().toUpperCase()))].sort(
        (a, b) => a.localeCompare(b, "es"),
      );
    }

    document.getElementById("opf-close")!.onclick = profApi.close;
    document.getElementById("opf-cancel")!.onclick = profApi.close;

    // Eliminar restaurante (dueño o superadmin; RLS lo verifica). Doble paso:
    // confirmación explícita antes de un borrado irreversible con cascada.
    document.getElementById("opf-delete")!.onclick = () => {
      const id = pIdEl.value;
      const name = pNameEl.value.trim() || "este restaurante";
      (window as any).confirmDialog?.show(
        `¿Eliminar «${name}»? Se borrará su carta, calificaciones y dueños. No se puede deshacer.`,
        async () => {
          const ok = await deleteOfficial(id);
          if (ok) {
            profApi.close();
            navigate("/");
          } else {
            (window as any).noticeDialog?.show("No se pudo eliminar el restaurante.");
          }
        },
      );
    };

    function openProfileEdit(official: OfficialRestaurant) {
      profForm.reset();
      pErrEl.textContent = "";
      pIdEl.value = official.id;
      pNameEl.value = official.name;
      cityCombo.setValues(official.cities);
      pAddrEl.value = official.address ?? "";
      pPhoneEl.value = official.phone ?? "";
      pIgEl.value = official.instagram ?? "";
      pFbEl.value = official.facebook ?? "";
      pTtEl.value = official.tiktok ?? "";
      pNotesEl.value = official.notes ?? "";
      profApi.open();
      // Opciones = mis ciudades personales (cache, inmediatas) + las de TODOS los
      // oficiales (async). Así aparecen ciudades como NEIVA/RIVERA que solo usé en
      // restaurantes personales, además de las ya usadas por otros dueños.
      const personal = getCities();
      fillCitySuggestions(personal);
      getOfficialCities().then((official) =>
        fillCitySuggestions([...personal, ...official]),
      );
    }

    profForm.onsubmit = async (e) => {
      e.preventDefault();
      pErrEl.textContent = "";
      const name = pNameEl.value.trim();
      if (!name) {
        pErrEl.textContent = "El nombre es obligatorio.";
        pNameEl.focus();
        return;
      }
      // Incluye lo que quedó escrito sin confirmar como un chip más.
      cityCombo.flush();
      const saved = await updateOfficialRestaurant(pIdEl.value, {
        name,
        cities: cityCombo.getValues(),
        address: pAddrEl.value.trim() || null,
        phone: pPhoneEl.value.trim() || null,
        instagram: pIgEl.value.trim() || null,
        facebook: pFbEl.value.trim() || null,
        tiktok: pTtEl.value.trim() || null,
        notes: pNotesEl.value.trim() || null,
      });
      if (!saved) {
        pErrEl.textContent = "No se pudo guardar. ¿Sigues siendo dueño de este perfil?";
        return;
      }
      profApi.close();
      emit("official:profile-changed", { official: saved });
    };

    // Las estadísticas viven en la página /panel?id=… (no en modal).

    // API global (refrescada con referencias frescas al DOM actual).
    (window as any).officialManage = {
      openDishCreate,
      openDishEdit,
      openProfileEdit,
    };
  });
</script>
