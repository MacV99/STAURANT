---
import type { Dish } from "../lib/data";
import RatingBadge from "./RatingBadge.astro";

interface Props {
  dish: Dish;
  typeName?: string | null;
}

const { dish: d, typeName } = Astro.props;
---

<article class="dish-card flex-row" data-id={d.id}>
  <img class="dish-thumb" alt={d.name} hidden />
  <RatingBadge score={d.rating} />
  <div class="dish-info">
    <h4>{d.name}</h4>
    {typeName && <span class="dish-type-tag">{typeName}</span>}
    {d.notes && <p class="dish-notes">{d.notes}</p>}
  </div>
  <div class="dish-actions flex-row">
    <div class="dish-menu">
      <button class="btn-menu boton2" data-id={d.id} aria-label="Opciones del plato">
        <i class="bi bi-three-dots-vertical"></i>
      </button>
      <div class="menu-popup">
        <button class="menu-item btn-edit-dish" data-id={d.id}>
          <i class="bi bi-pencil-fill"></i>
          <span>Editar</span>
        </button>
        <button class="menu-item btn-delete-dish" data-id={d.id}>
          <i class="bi bi-trash-fill"></i>
          <span>Eliminar</span>
        </button>
      </div>
    </div>
  </div>
</article>

<style>
  .dish-card {
    background: var(--clr-white);
    border: 1px solid var(--clr-border);
    border-radius: 14px;
    padding: 14px 16px;
    justify-content: space-between;
    gap: 12px;
    transition: var(--transition);
  }

  /* Miniatura del plato (solo carta oficial). Se revela en runtime al setear src;
     oculta por defecto para no afectar las cartas personales que reusan esta card. */
  .dish-thumb {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 10px;
    background: var(--clr-white2);
  }

  .dish-info {
    flex: 1;
    min-width: 0;
  }

  .dish-info h4 {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.1px;
    line-height: 1.2;
    color: var(--clr-text);
  }

  .dish-type-tag {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--clr-primary);
    background-color: var(--clr-white2);
    border-radius: var(--radius-lg);
    padding: 2px 6px;
    margin-top: 3px;
  }

  .dish-info .dish-notes {
    font-size: 0.8rem;
    color: var(--clr-text);
    margin-top: 3px;
    line-height: 1.4;
    opacity: 0.75;
  }

  .dish-actions {
    gap: 6px;
    flex-shrink: 0;
  }

  /* Card clickeable (calificar): toda la tarjeta invita a tocar. Se activa en
     runtime con .is-rateable, tanto en /restaurante como en /oficial. */
  .dish-card.is-rateable {
    cursor: pointer;
  }

  @media (hover: hover) {
    .dish-card.is-rateable:hover {
      border-color: var(--clr-border2);
    }
  }
</style>
