---
import type { Dish } from "../lib/data";
import RatingBadge from "./RatingBadge.astro";

interface Props {
  dish: Dish;
}

const { dish: d } = Astro.props;
---

<article class="dish-card flex-row" data-id={d.id}>
  <img class="dish-thumb" alt={d.name} hidden />
  <RatingBadge score={d.rating} />
  <div class="dish-info">
    <h4>{d.name}</h4>
  </div>
  <div class="dish-actions flex-row">
    <div class="dish-menu">
      <button class="btn-menu boton2" data-id={d.id} aria-label="Opciones del plato">
        <i class="bi bi-three-dots-vertical"></i>
      </button>
      <div class="menu-popup">
        <button class="menu-item btn-edit-dish" data-id={d.id}>
          <i class="bi bi-pencil-fill"></i>
          <span>Editar</span>
        </button>
        <button class="menu-item btn-recommend-dish" data-id={d.id}>
          <i class="bi bi-send"></i>
          <span>Recomendar</span>
        </button>
        <button class="menu-item btn-delete-dish" data-id={d.id}>
          <i class="bi bi-trash-fill"></i>
          <span>Eliminar</span>
        </button>
      </div>
    </div>
  </div>
</article>

<style>
  .dish-card {
    background: var(--clr-white);
    border: 1px solid var(--clr-border);
    border-radius: 14px;
    padding: 14px 16px;
    justify-content: space-between;
    gap: 12px;
    transition: var(--transition);
  }

  /* Miniatura del plato (solo carta oficial). Se revela en runtime al setear src;
     oculta por defecto para no afectar las cartas personales que reusan esta card. */
  .dish-thumb {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 10px;
    background: var(--clr-white2);
  }

  .dish-info {
    flex: 1;
    min-width: 0;
  }

  .dish-info h4 {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.1px;
    /* Anula el text-indent global de headings (compensa el letter-spacing:2px
       global) que solo indenta el 1er renglón → desalinea títulos de 2 líneas. */
    text-indent: 0;
    line-height: 1.2;
    color: var(--clr-text);
  }

  .dish-actions {
    gap: 6px;
    flex-shrink: 0;
  }

  /* Card clickeable (calificar): toda la tarjeta invita a tocar. Se activa en
     runtime con .is-rateable, tanto en /restaurante como en /oficial. */
  .dish-card.is-rateable {
    cursor: pointer;
  }

  @media (hover: hover) {
    .dish-card.is-rateable:hover {
      border-color: var(--clr-border2);
    }
  }
</style>
