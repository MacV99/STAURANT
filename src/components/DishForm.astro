---
import FormModal from "./FormModal.astro";
---

<FormModal id="dish-form" title="Nuevo plato" maxWidth="420px">
  <button
    slot="header-actions"
    type="button"
    id="df-recommend"
    class="btn-icon-close boton2"
    aria-label="Recomendar a un amigo"
    title="Recomendar a un amigo"
    hidden
  >
    <i class="bi bi-send"></i>
  </button>
  <input type="hidden" id="df-id" />
  <input type="hidden" id="df-restaurant-id" />
  <input type="hidden" id="df-type-id" />
  <input type="hidden" id="df-rating" value="5" />

  <div class="official-hero flex-column" id="df-official-fields" hidden>
    {/* Foto del plato (solo si tiene). El frame reserva el espacio con alto fijo
       desde el inicio (skeleton) para evitar el salto visual mientras la imagen
       carga; la <img> aparece con fade dentro. Sin imagen → frame hidden: cero hueco. */}
    <div class="official-photo-frame" id="df-official-image-frame" hidden>
      <img class="official-photo" id="df-official-image" alt="" />
    </div>
    <h3 class="official-name" id="df-official-name"></h3>
    <span class="official-type" id="df-official-type"></span>
    <span class="official-price" id="df-official-price" hidden></span>
    {/* Descripción del plato (la escribe el dueño en la gestión). Oculta si vacía. */}
    <p class="official-desc" id="df-official-desc" hidden></p>
  </div>

  <div class="type-field flex-column" id="df-type-field">
    <span class="label-text flex-row"
      >Tipo de plato <span class="optional">(opcional)</span></span
    >
    <div class="type-combobox" id="df-type-combobox">
      <div class="type-input-wrap flex-row">
        <input
          type="text"
          id="df-type-search"
          class="type-search-input"
          placeholder="Selecciona una etiqueta"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          id="df-type-clear"
          class="type-clear-btn"
          hidden
          aria-label="Quitar tipo"
        >
          <i class="bi bi-x-lg"></i>
        </button>
        <span class="type-chevron" aria-hidden="true"
          ><i class="bi bi-chevron-down"></i></span
        >
      </div>
      <div id="df-type-dropdown" class="type-dropdown" hidden></div>
    </div>
  </div>

  <label for="df-name" id="df-name-field">
    <span class="label-text flex-row"
      >Nombre del plato <span class="required">*</span></span
    >
    <input
      type="text"
      id="df-name"
      required
      placeholder="Bandeja paisa, Sushi roll..."
    />
  </label>

  <div class="rating-field flex-column">
    <div class="rating-label-row flex-row">
      <span class="rating-label"
        >Calificación <span class="optional">(opcional)</span></span
      >
      <button
        type="button"
        id="df-rating-clear"
        class="rating-clear-link"
        hidden
      >
        Quitar
      </button>
    </div>
    <div class="drum-outer is-unrated" id="df-drum-outer">
      <div class="drum-picker" id="df-rating-drum">
        <div class="drum-track" id="df-drum-track"></div>
      </div>
      <div class="drum-hint">
        <i class="bi bi-star"></i>
        <span>Toca para calificar</span>
      </div>
    </div>
  </div>

  <label for="df-notes" id="df-notes-field">
    <span class="label-text flex-row">Notas</span>
    <textarea
      id="df-notes"
      rows="2"
      placeholder="Sabor, presentación, lo que quieras recordar..."></textarea>
  </label>
</FormModal>

<style>
  /* Estilos base de form/label/footer viven en project.css (.form-box …).
     Aquí solo lo específico de este formulario (rating, drum, combobox tipo). */

  #df-recommend[hidden] {
    display: none;
  }

  /* Igualar el tamaño de fuente del nombre/notas al del input de tipo (0.9rem). */
  #df-name,
  #df-notes {
    font-size: 0.9rem;
  }

  /* Plato oficial: el nombre y el tipo los administra el restaurante, así que
     se presentan como una cabecera editorial (título + subtítulo), no como
     inputs. Solo notas y calificación quedan editables. */
  .official-hero {
    align-items: flex-start;
    gap: 6px;
    padding: 2px 0 14px;
    border-bottom: 1px solid var(--clr-border);
  }

  .official-hero[hidden] {
    display: none;
  }

  /* Frame de la foto: reserva el espacio (alto fijo) desde que se abre el modal,
     así el layout no salta mientras la imagen carga. Mientras carga se ve como
     skeleton (fondo + shimmer). Oculto (sin hueco) si el plato no tiene foto. */
  .official-photo-frame {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    border-radius: var(--border-radius);
    margin-bottom: 4px;
    background: var(--clr-white2);
  }

  .official-photo-frame[hidden] {
    display: none;
  }

  /* Shimmer sutil mientras la imagen aún no ha cargado. */
  .official-photo-frame.is-loading::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 25%,
      rgba(0, 0, 0, 0.045) 50%,
      transparent 75%
    );
    background-size: 220% 100%;
    animation: photo-shimmer 1.15s ease-in-out infinite;
  }

  @keyframes photo-shimmer {
    from {
      background-position: 220% 0;
    }
    to {
      background-position: -220% 0;
    }
  }

  /* La imagen ocupa todo el frame y aparece con fade sobre el skeleton. */
  .official-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .official-photo.loaded {
    opacity: 1;
  }

  .official-name {
    margin: 2px 0 0;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.6px;
    text-indent: 0; /* anula el text-indent global (desalinea títulos de 2 líneas) */
    text-transform: uppercase;
    color: var(--clr-text);
  }

  .official-type {
    margin-top: 2px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.2px;
    color: var(--clr-text);
    opacity: 0.6;
  }

  .official-type[hidden] {
    display: none;
  }

  .official-price {
    margin-top: 6px;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.3px;
    color: var(--clr-text);
  }

  .official-price[hidden] {
    display: none;
  }

  .official-desc {
    margin: 10px 0 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--clr-text);
    opacity: 0.72;
    white-space: pre-line; /* respeta saltos de línea que escriba el dueño */
  }

  .official-desc[hidden] {
    display: none;
  }

  /* `.flex-column` fija display:flex y gana al [hidden] del user-agent →
     forzar el ocultado de los campos editables en platos oficiales. */
  #df-type-field[hidden],
  #df-name-field[hidden] {
    display: none;
  }

  /* `.rating-field` es flex-column → forzar ocultado en productos genéricos. */
  .rating-field[hidden] {
    display: none;
  }

  .rating-field {
    align-items: stretch;
    gap: 8px;
  }

  .rating-label-row {
    justify-content: space-between;
    align-items: center;
  }

  .rating-label {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--clr-text);
    text-transform: uppercase;
  }

  .rating-clear-link {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.75rem;
    color: var(--clr-text);
    opacity: 0.45;
    padding: 0;
    transition: opacity var(--transition);
  }

  @media (hover: hover) {
    .rating-clear-link:hover {
      opacity: 1;
      color: var(--clr-danger);
    }
  }

  /* ── Drum picker ─────────────────────────────────────────────────────────── */

  .drum-outer {
    position: relative;
    display: flex;
    align-items: stretch;
    border-radius: 16px;
    background: var(--clr-white2);
    border: 1.5px dashed var(--clr-border2);
    transition:
      border-color var(--transition),
      background var(--transition);
    height: 72px;
    overflow: hidden;
    cursor: pointer;
  }

  .drum-outer:not(.is-unrated) {
    border-style: solid;
    background: var(--clr-white);
    cursor: default;
  }

  .drum-hint {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--clr-primary);
    pointer-events: none;
    transition: opacity 0.2s ease;
    animation: drum-hint-pulse 2s ease-in-out infinite;
  }

  .drum-hint i {
    font-size: 1.15rem;
  }

  .drum-outer:not(.is-unrated) .drum-hint {
    opacity: 0;
    animation: none;
  }

  @keyframes drum-hint-pulse {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 0.95;
    }
  }

  .drum-picker {
    flex: 1;
    min-width: 0;
    /* Sin scroll nativo: el arrastre, la inercia y el snap viven en JS (pointer
       events + translateX del track). El scroll de iOS Safari rebotaba antes de
       llegar al 10. pan-y deja al navegador solo el scroll vertical del modal. */
    overflow: hidden;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 22%,
      black 78%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 22%,
      black 78%,
      transparent
    );
    pointer-events: none;
  }

  .drum-outer:not(.is-unrated) .drum-picker {
    pointer-events: auto;
    cursor: grab;
  }

  /* Sin calificación: ocultar items para que solo se vea el hint */
  .drum-outer.is-unrated .drum-picker {
    opacity: 0;
  }

  .drum-outer:not(.is-unrated) .drum-picker:active {
    cursor: grabbing;
  }

  .drum-track {
    display: flex;
    align-items: center;
    height: 100%;
    /* Ancho real de los items; JS lo desplaza con translateX para centrar el valor. */
    width: max-content;
    will-change: transform;
  }

  /* ── Combobox de tipo — elementos estáticos ───────────────────────────── */

  .type-field {
    align-items: stretch;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--clr-text);
    text-transform: uppercase;
  }

  .type-combobox {
    position: relative;
  }

  .type-input-wrap {
    border: 1.5px solid var(--clr-border);
    border-radius: var(--border-radius);
    background: var(--clr-white);
    overflow: hidden;
    transition: border-color 0.12s ease;
  }

  .type-input-wrap:focus-within {
    border-color: var(--clr-border2);
  }

  .type-search-input {
    flex: 1;
    border: none !important;
    background: transparent !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 10px 12px;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--clr-text);
    min-width: 0;
  }

  .type-search-input::placeholder {
    text-transform: none;
    color: var(--clr-text);
    opacity: 0.5;
    font-weight: 400;
  }

  .type-clear-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 6px;
    color: var(--clr-text);
    opacity: 0.5;
    font-size: 0.75rem;
    flex-shrink: 0;
    transition: opacity 0.12s ease;
  }

  .type-chevron {
    padding: 0 10px 0 4px;
    color: var(--clr-text);
    opacity: 0.4;
    font-size: 0.75rem;
    flex-shrink: 0;
    pointer-events: none;
    transition: transform 0.15s ease;
  }

  .type-combobox.is-open .type-chevron {
    transform: rotate(180deg);
  }

  .type-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: var(--clr-white);
    border: 1.5px solid var(--clr-border);
    border-radius: var(--border-radius);
    z-index: 200;
    max-height: 220px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  @media (hover: hover) {
    .type-clear-btn:hover {
      opacity: 1;
    }
  }
</style>

<style is:global>
  /* ── Drum items (created via JS → need global scope) ──────────────────── */

  #df-rating-drum .drum-item {
    width: 52px;
    flex-shrink: 0;
    text-align: center;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -1.5px;
    color: var(--clr-text);
    line-height: 1;
    user-select: none;
    transform-origin: center;
    transition:
      transform 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.26s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Durante el scroll los visuales (tamaño/opacidad) se calculan en JS cuadro a
     cuadro según la posición exacta. Una transición corta y con arranque rápido
     (ease-out) hace que el número "clave" al centro de forma más cortante y se
     disuelva suave al alejarse, sin reintroducir el salto. No usar 0s aquí. */
  #df-rating-drum.is-scrolling .drum-item {
    transition:
      transform 0.06s ease-out,
      opacity 0.06s ease-out;
  }

  /* Decimal part of drum items (e.g. ".5") — smaller than the integer */
  #df-rating-drum .drum-item .drum-dec {
    font-size: 0.6em;
    letter-spacing: -1px;
    font-weight: 800;
  }

  /* El tamaño del número central lo maneja el `scale` continuo en JS
     (SCALE_CURVE) para que crezca de forma gradual, sin brinco de font-size.
     Se mantiene la clase por si se quiere enfatizar el color/estado activo. */

  /* ── Type dropdown ─────────────────────────────────────────────────────── */

  #df-type-dropdown .type-option {
    padding: 12px 16px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--clr-text);
    cursor: pointer;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    transition: background 0.1s ease;
    border-bottom: 1px solid var(--clr-border);
  }

  #df-type-dropdown .type-option:last-child {
    border-bottom: none;
  }

  @media (hover: hover) {
    #df-type-dropdown .type-option:hover,
    #df-type-dropdown .type-option:focus {
      background: var(--clr-white2);
    }

    #df-type-dropdown .type-option.is-create:hover {
      background: var(--clr-white2);
    }
  }

  #df-type-dropdown .type-option.is-selected {
    color: var(--clr-primary);
    font-weight: 700;
  }

  #df-type-dropdown .type-option.is-none {
    color: var(--clr-text);
    opacity: 0.55;
    font-size: 0.82rem;
    text-transform: none;
    letter-spacing: 0;
    border-bottom: 1px solid var(--clr-border);
  }

  #df-type-dropdown .type-option.is-create {
    color: var(--clr-primary);
    font-weight: 600;
    border-top: 1px solid var(--clr-border);
    text-transform: none;
    letter-spacing: 0;
    justify-content: flex-start;
    gap: 6px;
  }

  #df-type-dropdown .type-option.is-create i {
    font-size: 0.7rem;
    flex-shrink: 0;
  }

  #df-type-dropdown .type-option.is-create .create-name {
    font-weight: 700;
    text-transform: uppercase;
  }

  #df-type-dropdown .type-option.is-empty {
    color: var(--clr-text);
    opacity: 0.5;
    font-size: 0.82rem;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    cursor: default;
    text-align: center;
    padding: 14px;
  }
</style>

<script>
  import type { Dish, OfficialDish } from "../lib/data.ts";
  import {
    createDish,
    updateDish,
    getDishesByRestaurant,
    getDishTypes,
    createDishType,
    rateOfficialDish,
  } from "../lib/data.ts";
  import { emit, forceUppercase, createOverlay } from "../scripts/store.ts";

  // Re-inicializar en cada navegación para que open/close siempre
  // operen sobre los elementos del DOM ACTUAL (no los del swap anterior).
  document.addEventListener("astro:page-load", () => {
    const overlayApi = createOverlay("dish-form-overlay", {
      onClose: () => closeDropdown(),
    });
    if (!overlayApi) return; // no está en esta página
    const { overlay, close } = overlayApi;

    const form = document.getElementById("dish-form") as HTMLFormElement;
    const titleEl = document.getElementById("dish-form-title")!;
    const idInput = document.getElementById("df-id") as HTMLInputElement;
    const restaurantIdInput = document.getElementById(
      "df-restaurant-id",
    ) as HTMLInputElement;
    const typeIdInput = document.getElementById(
      "df-type-id",
    ) as HTMLInputElement;
    const nameInput = document.getElementById("df-name") as HTMLInputElement;
    const ratingInput = document.getElementById(
      "df-rating",
    ) as HTMLInputElement;
    const notesInput = document.getElementById(
      "df-notes",
    ) as HTMLTextAreaElement;
    const errorEl = document.getElementById("dish-form-error")!;
    const closeBtn = document.getElementById("dish-form-close")!;
    const cancelBtn = document.getElementById("dish-form-cancel")!;
    const submitBtn = document.getElementById(
      "dish-form-submit",
    ) as HTMLButtonElement;
    const ratingClearBtn = document.getElementById(
      "df-rating-clear",
    ) as HTMLButtonElement;
    const ratingFieldEl = document.querySelector(
      "#dish-form .rating-field",
    ) as HTMLElement;
    const drumOuterEl = document.getElementById("df-drum-outer") as HTMLElement;
    const drumEl = document.getElementById("df-rating-drum") as HTMLElement;
    const drumTrackEl = document.getElementById("df-drum-track") as HTMLElement;
    const drumHintTextEl = drumOuterEl.querySelector(
      ".drum-hint span",
    ) as HTMLElement;
    const officialFieldsEl = document.getElementById(
      "df-official-fields",
    ) as HTMLElement;
    const officialTypeEl = document.getElementById(
      "df-official-type",
    ) as HTMLElement;
    const officialNameEl = document.getElementById(
      "df-official-name",
    ) as HTMLElement;
    const officialPriceEl = document.getElementById(
      "df-official-price",
    ) as HTMLElement;
    const officialImageEl = document.getElementById(
      "df-official-image",
    ) as HTMLImageElement;
    const officialImageFrameEl = document.getElementById(
      "df-official-image-frame",
    ) as HTMLElement;
    const officialDescEl = document.getElementById(
      "df-official-desc",
    ) as HTMLElement;
    const typeFieldEl = document.getElementById("df-type-field") as HTMLElement;
    const recommendBtn = document.getElementById("df-recommend") as HTMLButtonElement;
    const nameFieldEl = document.getElementById("df-name-field") as HTMLElement;

    // Platos oficiales: nombre/tipo/notas los administra el sistema, solo se permite
    // calificar. Ocultamos esos campos y mostramos el aviso correspondiente.
    let isOfficial = false;
    // Cuando se califica un plato oficial desde la carta compartida (/oficial) NO
    // existe un Dish personal: la nota se guarda en official_ratings. Este id marca
    // ese modo; el submit escribe vía rateOfficialDish en vez de updateDish.
    let officialRatingDishId: string | null = null;
    // Vista SOLO-LECTURA de un plato oficial para un visitante anónimo: ve la
    // foto y los detalles, pero cualquier intento de calificar (tocar la rueda o
    // enviar) dispara este callback (login). null = sesión activa, sí puede calificar.
    let officialViewAuth: (() => void) | null = null;
    // Producto genérico (Coca-Cola, agua…): el modal es SOLO informativo (nombre +
    // precio). Sin foto, sin tipo, sin rueda de calificación. Enviar = cerrar.
    let isGenericView = false;

    let isRated = false;

    function setRated(rated: boolean, value?: number) {
      isRated = rated;
      ratingClearBtn.hidden = !rated;
      drumOuterEl.classList.toggle("is-unrated", !rated);
      if (rated) {
        const v = value ?? parseFloat(ratingInput.value);
        ratingInput.value = String(v);
      }
    }

    ratingClearBtn.onclick = (e) => {
      e.stopPropagation();
      setRated(false);
    };
    drumOuterEl.onclick = () => {
      if (!isRated) setRated(true);
    };

    // ─── Combobox de tipo ──────────────────────────────────────────────────────

    const comboboxEl = document.getElementById("df-type-combobox")!;
    const searchInput = document.getElementById(
      "df-type-search",
    ) as HTMLInputElement;
    const clearBtn = document.getElementById(
      "df-type-clear",
    ) as HTMLButtonElement;
    const dropdownEl = document.getElementById(
      "df-type-dropdown",
    ) as HTMLElement;

    let selectedTypeId: string | null = null;

    function openDropdown() {
      if (isOfficial) return; // plato oficial: tipo bloqueado, no abrir desplegable
      renderDropdown(searchInput.value);
      dropdownEl.hidden = false;
      comboboxEl.classList.add("is-open");
    }

    function closeDropdown() {
      dropdownEl.hidden = true;
      comboboxEl.classList.remove("is-open");
      // Restaurar el nombre del tipo seleccionado si el input quedó con texto parcial
      if (selectedTypeId) {
        const t = getDishTypes().find((t) => t.id === selectedTypeId);
        searchInput.value = t?.name ?? "";
      } else {
        searchInput.value = "";
      }
    }

    function selectType(id: string | null, name: string | null) {
      selectedTypeId = id;
      typeIdInput.value = id ?? "";
      searchInput.value = name ?? "";
      clearBtn.hidden = !id;
      closeDropdown();
    }

    function renderDropdown(query: string) {
      const types = getDishTypes();
      const q = query.trim().toUpperCase();
      const filtered = q ? types.filter((t) => t.name.includes(q)) : types;
      const exactMatch = types.some((t) => t.name === q);

      dropdownEl.innerHTML = "";

      // Opción "ninguno" para deseleccionar (solo cuando hay algo seleccionado)
      if (selectedTypeId) {
        const noneOpt = document.createElement("div");
        noneOpt.className = "type-option is-none";
        noneOpt.textContent = "— Sin tipo";
        noneOpt.addEventListener("mousedown", (e) => e.preventDefault());
        noneOpt.addEventListener("click", () => selectType(null, null));
        dropdownEl.appendChild(noneOpt);
      }

      // Opciones existentes
      filtered.forEach((t) => {
        const opt = document.createElement("div");
        opt.className =
          "type-option" + (t.id === selectedTypeId ? " is-selected" : "");
        opt.textContent = t.name;
        opt.addEventListener("mousedown", (e) => e.preventDefault());
        opt.addEventListener("click", () => selectType(t.id, t.name));
        dropdownEl.appendChild(opt);
      });

      // Opción para crear (solo si el texto no coincide exactamente)
      if (q && !exactMatch) {
        const createOpt = document.createElement("div");
        createOpt.className = "type-option is-create flex-row";
        createOpt.innerHTML = `<i class="bi bi-plus-lg"></i> Crear "<span class="create-name"></span>"`;
        createOpt.querySelector(".create-name")!.textContent = q;
        createOpt.addEventListener("mousedown", (e) => e.preventDefault());
        createOpt.addEventListener("click", () => {
          // Verificar que no exista ya (race condition)
          const existing = getDishTypes().find((t) => t.name === q);
          if (existing) {
            selectType(existing.id, existing.name);
          } else {
            const newType = createDishType(q);
            selectType(newType.id, newType.name);
          }
        });
        dropdownEl.appendChild(createOpt);
      }

      // Estado vacío
      if (dropdownEl.childElementCount === 0) {
        const emptyOpt = document.createElement("div");
        emptyOpt.className = "type-option is-empty";
        emptyOpt.textContent = "Escribe para crear tu primera etiqueta";
        dropdownEl.appendChild(emptyOpt);
      }
    }

    // Input: filtra mientras escribe
    searchInput.addEventListener("input", () => {
      forceUppercase(searchInput);
      // Limpiar selección actual si el usuario está escribiendo algo nuevo
      selectedTypeId = null;
      typeIdInput.value = "";
      clearBtn.hidden = true;
      if (dropdownEl.hidden) openDropdown();
      else renderDropdown(searchInput.value);
    });

    // Abrir al hacer focus / click
    searchInput.addEventListener("focus", () => {
      if (dropdownEl.hidden) openDropdown();
    });
    searchInput.addEventListener("click", () => {
      if (dropdownEl.hidden) openDropdown();
    });

    // Cerrar al perder foco (con delay para permitir el click en opciones)
    searchInput.addEventListener("blur", () => {
      setTimeout(() => {
        if (!comboboxEl.contains(document.activeElement)) {
          closeDropdown();
        }
      }, 150);
    });

    // Botón X para limpiar la selección (mousedown evita blur del input)
    clearBtn.addEventListener("mousedown", (e) => e.preventDefault());
    clearBtn.addEventListener("click", () => {
      selectType(null, null);
      searchInput.focus();
    });

    // Inicializa el combobox con un tipo pre-seleccionado (o sin selección)
    function initTypeCombobox(selectedId: string | null) {
      selectedTypeId = selectedId;
      typeIdInput.value = selectedId ?? "";
      dropdownEl.hidden = true;
      comboboxEl.classList.remove("is-open");
      if (selectedId) {
        const t = getDishTypes().find((t) => t.id === selectedId);
        searchInput.value = t?.name ?? "";
        clearBtn.hidden = false;
      } else {
        searchInput.value = "";
        clearBtn.hidden = true;
      }
    }

    // ─── Apertura / cierre del modal ──────────────────────────────────────────

    function open(mode: "create" | "edit", restaurantId: string, data?: Dish) {
      errorEl.textContent = "";
      form.reset();
      restaurantIdInput.value = restaurantId;
      officialRatingDishId = null;
      officialViewAuth = null;
      isGenericView = false;
      ratingFieldEl.hidden = false;
      submitBtn.textContent = "Guardar";
      drumHintTextEl.textContent = "Toca para calificar";

      isOfficial = mode === "edit" && !!data?.officialDishId;
      // Plato oficial: nombre y tipo los administra el restaurante → se muestran
      // como texto plano (no inputs). Solo notas y calificación son editables.
      // Ocultamos los campos editables de nombre/tipo y mostramos el bloque display.
      officialFieldsEl.hidden = !isOfficial;
      typeFieldEl.hidden = isOfficial;
      nameFieldEl.hidden = isOfficial;
      (document.getElementById("df-notes-field") as HTMLElement).hidden = false;

      if (mode === "edit" && data) {
        titleEl.textContent = isOfficial ? "Calificar plato" : "Editar plato";
        idInput.value = data.id;
        nameInput.value = data.name;
        notesInput.value = data.notes;
        if (data.rating !== null) {
          setRated(true, data.rating);
        } else {
          ratingInput.value = "5";
          setRated(false);
        }
        initTypeCombobox(data.typeId ?? null);

        // Rellenar el bloque de solo lectura para platos oficiales.
        if (isOfficial) {
          const typeName =
            getDishTypes().find((t) => t.id === data.typeId)?.name ?? "";
          officialNameEl.textContent = data.name;
          officialTypeEl.textContent = typeName;
          officialTypeEl.hidden = !typeName;
        }
      } else {
        titleEl.textContent = "Nuevo plato";
        idInput.value = "";
        ratingInput.value = "5";
        setRated(false);
        initTypeCombobox(null);
      }

      // Recomendar a un amigo: solo platos que ya existen (editar).
      if (mode === "edit" && data) {
        const restaurantName =
          document.querySelector("#restaurant-header h1")?.textContent?.trim() ?? null;
        setRecommend({ type: "dish", id: data.id, title: data.name, subtitle: restaurantName });
      } else {
        setRecommend(null);
      }

      overlay.classList.add("is-open");
      requestAnimationFrame(() =>
        initDrumForValue(parseFloat(ratingInput.value)),
      );
    }

    /** Muestra el botón "Recomendar" de la cabecera para `target` (null = oculto). */
    function setRecommend(
      target: { type: string; id: string; title: string; subtitle?: string | null } | null,
    ) {
      recommendBtn.hidden = !target;
      recommendBtn.onclick = target
        ? () => (window as any).recommend?.open(target)
        : null;
    }

    /** Califica un plato OFICIAL desde la carta compartida (/oficial). No hay Dish
     *  personal: solo se muestra la cabecera del plato + la rueda de calificación.
     *  El submit guarda en official_ratings vía rateOfficialDish. */
    function openOfficial(
      od: OfficialDish,
      currentRating: number | null,
      opts?: { onRequireAuth?: () => void },
    ) {
      errorEl.textContent = "";
      form.reset();
      isOfficial = true;
      // Genérico (Coca-Cola, agua…): modal solo-informativo. Sin rueda, sin foto,
      // sin tipo; nada que guardar. Enviar = cerrar.
      isGenericView = od.isGeneric;
      officialRatingDishId = isGenericView ? null : od.id;
      // Anónimo: modo lectura. Ve foto/detalles; calificar dispara login.
      officialViewAuth = isGenericView ? null : (opts?.onRequireAuth ?? null);
      const viewOnly = !!officialViewAuth;

      // Solo cabecera + rueda: ocultar campos editables (nombre/tipo/notas).
      officialFieldsEl.hidden = false;
      typeFieldEl.hidden = true;
      nameFieldEl.hidden = true;
      (document.getElementById("df-notes-field") as HTMLElement).hidden = true;
      // Genérico: sin calificación → ocultar la rueda por completo.
      ratingFieldEl.hidden = isGenericView;

      titleEl.textContent = "Detalle del plato";
      if (!isGenericView)
        titleEl.textContent = viewOnly ? "Detalle del plato" : "Calificar plato";
      submitBtn.textContent = isGenericView
        ? "Cerrar"
        : viewOnly
          ? "Iniciar sesión para calificar"
          : "Guardar";
      drumHintTextEl.textContent = viewOnly
        ? "Inicia sesión para calificar"
        : "Toca para calificar";
      // Foto del plato: se muestra SOLO aquí (no en la card). Genérico → sin foto.
      // El frame reserva el alto desde ya (skeleton) para que no haya salto; la
      // imagen entra con fade al terminar de cargar. URL rota → se oculta el frame.
      if (od.imageUrl && !isGenericView) {
        officialImageEl.classList.remove("loaded");
        officialImageFrameEl.classList.add("is-loading");
        officialImageFrameEl.hidden = false;
        const markLoaded = () => {
          officialImageEl.classList.add("loaded");
          officialImageFrameEl.classList.remove("is-loading");
        };
        officialImageEl.onload = markLoaded;
        officialImageEl.onerror = () => {
          officialImageFrameEl.hidden = true;
          officialImageFrameEl.classList.remove("is-loading");
        };
        officialImageEl.src = od.imageUrl;
        // Imagen en caché (o misma URL que la apertura previa): onload puede no
        // dispararse; si ya está completa, la marcamos cargada de inmediato.
        if (officialImageEl.complete && officialImageEl.naturalWidth > 0) {
          markLoaded();
        }
      } else {
        officialImageEl.onload = null;
        officialImageEl.onerror = null;
        officialImageEl.classList.remove("loaded");
        officialImageFrameEl.classList.remove("is-loading");
        officialImageEl.removeAttribute("src");
        officialImageFrameEl.hidden = true;
      }
      officialNameEl.textContent = od.name;
      officialTypeEl.textContent = od.typeName ? `Categoría: ${od.typeName}` : "";
      officialTypeEl.hidden = isGenericView || !od.typeName;

      // Precio: se muestra SOLO aquí (no en la card). Sin precio → oculto.
      if (od.price !== null) {
        officialPriceEl.textContent = `$${od.price.toLocaleString("es-CO")}`;
        officialPriceEl.hidden = false;
      } else {
        officialPriceEl.hidden = true;
      }

      // Descripción del plato: la escribe el dueño. Genérico o vacía → oculta.
      const desc = od.notes?.trim();
      if (desc && !isGenericView) {
        officialDescEl.textContent = desc;
        officialDescEl.hidden = false;
      } else {
        officialDescEl.hidden = true;
      }

      if (currentRating !== null) {
        setRated(true, currentRating);
        ratingInput.value = String(currentRating);
      } else {
        ratingInput.value = "5";
        setRated(false);
      }

      // Recomendar: con sesión y si no es un genérico (Coca-Cola…).
      setRecommend(
        !isGenericView && !viewOnly
          ? {
              type: "official_dish",
              id: od.id,
              title: od.name,
              subtitle:
                document.querySelector("#oficial-header h1")?.textContent?.trim() ?? null,
            }
          : null,
      );

      overlay.classList.add("is-open");
      requestAnimationFrame(() =>
        initDrumForValue(parseFloat(ratingInput.value)),
      );
    }

    // close() y el cierre por click-fuera los provee createOverlay (arriba);
    // onClose ejecuta closeDropdown(). .onclick evita acumular listeners.
    closeBtn.onclick = close;
    cancelBtn.onclick = close;

    // Visitante anónimo viendo un plato oficial: tocar la rueda pide login en vez
    // de dejar calificar. Captura en fase de captura para adelantarse al arrastre.
    drumEl.addEventListener(
      "pointerdown",
      (e) => {
        if (officialViewAuth) {
          e.preventDefault();
          e.stopPropagation();
          const cb = officialViewAuth;
          close();
          cb();
        }
      },
      true,
    );

    // ─── Drum picker ──────────────────────────────────────────────────────────
    // Rueda 100% controlada en JS, sin scroll nativo: la posición es un índice
    // fraccionario `pos` y el track se mueve con translateX. El scroll nativo de
    // iOS Safari (rebote + inercia) peleaba con el snap y no dejaba llegar a los
    // extremos (el 10 costaba mucho). Con pointer events el arrastre, la inercia y
    // el tope en 1 y 10 se comportan igual en iOS, Android y escritorio.

    const ITEM_W = 52;
    const MIN_V = 1.0;
    const MAX_V = 10.0;
    const STEP = 0.5;
    const NUM_ITEMS = Math.round((MAX_V - MIN_V) / STEP) + 1; // 1.0 → 10.0 at 0.5 steps
    const MAX_IDX = NUM_ITEMS - 1;
    // Valor del item idx, redondeado al step para evitar errores de punto flotante.
    const valueForIdx = (idx: number) =>
      Math.round((MIN_V + idx * STEP) * 10) / 10;
    const clampIdx = (idx: number) => Math.max(0, Math.min(MAX_IDX, idx));

    const drumItems: HTMLElement[] = [];
    let prevDrumV = -1;
    // Ventana de items actualmente pintados; se resetean al salir de ella.
    let prevLo = -1;
    let prevHi = -1;
    let drumBuilt = false;
    // Índice fraccionario del item que está en el centro ahora mismo. La clave
    // de la fluidez: los visuales se calculan a partir de ESTE valor continuo,
    // no del índice redondeado, así el número central crece/encoge de forma
    // gradual en vez de "saltar" al cruzar la mitad entre dos números.
    let pos = 0;
    let drumW = 0;

    const ITEM_OFF_OPACITY = "0.04";
    const ITEM_OFF_SCALE = 0.25;

    function buildDrum() {
      if (drumBuilt) return;
      drumBuilt = true;
      drumTrackEl.innerHTML = "";
      drumItems.length = 0;

      for (let i = 0; i < NUM_ITEMS; i++) {
        const v = valueForIdx(i);
        const tenths = Math.round(v * 10) % 10;
        const item = document.createElement("div");
        item.className = "drum-item";
        if (tenths === 0) {
          item.textContent = String(Math.round(v));
        } else {
          item.innerHTML = `<span class="drum-int">${Math.floor(v)}</span><span class="drum-dec">.${tenths}</span>`;
        }
        item.style.opacity = ITEM_OFF_OPACITY;
        item.style.transform = `scale(${ITEM_OFF_SCALE})`;
        drumTrackEl.appendChild(item);
        drumItems.push(item);
      }
    }

    // Interpola una tabla de keyframes por distancia fraccionaria `d` (0,1,2…).
    // Entre índice y índice el valor se mezcla linealmente → sin escalones.
    const sampleCurve = (curve: number[], d: number): number => {
      if (d <= 0) return curve[0];
      if (d >= curve.length - 1) return curve[curve.length - 1];
      const k = Math.floor(d);
      return curve[k] + (curve[k + 1] - curve[k]) * (d - k);
    };

    // Curvas de tamaño/opacidad por distancia al centro. El item central llega a
    // 1.25 (equivale al 2rem base → 2.5rem visual) y decae suavemente hacia fuera.
    const SCALE_CURVE = [1.25, 0.72, 0.52, 0.38, 0.28];
    const OPACITY_CURVE = [1, 0.55, 0.28, 0.14, 0.07];

    // Ancho de la banda de "focus" alrededor del centro.
    //   > 1  → el número permanece pleno en un rango MÁS AMPLIO (focus ancho).
    //   = 1  → caída lineal.
    //   < 1  → el número solo está pleno en una banda MUY estrecha (focus finito).
    // Subir el valor ensancha el rango en focus; bajarlo lo hace más puntual.
    const CENTER_SHARPNESS = 0.8;
    const RADIUS = 4;
    // Distancia "sesgada": comprime el rango cercano al centro para que el pico
    // de tamaño sea más puntual. dist 0 sigue siendo 0 (centro pleno).
    const sharpDist = (dist: number): number =>
      Math.pow(Math.min(dist / RADIUS, 1), CENTER_SHARPNESS) * RADIUS;

    function updateDrumVisuals(center: number) {
      const CENTER_GAP = 8; // px extra separation around the center
      const nearest = Math.round(center);
      const lo = Math.max(0, nearest - RADIUS);
      const hi = Math.min(MAX_IDX, nearest + RADIUS);

      // Apaga los items que salieron de la ventana visible.
      if (prevLo >= 0) {
        for (let i = prevLo; i <= prevHi; i++) {
          if (i < lo || i > hi) {
            const shift = Math.sign(i - center) * CENTER_GAP;
            drumItems[i].style.opacity = ITEM_OFF_OPACITY;
            drumItems[i].style.transform = `translateX(${shift}px) scale(${ITEM_OFF_SCALE})`;
            drumItems[i].classList.remove("is-center");
          }
        }
      }

      for (let i = lo; i <= hi; i++) {
        const d = sharpDist(Math.abs(i - center));
        // Separación continua: 0 en el centro, ±CENTER_GAP a partir de 1 item.
        const shift = Math.max(-1, Math.min(1, i - center)) * CENTER_GAP;
        drumItems[i].style.opacity = String(sampleCurve(OPACITY_CURVE, d));
        drumItems[i].style.transform =
          `translateX(${shift}px) scale(${sampleCurve(SCALE_CURVE, d)})`;
        drumItems[i].classList.toggle("is-center", i === nearest);
      }
      prevLo = lo;
      prevHi = hi;
    }

    // Pinta la rueda con el item `p` (fraccionario) en el centro. Solo visual.
    function renderDrum(p: number) {
      pos = p;
      const x = drumW / 2 - ITEM_W / 2 - p * ITEM_W;
      drumTrackEl.style.transform = `translate3d(${x}px, 0, 0)`;
      updateDrumVisuals(p);
    }

    // Guarda el valor del item más cercano al centro. Solo en interacción del
    // usuario: el primer cambio marca el plato como calificado.
    function commitDrumValue() {
      const v = valueForIdx(clampIdx(Math.round(pos)));
      if (v === prevDrumV) return;
      prevDrumV = v;
      ratingInput.value = String(v);
      if (!isRated) setRated(true);
      if ("vibrate" in navigator) navigator.vibrate(1);
    }

    // `is-scrolling` acorta las transiciones CSS de los items mientras la rueda
    // se mueve; se quita con retraso para que el asentamiento final sea suave.
    let scrollingTimer: number | undefined;
    function startScrolling() {
      clearTimeout(scrollingTimer);
      drumEl.classList.add("is-scrolling");
    }
    function endScrolling() {
      clearTimeout(scrollingTimer);
      scrollingTimer = window.setTimeout(
        () => drumEl.classList.remove("is-scrolling"),
        320,
      );
    }

    // Anima `pos` hasta el item `target` (ease-out) y deja la rueda quieta ahí.
    let animFrame = 0;
    function stopDrumAnim() {
      if (animFrame) cancelAnimationFrame(animFrame);
      animFrame = 0;
    }
    function animateDrumTo(target: number) {
      stopDrumAnim();
      const from = pos;
      const dist = Math.abs(target - from);
      if (dist < 0.001) {
        renderDrum(target);
        commitDrumValue();
        endScrolling();
        return;
      }
      startScrolling();
      const duration = Math.min(600, 180 + Math.sqrt(dist) * 110);
      const t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        renderDrum(from + (target - from) * eased);
        commitDrumValue();
        if (t < 1) {
          animFrame = requestAnimationFrame(step);
        } else {
          animFrame = 0;
          endScrolling();
        }
      };
      animFrame = requestAnimationFrame(step);
    }

    // Resistencia al pasar de los extremos (tipo iOS): se puede estirar un poco
    // más allá del 1 o del 10, cada vez cuesta más, y al soltar vuelve al tope.
    const RUBBER_MAX = 0.6; // items
    const rubberBand = (over: number) =>
      RUBBER_MAX * (1 - 1 / ((over * 0.55) / RUBBER_MAX + 1));
    const withResistance = (p: number) =>
      p < 0
        ? -rubberBand(-p)
        : p > MAX_IDX
          ? MAX_IDX + rubberBand(p - MAX_IDX)
          : p;

    // El ancho puede ser 0 al abrir (modal a mitad de animación, rotación…):
    // se re-mide al cambiar de tamaño y se re-centra el valor actual.
    const drumResizeObserver = new ResizeObserver(() => {
      if (!drumBuilt) return;
      drumW = drumEl.clientWidth;
      renderDrum(pos);
    });
    drumResizeObserver.observe(drumEl);

    // ── Arrastre (dedo y mouse) ──
    // touch-action: pan-y (CSS) deja el scroll vertical del modal al navegador y
    // nos entrega el gesto horizontal completo.
    const TOUCH_SPEED = 1.4; // un poco más que el dedo: menos recorrido hasta el 10
    const MOUSE_SPEED = 1.8;
    const DECEL = 0.004; // px/ms² — frenado de la inercia tras un "flick"
    let dragId: number | null = null;
    let dragStartX = 0;
    let dragStartPos = 0;
    let dragSpeed = TOUCH_SPEED;
    let dragMoved = false;
    let dragSamples: { t: number; x: number }[] = [];

    drumEl.addEventListener("pointerdown", (e) => {
      if (officialViewAuth || !isRated || dragId !== null) return;
      if (e.pointerType === "mouse" && e.button !== 0) return;
      stopDrumAnim();
      startScrolling();
      dragId = e.pointerId;
      dragStartX = e.clientX;
      dragStartPos = pos;
      dragSpeed = e.pointerType === "mouse" ? MOUSE_SPEED : TOUCH_SPEED;
      dragMoved = false;
      dragSamples = [{ t: e.timeStamp, x: e.clientX }];
      try {
        drumEl.setPointerCapture(e.pointerId);
      } catch {}
    });

    drumEl.addEventListener("pointermove", (e) => {
      if (e.pointerId !== dragId) return;
      const dx = e.clientX - dragStartX;
      if (Math.abs(dx) > 4) dragMoved = true;
      renderDrum(withResistance(dragStartPos - (dx * dragSpeed) / ITEM_W));
      commitDrumValue();
      // Muestras de los últimos ~100ms para medir la velocidad al soltar.
      dragSamples.push({ t: e.timeStamp, x: e.clientX });
      while (dragSamples.length > 2 && e.timeStamp - dragSamples[0].t > 100)
        dragSamples.shift();
    });

    const endDrag = (e: PointerEvent) => {
      if (e.pointerId !== dragId) return;
      dragId = null;
      try {
        drumEl.releasePointerCapture(e.pointerId);
      } catch {}

      // El navegador tomó el gesto (scroll vertical): volver al item más cercano.
      if (e.type === "pointercancel") {
        animateDrumTo(clampIdx(Math.round(pos)));
        return;
      }

      // Toque sin arrastre: salta al número tocado (p. ej. el 10 si se ve).
      if (!dragMoved) {
        const rect = drumEl.getBoundingClientRect();
        const offset = (e.clientX - (rect.left + rect.width / 2)) / ITEM_W;
        animateDrumTo(clampIdx(Math.round(pos + offset)));
        return;
      }

      // Inercia: con la velocidad del dedo al soltar se proyecta dónde frenaría
      // la rueda; un flick fuerte llega hasta el tope (1 o 10) y se queda ahí.
      const first = dragSamples[0];
      const last = dragSamples[dragSamples.length - 1];
      const dt = last.t - first.t;
      const v = dt > 0 && e.timeStamp - last.t < 80 ? (last.x - first.x) / dt : 0;
      const throwPx = (Math.sign(v) * v * v) / (2 * DECEL);
      const projected = pos - (throwPx * dragSpeed) / ITEM_W;
      animateDrumTo(clampIdx(Math.round(projected)));
    };
    drumEl.addEventListener("pointerup", endDrag);
    drumEl.addEventListener("pointercancel", endDrag);

    // Rueda del mouse / trackpad (escritorio).
    let wheelSnapTimer: number | undefined;
    drumEl.addEventListener(
      "wheel",
      (e) => {
        if (!isRated) return;
        e.preventDefault();
        stopDrumAnim();
        startScrolling();
        const delta =
          Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        const px = e.deltaMode === 1 ? delta * 16 : delta; // Firefox: líneas
        renderDrum(Math.max(0, Math.min(MAX_IDX, pos + px / ITEM_W)));
        commitDrumValue();
        clearTimeout(wheelSnapTimer);
        wheelSnapTimer = window.setTimeout(
          () => animateDrumTo(clampIdx(Math.round(pos))),
          120,
        );
      },
      { passive: false },
    );

    function initDrumForValue(v: number) {
      buildDrum();
      stopDrumAnim();
      dragId = null;
      // Aproxima el valor entrante (p.ej. 7.9 de datos viejos) al step 0.5 más cercano
      // y lo mantiene dentro del rango [1, 10].
      const idx = clampIdx(Math.round((v - MIN_V) / STEP));
      // Pre-cargar prevDrumV con el valor inicial: el render de abajo no debe
      // contarse como interacción del usuario (un plato nuevo nace sin calificación).
      prevDrumV = valueForIdx(idx);
      // Persistimos el valor ya aproximado al step: así un 7.9 heredado se guarda
      // como 8 aunque el usuario no toque la rueda. No afecta el invariante de
      // "sin calificar" porque el rating solo se guarda si isRated es true.
      ratingInput.value = String(prevDrumV);
      // Apagar todos los items (la apertura anterior pudo dejar otros encendidos).
      for (const item of drumItems) {
        item.style.opacity = ITEM_OFF_OPACITY;
        item.style.transform = `scale(${ITEM_OFF_SCALE})`;
        item.classList.remove("is-center");
      }
      prevLo = -1;
      prevHi = -1;
      drumW = drumEl.clientWidth;
      renderDrum(idx);
    }

    nameInput.oninput = () => {
      forceUppercase(nameInput);
    };

    form.onsubmit = (e) => {
      e.preventDefault();
      errorEl.textContent = "";

      // ── Producto genérico: modal informativo, nada que guardar → cerrar ──────
      if (isGenericView) {
        close();
        return;
      }

      // ── Anónimo en modo lectura: enviar = pedir login, no guardar nada ───────
      if (officialViewAuth) {
        const cb = officialViewAuth;
        close();
        cb();
        return;
      }

      // ── Modo calificación de plato OFICIAL (carta compartida) ────────────────
      // No hay Dish personal: se guarda directo en official_ratings.
      if (officialRatingDishId) {
        const rating = isRated ? parseFloat(ratingInput.value) : null;
        const dishId = officialRatingDishId;
        close();
        rateOfficialDish(dishId, rating);
        emit("official:rated", { officialDishId: dishId, rating });
        return;
      }

      const name = nameInput.value.trim();
      if (!name) {
        errorEl.textContent = "El nombre del plato es obligatorio.";
        nameInput.focus();
        return;
      }

      const restaurantId = restaurantIdInput.value;
      const id = idInput.value;

      const typeId = typeIdInput.value || null;
      const duplicate = getDishesByRestaurant(restaurantId).find(
        (d) =>
          d.name.trim().toLowerCase() === name.toLowerCase() &&
          d.typeId === typeId &&
          d.id !== id,
      );
      if (duplicate) {
        errorEl.textContent =
          "Ya existe un plato con ese nombre y tipo en este restaurante.";
        nameInput.focus();
        return;
      }

      const rating = isRated ? parseFloat(ratingInput.value) : null;
      const notes = notesInput.value.trim();

      // Cerrar ANTES de emitir: garantiza que el modal cierra aunque
      // el listener del evento lance una excepción.
      close();

      if (id) {
        // Capturar rating previo desde el cache ANTES del update para detectar
        // la transición null → número (única señal real de "primera calificación").
        const prevRating =
          getDishesByRestaurant(restaurantId).find((d) => d.id === id)
            ?.rating ?? null;
        const updated = updateDish(id, { name, rating, notes, typeId });
        if (updated) {
          emit("dish:updated", updated);
          // Solo dispara "primera calificación" en transición null → número.
          // El auto-promote a "visitado" se suscribe a este evento, no a dish:updated,
          // para no revertir un pending elegido manualmente por el usuario.
          if (prevRating === null && updated.rating !== null) {
            emit("dish:first-rated", updated);
          }
        }
      } else {
        emit(
          "dish:created",
          createDish({ restaurantId, typeId, name, rating, notes }),
        );
      }
    };

    // Actualizar API global con referencias frescas al DOM actual
    (window as any).dishForm = { open, openOfficial, close };
  });
</script>
