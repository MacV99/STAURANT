---
import FormModal from "./FormModal.astro";
---

<FormModal id="dish-form" title="Nuevo plato" maxWidth="420px">
  <input type="hidden" id="df-id" />
  <input type="hidden" id="df-restaurant-id" />
  <input type="hidden" id="df-type-id" />
  <input type="hidden" id="df-rating" value="5" />

  <div class="official-hero flex-column" id="df-official-fields" hidden>
    <h3 class="official-name" id="df-official-name"></h3>
    <span class="official-type" id="df-official-type"></span>
  </div>

  <div class="type-field flex-column" id="df-type-field">
    <span class="label-text flex-row"
      >Tipo de plato <span class="optional">(opcional)</span></span
    >
    <div class="type-combobox" id="df-type-combobox">
      <div class="type-input-wrap flex-row">
        <input
          type="text"
          id="df-type-search"
          class="type-search-input"
          placeholder="Selecciona una etiqueta"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          id="df-type-clear"
          class="type-clear-btn"
          hidden
          aria-label="Quitar tipo"
        >
          <i class="bi bi-x-lg"></i>
        </button>
        <span class="type-chevron" aria-hidden="true"
          ><i class="bi bi-chevron-down"></i></span
        >
      </div>
      <div id="df-type-dropdown" class="type-dropdown" hidden></div>
    </div>
  </div>

  <label for="df-name" id="df-name-field">
    <span class="label-text flex-row"
      >Nombre del plato <span class="required">*</span></span
    >
    <input
      type="text"
      id="df-name"
      required
      placeholder="Bandeja paisa, Sushi roll..."
    />
  </label>

  <div class="rating-field flex-column">
    <div class="rating-label-row flex-row">
      <span class="rating-label"
        >Calificación <span class="optional">(opcional)</span></span
      >
      <button
        type="button"
        id="df-rating-clear"
        class="rating-clear-link"
        hidden
      >
        Quitar
      </button>
    </div>
    <div class="drum-outer is-unrated" id="df-drum-outer">
      <div class="drum-picker" id="df-rating-drum">
        <div class="drum-track" id="df-drum-track"></div>
      </div>
      <div class="drum-hint">
        <i class="bi bi-star"></i>
        <span>Toca para calificar</span>
      </div>
    </div>
  </div>

  <label for="df-notes" id="df-notes-field">
    <span class="label-text flex-row">Notas</span>
    <textarea
      id="df-notes"
      rows="2"
      placeholder="Sabor, presentación, lo que quieras recordar..."></textarea>
  </label>
</FormModal>

<style>
  /* Estilos base de form/label/footer viven en project.css (.form-box …).
     Aquí solo lo específico de este formulario (rating, drum, combobox tipo). */

  /* Igualar el tamaño de fuente del nombre/notas al del input de tipo (0.9rem). */
  #df-name,
  #df-notes {
    font-size: 0.9rem;
  }

  /* Plato oficial: el nombre y el tipo los administra el restaurante, así que
     se presentan como una cabecera editorial (título + subtítulo), no como
     inputs. Solo notas y calificación quedan editables. */
  .official-hero {
    align-items: flex-start;
    gap: 6px;
    padding: 2px 0 14px;
    border-bottom: 1px solid var(--clr-border);
  }

  .official-hero[hidden] {
    display: none;
  }

  .official-name {
    margin: 2px 0 0;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.6px;
    text-transform: uppercase;
    color: var(--clr-text);
  }

  .official-type {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--clr-text);
    opacity: 0.5;
  }

  .official-type[hidden] {
    display: none;
  }

  /* `.flex-column` fija display:flex y gana al [hidden] del user-agent →
     forzar el ocultado de los campos editables en platos oficiales. */
  #df-type-field[hidden],
  #df-name-field[hidden] {
    display: none;
  }

  .rating-field {
    align-items: stretch;
    gap: 8px;
  }

  .rating-label-row {
    justify-content: space-between;
    align-items: center;
  }

  .rating-label {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--clr-text);
    text-transform: uppercase;
  }

  .rating-clear-link {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.75rem;
    color: var(--clr-text);
    opacity: 0.45;
    padding: 0;
    transition: opacity var(--transition);
  }

  @media (hover: hover) {
    .rating-clear-link:hover {
      opacity: 1;
      color: var(--clr-danger);
    }
  }

  /* ── Drum picker ─────────────────────────────────────────────────────────── */

  .drum-outer {
    position: relative;
    display: flex;
    align-items: stretch;
    border-radius: 16px;
    background: var(--clr-white2);
    border: 1.5px dashed var(--clr-border2);
    transition:
      border-color var(--transition),
      background var(--transition);
    height: 72px;
    overflow: hidden;
    cursor: pointer;
  }

  .drum-outer:not(.is-unrated) {
    border-style: solid;
    background: var(--clr-white);
    cursor: default;
  }

  .drum-hint {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--clr-primary);
    pointer-events: none;
    transition: opacity 0.2s ease;
    animation: drum-hint-pulse 2s ease-in-out infinite;
  }

  .drum-hint i {
    font-size: 1.15rem;
  }

  .drum-outer:not(.is-unrated) .drum-hint {
    opacity: 0;
    animation: none;
  }

  @keyframes drum-hint-pulse {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 0.95;
    }
  }

  .drum-picker {
    flex: 1;
    min-width: 0;
    overflow-x: scroll;
    overflow-y: hidden;
    scrollbar-width: none;
    /* Snap handled fully in JS (debounced on scroll-end). Native mandatory snap
       on iOS Safari refuses to land on the last item when it's near edge — caused
       picker to cap at ~9.7. */
    overscroll-behavior-x: contain;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 22%,
      black 78%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 22%,
      black 78%,
      transparent
    );
    pointer-events: none;
  }

  .drum-outer:not(.is-unrated) .drum-picker {
    pointer-events: auto;
    cursor: grab;
  }

  /* Sin calificación: ocultar items para que solo se vea el hint */
  .drum-outer.is-unrated .drum-picker {
    opacity: 0;
  }

  .drum-picker::-webkit-scrollbar {
    display: none;
  }
  .drum-outer:not(.is-unrated) .drum-picker:active {
    cursor: grabbing;
  }

  .drum-track {
    display: flex;
    align-items: center;
    height: 100%;
    /* width: max-content → track se dimensiona al ancho real de sus items + spacers.
       Sin esto, drum-track adopta ancho del padre y los items desbordan, lo que en
       iOS Safari hace que scrollWidth no cubra el último ítem. */
    width: max-content;
  }

  /* ── Combobox de tipo — elementos estáticos ───────────────────────────── */

  .type-field {
    align-items: stretch;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--clr-text);
    text-transform: uppercase;
  }

  .type-combobox {
    position: relative;
  }

  .type-input-wrap {
    border: 1.5px solid var(--clr-border);
    border-radius: var(--border-radius);
    background: var(--clr-white);
    overflow: hidden;
    transition: border-color 0.12s ease;
  }

  .type-input-wrap:focus-within {
    border-color: var(--clr-border2);
  }

  .type-search-input {
    flex: 1;
    border: none !important;
    background: transparent !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 10px 12px;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--clr-text);
    min-width: 0;
  }

  .type-search-input::placeholder {
    text-transform: none;
    color: var(--clr-text);
    opacity: 0.5;
    font-weight: 400;
  }

  .type-clear-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 6px;
    color: var(--clr-text);
    opacity: 0.5;
    font-size: 0.75rem;
    flex-shrink: 0;
    transition: opacity 0.12s ease;
  }

  .type-chevron {
    padding: 0 10px 0 4px;
    color: var(--clr-text);
    opacity: 0.4;
    font-size: 0.75rem;
    flex-shrink: 0;
    pointer-events: none;
    transition: transform 0.15s ease;
  }

  .type-combobox.is-open .type-chevron {
    transform: rotate(180deg);
  }

  .type-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: var(--clr-white);
    border: 1.5px solid var(--clr-border);
    border-radius: var(--border-radius);
    z-index: 200;
    max-height: 220px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  @media (hover: hover) {
    .type-clear-btn:hover {
      opacity: 1;
    }
  }
</style>

<style is:global>
  /* ── Drum items (created via JS → need global scope) ──────────────────── */

  #df-rating-drum .drum-item {
    width: 52px;
    flex-shrink: 0;
    text-align: center;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -1.5px;
    color: var(--clr-text);
    line-height: 1;
    user-select: none;
    transform-origin: center;
    transition:
      transform 0.26s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.26s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Durante el scroll los visuales (tamaño/opacidad) se calculan en JS cuadro a
     cuadro según la posición exacta. Una transición corta y con arranque rápido
     (ease-out) hace que el número "clave" al centro de forma más cortante y se
     disuelva suave al alejarse, sin reintroducir el salto. No usar 0s aquí. */
  #df-rating-drum.is-scrolling .drum-item {
    transition:
      transform 0.06s ease-out,
      opacity 0.06s ease-out;
  }

  /* Decimal part of drum items (e.g. ".5") — smaller than the integer */
  #df-rating-drum .drum-item .drum-dec {
    font-size: 0.6em;
    letter-spacing: -1px;
    font-weight: 800;
  }

  /* El tamaño del número central lo maneja el `scale` continuo en JS
     (SCALE_CURVE) para que crezca de forma gradual, sin brinco de font-size.
     Se mantiene la clase por si se quiere enfatizar el color/estado activo. */

  /* ── Type dropdown ─────────────────────────────────────────────────────── */

  #df-type-dropdown .type-option {
    padding: 12px 16px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--clr-text);
    cursor: pointer;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    transition: background 0.1s ease;
    border-bottom: 1px solid var(--clr-border);
  }

  #df-type-dropdown .type-option:last-child {
    border-bottom: none;
  }

  @media (hover: hover) {
    #df-type-dropdown .type-option:hover,
    #df-type-dropdown .type-option:focus {
      background: var(--clr-white2);
    }

    #df-type-dropdown .type-option.is-create:hover {
      background: var(--clr-white2);
    }
  }

  #df-type-dropdown .type-option.is-selected {
    color: var(--clr-primary);
    font-weight: 700;
  }

  #df-type-dropdown .type-option.is-none {
    color: var(--clr-text);
    opacity: 0.55;
    font-size: 0.82rem;
    text-transform: none;
    letter-spacing: 0;
    border-bottom: 1px solid var(--clr-border);
  }

  #df-type-dropdown .type-option.is-create {
    color: var(--clr-primary);
    font-weight: 600;
    border-top: 1px solid var(--clr-border);
    text-transform: none;
    letter-spacing: 0;
    justify-content: flex-start;
    gap: 6px;
  }

  #df-type-dropdown .type-option.is-create i {
    font-size: 0.7rem;
    flex-shrink: 0;
  }

  #df-type-dropdown .type-option.is-create .create-name {
    font-weight: 700;
    text-transform: uppercase;
  }

  #df-type-dropdown .type-option.is-empty {
    color: var(--clr-text);
    opacity: 0.5;
    font-size: 0.82rem;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    cursor: default;
    text-align: center;
    padding: 14px;
  }
</style>

<script>
  import type { Dish, OfficialDish } from "../lib/data.ts";
  import {
    createDish,
    updateDish,
    getDishesByRestaurant,
    getDishTypes,
    createDishType,
    rateOfficialDish,
  } from "../lib/data.ts";
  import { emit, forceUppercase, createOverlay } from "../scripts/store.ts";

  // Re-inicializar en cada navegación para que open/close siempre
  // operen sobre los elementos del DOM ACTUAL (no los del swap anterior).
  document.addEventListener("astro:page-load", () => {
    const overlayApi = createOverlay("dish-form-overlay", {
      onClose: () => closeDropdown(),
    });
    if (!overlayApi) return; // no está en esta página
    const { overlay, close } = overlayApi;

    const form = document.getElementById("dish-form") as HTMLFormElement;
    const titleEl = document.getElementById("dish-form-title")!;
    const idInput = document.getElementById("df-id") as HTMLInputElement;
    const restaurantIdInput = document.getElementById(
      "df-restaurant-id",
    ) as HTMLInputElement;
    const typeIdInput = document.getElementById(
      "df-type-id",
    ) as HTMLInputElement;
    const nameInput = document.getElementById("df-name") as HTMLInputElement;
    const ratingInput = document.getElementById(
      "df-rating",
    ) as HTMLInputElement;
    const notesInput = document.getElementById(
      "df-notes",
    ) as HTMLTextAreaElement;
    const errorEl = document.getElementById("dish-form-error")!;
    const closeBtn = document.getElementById("dish-form-close")!;
    const cancelBtn = document.getElementById("dish-form-cancel")!;
    const ratingClearBtn = document.getElementById(
      "df-rating-clear",
    ) as HTMLButtonElement;
    const drumOuterEl = document.getElementById("df-drum-outer") as HTMLElement;
    const drumEl = document.getElementById("df-rating-drum") as HTMLElement;
    const drumTrackEl = document.getElementById("df-drum-track") as HTMLElement;
    const officialFieldsEl = document.getElementById(
      "df-official-fields",
    ) as HTMLElement;
    const officialTypeEl = document.getElementById(
      "df-official-type",
    ) as HTMLElement;
    const officialNameEl = document.getElementById(
      "df-official-name",
    ) as HTMLElement;
    const typeFieldEl = document.getElementById("df-type-field") as HTMLElement;
    const nameFieldEl = document.getElementById("df-name-field") as HTMLElement;

    // Platos oficiales: nombre/tipo/notas los administra el sistema, solo se permite
    // calificar. Ocultamos esos campos y mostramos el aviso correspondiente.
    let isOfficial = false;
    // Cuando se califica un plato oficial desde la carta compartida (/oficial) NO
    // existe un Dish personal: la nota se guarda en official_ratings. Este id marca
    // ese modo; el submit escribe vía rateOfficialDish en vez de updateDish.
    let officialRatingDishId: string | null = null;

    let isRated = false;

    function setRated(rated: boolean, value?: number) {
      isRated = rated;
      ratingClearBtn.hidden = !rated;
      drumOuterEl.classList.toggle("is-unrated", !rated);
      if (rated) {
        const v = value ?? parseFloat(ratingInput.value);
        ratingInput.value = String(v);
      }
    }

    ratingClearBtn.onclick = (e) => {
      e.stopPropagation();
      setRated(false);
    };
    drumOuterEl.onclick = () => {
      if (!isRated) setRated(true);
    };

    // ─── Combobox de tipo ──────────────────────────────────────────────────────

    const comboboxEl = document.getElementById("df-type-combobox")!;
    const searchInput = document.getElementById(
      "df-type-search",
    ) as HTMLInputElement;
    const clearBtn = document.getElementById(
      "df-type-clear",
    ) as HTMLButtonElement;
    const dropdownEl = document.getElementById(
      "df-type-dropdown",
    ) as HTMLElement;

    let selectedTypeId: string | null = null;

    function openDropdown() {
      if (isOfficial) return; // plato oficial: tipo bloqueado, no abrir desplegable
      renderDropdown(searchInput.value);
      dropdownEl.hidden = false;
      comboboxEl.classList.add("is-open");
    }

    function closeDropdown() {
      dropdownEl.hidden = true;
      comboboxEl.classList.remove("is-open");
      // Restaurar el nombre del tipo seleccionado si el input quedó con texto parcial
      if (selectedTypeId) {
        const t = getDishTypes().find((t) => t.id === selectedTypeId);
        searchInput.value = t?.name ?? "";
      } else {
        searchInput.value = "";
      }
    }

    function selectType(id: string | null, name: string | null) {
      selectedTypeId = id;
      typeIdInput.value = id ?? "";
      searchInput.value = name ?? "";
      clearBtn.hidden = !id;
      closeDropdown();
    }

    function renderDropdown(query: string) {
      const types = getDishTypes();
      const q = query.trim().toUpperCase();
      const filtered = q ? types.filter((t) => t.name.includes(q)) : types;
      const exactMatch = types.some((t) => t.name === q);

      dropdownEl.innerHTML = "";

      // Opción "ninguno" para deseleccionar (solo cuando hay algo seleccionado)
      if (selectedTypeId) {
        const noneOpt = document.createElement("div");
        noneOpt.className = "type-option is-none";
        noneOpt.textContent = "— Sin tipo";
        noneOpt.addEventListener("mousedown", (e) => e.preventDefault());
        noneOpt.addEventListener("click", () => selectType(null, null));
        dropdownEl.appendChild(noneOpt);
      }

      // Opciones existentes
      filtered.forEach((t) => {
        const opt = document.createElement("div");
        opt.className =
          "type-option" + (t.id === selectedTypeId ? " is-selected" : "");
        opt.textContent = t.name;
        opt.addEventListener("mousedown", (e) => e.preventDefault());
        opt.addEventListener("click", () => selectType(t.id, t.name));
        dropdownEl.appendChild(opt);
      });

      // Opción para crear (solo si el texto no coincide exactamente)
      if (q && !exactMatch) {
        const createOpt = document.createElement("div");
        createOpt.className = "type-option is-create flex-row";
        createOpt.innerHTML = `<i class="bi bi-plus-lg"></i> Crear "<span class="create-name">${q}</span>"`;
        createOpt.addEventListener("mousedown", (e) => e.preventDefault());
        createOpt.addEventListener("click", () => {
          // Verificar que no exista ya (race condition)
          const existing = getDishTypes().find((t) => t.name === q);
          if (existing) {
            selectType(existing.id, existing.name);
          } else {
            const newType = createDishType(q);
            selectType(newType.id, newType.name);
          }
        });
        dropdownEl.appendChild(createOpt);
      }

      // Estado vacío
      if (dropdownEl.childElementCount === 0) {
        const emptyOpt = document.createElement("div");
        emptyOpt.className = "type-option is-empty";
        emptyOpt.textContent = "Escribe para crear tu primera etiqueta";
        dropdownEl.appendChild(emptyOpt);
      }
    }

    // Input: filtra mientras escribe
    searchInput.addEventListener("input", () => {
      forceUppercase(searchInput);
      // Limpiar selección actual si el usuario está escribiendo algo nuevo
      selectedTypeId = null;
      typeIdInput.value = "";
      clearBtn.hidden = true;
      if (dropdownEl.hidden) openDropdown();
      else renderDropdown(searchInput.value);
    });

    // Abrir al hacer focus / click
    searchInput.addEventListener("focus", () => {
      if (dropdownEl.hidden) openDropdown();
    });
    searchInput.addEventListener("click", () => {
      if (dropdownEl.hidden) openDropdown();
    });

    // Cerrar al perder foco (con delay para permitir el click en opciones)
    searchInput.addEventListener("blur", () => {
      setTimeout(() => {
        if (!comboboxEl.contains(document.activeElement)) {
          closeDropdown();
        }
      }, 150);
    });

    // Botón X para limpiar la selección (mousedown evita blur del input)
    clearBtn.addEventListener("mousedown", (e) => e.preventDefault());
    clearBtn.addEventListener("click", () => {
      selectType(null, null);
      searchInput.focus();
    });

    // Inicializa el combobox con un tipo pre-seleccionado (o sin selección)
    function initTypeCombobox(selectedId: string | null) {
      selectedTypeId = selectedId;
      typeIdInput.value = selectedId ?? "";
      dropdownEl.hidden = true;
      comboboxEl.classList.remove("is-open");
      if (selectedId) {
        const t = getDishTypes().find((t) => t.id === selectedId);
        searchInput.value = t?.name ?? "";
        clearBtn.hidden = false;
      } else {
        searchInput.value = "";
        clearBtn.hidden = true;
      }
    }

    // ─── Apertura / cierre del modal ──────────────────────────────────────────

    function open(mode: "create" | "edit", restaurantId: string, data?: Dish) {
      errorEl.textContent = "";
      form.reset();
      restaurantIdInput.value = restaurantId;
      officialRatingDishId = null;

      isOfficial = mode === "edit" && !!data?.officialDishId;
      // Plato oficial: nombre y tipo los administra el restaurante → se muestran
      // como texto plano (no inputs). Solo notas y calificación son editables.
      // Ocultamos los campos editables de nombre/tipo y mostramos el bloque display.
      officialFieldsEl.hidden = !isOfficial;
      typeFieldEl.hidden = isOfficial;
      nameFieldEl.hidden = isOfficial;
      (document.getElementById("df-notes-field") as HTMLElement).hidden = false;

      if (mode === "edit" && data) {
        titleEl.textContent = isOfficial ? "Calificar plato" : "Editar plato";
        idInput.value = data.id;
        nameInput.value = data.name;
        notesInput.value = data.notes;
        if (data.rating !== null) {
          setRated(true, data.rating);
        } else {
          ratingInput.value = "5";
          setRated(false);
        }
        initTypeCombobox(data.typeId ?? null);

        // Rellenar el bloque de solo lectura para platos oficiales.
        if (isOfficial) {
          const typeName =
            getDishTypes().find((t) => t.id === data.typeId)?.name ?? "";
          officialNameEl.textContent = data.name;
          officialTypeEl.textContent = typeName;
          officialTypeEl.hidden = !typeName;
        }
      } else {
        titleEl.textContent = "Nuevo plato";
        idInput.value = "";
        ratingInput.value = "5";
        setRated(false);
        initTypeCombobox(null);
      }

      overlay.classList.add("is-open");
      requestAnimationFrame(() =>
        initDrumForValue(parseFloat(ratingInput.value)),
      );
    }

    /** Califica un plato OFICIAL desde la carta compartida (/oficial). No hay Dish
     *  personal: solo se muestra la cabecera del plato + la rueda de calificación.
     *  El submit guarda en official_ratings vía rateOfficialDish. */
    function openOfficial(od: OfficialDish, currentRating: number | null) {
      errorEl.textContent = "";
      form.reset();
      isOfficial = true;
      officialRatingDishId = od.id;

      // Solo cabecera + rueda: ocultar campos editables (nombre/tipo/notas).
      officialFieldsEl.hidden = false;
      typeFieldEl.hidden = true;
      nameFieldEl.hidden = true;
      (document.getElementById("df-notes-field") as HTMLElement).hidden = true;

      titleEl.textContent = "Calificar plato";
      officialNameEl.textContent = od.name;
      officialTypeEl.textContent = od.typeName ?? "";
      officialTypeEl.hidden = !od.typeName;

      if (currentRating !== null) {
        setRated(true, currentRating);
        ratingInput.value = String(currentRating);
      } else {
        ratingInput.value = "5";
        setRated(false);
      }

      overlay.classList.add("is-open");
      requestAnimationFrame(() =>
        initDrumForValue(parseFloat(ratingInput.value)),
      );
    }

    // close() y el cierre por click-fuera los provee createOverlay (arriba);
    // onClose ejecuta closeDropdown(). .onclick evita acumular listeners.
    closeBtn.onclick = close;
    cancelBtn.onclick = close;

    // ─── Drum picker ──────────────────────────────────────────────────────────

    const ITEM_W = 52;
    const MIN_V = 1.0;
    const MAX_V = 10.0;
    const STEP = 0.5;
    const NUM_ITEMS = Math.round((MAX_V - MIN_V) / STEP) + 1; // 1.0 → 10.0 at 0.5 steps
    // Valor del item idx, redondeado al step para evitar errores de punto flotante.
    const valueForIdx = (idx: number) =>
      Math.round((MIN_V + idx * STEP) * 10) / 10;
    // Espacio extra simétrico a cada lado para permitir rebote/overscroll
    // pasando el 1 (izq) y el 10 (der). El snap JS regresa al item.
    const OVERSCROLL = Math.round(ITEM_W * 0.55);

    const drumItems: HTMLElement[] = [];
    let prevDrumV = -1;
    // Ventana de items actualmente pintados; se resetean al salir de ella.
    let prevLo = -1;
    let prevHi = -1;
    let drumBuilt = false;
    let startSpacer: HTMLElement | null = null;
    let endSpacer: HTMLElement | null = null;

    // scrollLeft que centra el item idx (las dos spacers añaden OVERSCROLL al origen).
    const scrollLeftFor = (idx: number) => idx * ITEM_W + OVERSCROLL;
    // Índice fraccionario del punto que está en el centro ahora mismo. La clave
    // de la fluidez: los visuales se calculan a partir de ESTE valor continuo,
    // no del índice redondeado, así el número central crece/encoge de forma
    // gradual en vez de "saltar" al cruzar la mitad entre dos números.
    const centerFromScrollLeft = () =>
      (drumEl.scrollLeft - OVERSCROLL) / ITEM_W;
    const idxFromScrollLeft = () =>
      Math.max(0, Math.min(NUM_ITEMS - 1, Math.round(centerFromScrollLeft())));

    function syncDrumPadding() {
      const w = drumEl.getBoundingClientRect().width;
      if (w === 0) return; // not laid out yet — wait for ResizeObserver
      const pad = Math.max(0, w / 2 - ITEM_W / 2);
      // Spacers simétricos + OVERSCROLL: item 1 e item 10 centran igual,
      // y queda un poco de cuerda para rebotar a cada lado.
      const spacer = pad + OVERSCROLL;
      if (startSpacer) startSpacer.style.flex = `0 0 ${spacer}px`;
      if (endSpacer) endSpacer.style.flex = `0 0 ${spacer}px`;
    }

    // Drum-picker width may be 0 at first measurement (modal mid-open, dvh shift,
    // rotation). Re-sync spacers whenever it resizes and re-anchor the current
    // value so item 10 stays reachable.
    const drumResizeObserver = new ResizeObserver(() => {
      if (!drumBuilt) return;
      const prevIdx = idxFromScrollLeft();
      syncDrumPadding();
      drumEl.scrollLeft = scrollLeftFor(prevIdx);
    });
    drumResizeObserver.observe(drumEl);

    function buildDrum() {
      if (drumBuilt) return;
      drumBuilt = true;
      drumTrackEl.innerHTML = "";
      drumItems.length = 0;

      startSpacer = document.createElement("div");
      startSpacer.style.flexShrink = "0";
      startSpacer.setAttribute("aria-hidden", "true");
      drumTrackEl.appendChild(startSpacer);

      for (let i = 0; i < NUM_ITEMS; i++) {
        const v = valueForIdx(i);
        const tenths = Math.round(v * 10) % 10;
        const item = document.createElement("div");
        item.className = "drum-item";
        if (tenths === 0) {
          item.textContent = String(Math.round(v));
        } else {
          item.innerHTML = `<span class="drum-int">${Math.floor(v)}</span><span class="drum-dec">.${tenths}</span>`;
        }
        item.style.opacity = "0.04";
        item.style.transform = "scale(0.25)";
        drumTrackEl.appendChild(item);
        drumItems.push(item);
      }

      endSpacer = document.createElement("div");
      endSpacer.style.flexShrink = "0";
      endSpacer.setAttribute("aria-hidden", "true");
      drumTrackEl.appendChild(endSpacer);
    }

    // Interpola una tabla de keyframes por distancia fraccionaria `d` (0,1,2…).
    // Entre índice y índice el valor se mezcla linealmente → sin escalones.
    const sampleCurve = (curve: number[], d: number): number => {
      if (d <= 0) return curve[0];
      if (d >= curve.length - 1) return curve[curve.length - 1];
      const k = Math.floor(d);
      return curve[k] + (curve[k + 1] - curve[k]) * (d - k);
    };

    // Curvas de tamaño/opacidad por distancia al centro. El item central llega a
    // 1.25 (equivale al 2rem base → 2.5rem visual) y decae suavemente hacia fuera.
    const SCALE_CURVE = [1.25, 0.72, 0.52, 0.38, 0.28];
    const OPACITY_CURVE = [1, 0.55, 0.28, 0.14, 0.07];

    // Ancho de la banda de "focus" alrededor del centro.
    //   > 1  → el número permanece pleno en un rango MÁS AMPLIO (focus ancho).
    //   = 1  → caída lineal.
    //   < 1  → el número solo está pleno en una banda MUY estrecha (focus finito).
    // Subir el valor ensancha el rango en focus; bajarlo lo hace más puntual.
    const CENTER_SHARPNESS = 0.8;
    const RADIUS = 4;
    // Distancia "sesgada": comprime el rango cercano al centro para que el pico
    // de tamaño sea más puntual. dist 0 sigue siendo 0 (centro pleno).
    const sharpDist = (dist: number): number =>
      Math.pow(Math.min(dist / RADIUS, 1), CENTER_SHARPNESS) * RADIUS;

    function updateDrumVisuals(center: number) {
      const CENTER_GAP = 8; // px extra separation around the center
      const nearest = Math.round(center);
      const lo = Math.max(0, nearest - RADIUS);
      const hi = Math.min(NUM_ITEMS - 1, nearest + RADIUS);

      // Apaga los items que salieron de la ventana visible.
      if (prevLo >= 0) {
        for (let i = prevLo; i <= prevHi; i++) {
          if (i < lo || i > hi) {
            const shift = Math.sign(i - center) * CENTER_GAP;
            drumItems[i].style.opacity = "0.04";
            drumItems[i].style.transform = `translateX(${shift}px) scale(0.25)`;
            drumItems[i].classList.remove("is-center");
          }
        }
      }

      for (let i = lo; i <= hi; i++) {
        const d = sharpDist(Math.abs(i - center));
        // Separación continua: 0 en el centro, ±CENTER_GAP a partir de 1 item.
        const shift = Math.max(-1, Math.min(1, i - center)) * CENTER_GAP;
        drumItems[i].style.opacity = String(sampleCurve(OPACITY_CURVE, d));
        drumItems[i].style.transform =
          `translateX(${shift}px) scale(${sampleCurve(SCALE_CURVE, d)})`;
        drumItems[i].classList.toggle("is-center", i === nearest);
      }
      prevLo = lo;
      prevHi = hi;
    }

    let scrollSnapTimer: number | undefined;
    let isTouching = false;

    // Velocity tracking for smart snap (don't fight momentum on fast flick)
    let lastScrollLeft = 0;
    let lastScrollTime = 0;
    let scrollVelocity = 0;

    function snapToNearest() {
      const target = scrollLeftFor(idxFromScrollLeft());
      if (Math.abs(drumEl.scrollLeft - target) > 0.5) {
        drumEl.scrollTo({ left: target, behavior: "smooth" });
      }
    }

    function removeIsScrolling() {
      window.setTimeout(() => drumEl.classList.remove("is-scrolling"), 320);
    }

    drumEl.addEventListener(
      "scroll",
      () => {
        const now = Date.now();
        const dt = now - lastScrollTime;
        if (dt > 0)
          scrollVelocity = Math.abs(drumEl.scrollLeft - lastScrollLeft) / dt;
        lastScrollLeft = drumEl.scrollLeft;
        lastScrollTime = now;

        const center = centerFromScrollLeft();
        updateDrumVisuals(center);
        const idx = Math.max(0, Math.min(NUM_ITEMS - 1, Math.round(center)));
        const v = valueForIdx(idx);
        if (v !== prevDrumV) {
          prevDrumV = v;
          if (!isRated) {
            isRated = true;
            ratingClearBtn.hidden = false;
            drumOuterEl.classList.remove("is-unrated");
          }
          ratingInput.value = String(v);
          if ("vibrate" in navigator) navigator.vibrate(1);
        }

        // Suppress CSS transitions while scrolling for instant visual response
        drumEl.classList.add("is-scrolling");

        // Velocity-aware debounced snap: if still moving fast, re-arm once more
        if (scrollSnapTimer) clearTimeout(scrollSnapTimer);
        scrollSnapTimer = window.setTimeout(() => {
          if (isDragging || isTouching) return;
          if (scrollVelocity >= 0.3) {
            // Still has momentum — wait one more beat
            scrollSnapTimer = window.setTimeout(() => {
              if (!isDragging && !isTouching) {
                snapToNearest();
                removeIsScrolling();
              }
            }, 80);
          } else {
            snapToNearest();
            removeIsScrolling();
          }
        }, 120);
      },
      { passive: true },
    );

    // Track de dedo apoyado: sin esto, el timer de 120ms snappea bajo el dedo
    // si el usuario pausa el movimiento sin soltar.
    drumEl.addEventListener(
      "touchstart",
      () => {
        isTouching = true;
        if (scrollSnapTimer) clearTimeout(scrollSnapTimer);
        drumEl.classList.add("is-scrolling");
      },
      { passive: true },
    );
    const onTouchRelease = () => {
      isTouching = false;
      // Snap inmediato al soltar: ya sabemos que el gesto terminó, no hay nada
      // que debouncear. El timer del scroll se cancela para que no dispare otro.
      if (scrollSnapTimer) clearTimeout(scrollSnapTimer);
      if (!isDragging) {
        snapToNearest();
        removeIsScrolling();
      }
    };
    drumEl.addEventListener("touchend", onTouchRelease, { passive: true });
    drumEl.addEventListener("touchcancel", onTouchRelease, { passive: true });

    // Wheel support for desktop
    let wheelSnapTimer: number | undefined;
    drumEl.addEventListener(
      "wheel",
      (e) => {
        e.preventDefault();
        drumEl.scrollLeft += e.deltaY !== 0 ? e.deltaY : e.deltaX;
        drumEl.classList.add("is-scrolling");
        // Debounced snap-to-nearest after wheel stops
        if (wheelSnapTimer) clearTimeout(wheelSnapTimer);
        wheelSnapTimer = window.setTimeout(() => {
          drumEl.scrollTo({
            left: scrollLeftFor(idxFromScrollLeft()),
            behavior: "smooth",
          });
          removeIsScrolling();
        }, 120);
      },
      { passive: false },
    );

    // Mouse drag support for desktop (touch already scrolls natively)
    let isDragging = false;
    let dragStartX = 0;
    let dragStartScroll = 0;
    let dragMoved = false;

    drumEl.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "touch") return;
      if (drumOuterEl.classList.contains("is-unrated")) return;
      isDragging = true;
      dragMoved = false;
      dragStartX = e.clientX;
      dragStartScroll = drumEl.scrollLeft;
      try {
        drumEl.setPointerCapture(e.pointerId);
      } catch {}
    });

    const DRAG_SPEED = 1.8; // multiplier so reaching the edges doesn't require a huge drag

    drumEl.addEventListener("pointermove", (e) => {
      if (!isDragging) return;
      const dx = e.clientX - dragStartX;
      if (Math.abs(dx) > 2) dragMoved = true;
      drumEl.scrollLeft = dragStartScroll - dx * DRAG_SPEED;
    });

    const endDrag = (e: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      try {
        drumEl.releasePointerCapture(e.pointerId);
      } catch {}
      // Custom JS scroll doesn't trigger CSS scroll-snap. Snap to nearest item manually
      // so releases always land exactly on a value (including the max, 10).
      drumEl.scrollTo({
        left: scrollLeftFor(idxFromScrollLeft()),
        behavior: "smooth",
      });
      removeIsScrolling();
      if (dragMoved) {
        const stopClick = (ev: Event) => {
          ev.stopPropagation();
        };
        window.addEventListener("click", stopClick, {
          capture: true,
          once: true,
        });
      }
    };
    drumEl.addEventListener("pointerup", endDrag);
    drumEl.addEventListener("pointercancel", endDrag);

    function initDrumForValue(v: number) {
      buildDrum();
      syncDrumPadding();
      // Aproxima el valor entrante (p.ej. 7.9 de datos viejos) al step 0.5 más cercano
      // y lo mantiene dentro del rango [1, 10].
      const idx = Math.max(
        0,
        Math.min(NUM_ITEMS - 1, Math.round((v - MIN_V) / STEP)),
      );
      // Pre-cargar prevDrumV con el valor inicial: al fijar scrollLeft abajo se
      // dispara un evento "scroll" programático; sin esto el handler lo trataría
      // como interacción del usuario y auto-calificaría el plato (isRated=true),
      // rompiendo el invariante de "plato nuevo nace sin calificación".
      prevDrumV = valueForIdx(idx);
      // Persistimos el valor ya aproximado al step: así un 7.9 heredado se guarda
      // como 8 aunque el usuario no toque la rueda. No afecta el invariante de
      // "sin calificar" porque el rating solo se guarda si isRated es true.
      ratingInput.value = String(prevDrumV);
      prevLo = -1;
      prevHi = -1;
      drumEl.scrollLeft = scrollLeftFor(idx);
      requestAnimationFrame(() => {
        updateDrumVisuals(centerFromScrollLeft());
      });
    }

    nameInput.oninput = () => {
      forceUppercase(nameInput);
    };

    form.onsubmit = (e) => {
      e.preventDefault();
      errorEl.textContent = "";

      // ── Modo calificación de plato OFICIAL (carta compartida) ────────────────
      // No hay Dish personal: se guarda directo en official_ratings.
      if (officialRatingDishId) {
        const rating = isRated ? parseFloat(ratingInput.value) : null;
        const dishId = officialRatingDishId;
        close();
        rateOfficialDish(dishId, rating);
        emit("official:rated", { officialDishId: dishId, rating });
        return;
      }

      const name = nameInput.value.trim();
      if (!name) {
        errorEl.textContent = "El nombre del plato es obligatorio.";
        nameInput.focus();
        return;
      }

      const restaurantId = restaurantIdInput.value;
      const id = idInput.value;

      const typeId = typeIdInput.value || null;
      const duplicate = getDishesByRestaurant(restaurantId).find(
        (d) =>
          d.name.trim().toLowerCase() === name.toLowerCase() &&
          d.typeId === typeId &&
          d.id !== id,
      );
      if (duplicate) {
        errorEl.textContent =
          "Ya existe un plato con ese nombre y tipo en este restaurante.";
        nameInput.focus();
        return;
      }

      const rating = isRated ? parseFloat(ratingInput.value) : null;
      const notes = notesInput.value.trim();

      // Cerrar ANTES de emitir: garantiza que el modal cierra aunque
      // el listener del evento lance una excepción.
      close();

      if (id) {
        // Capturar rating previo desde el cache ANTES del update para detectar
        // la transición null → número (única señal real de "primera calificación").
        const prevRating =
          getDishesByRestaurant(restaurantId).find((d) => d.id === id)
            ?.rating ?? null;
        const updated = updateDish(id, { name, rating, notes, typeId });
        if (updated) {
          emit("dish:updated", updated);
          // Solo dispara "primera calificación" en transición null → número.
          // El auto-promote a "visitado" se suscribe a este evento, no a dish:updated,
          // para no revertir un pending elegido manualmente por el usuario.
          if (prevRating === null && updated.rating !== null) {
            emit("dish:first-rated", updated);
          }
        }
      } else {
        emit(
          "dish:created",
          createDish({ restaurantId, typeId, name, rating, notes }),
        );
      }
    };

    // Actualizar API global con referencias frescas al DOM actual
    (window as any).dishForm = { open, openOfficial, close };
  });
</script>
