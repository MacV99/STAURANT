---
import type { Restaurant } from "../lib/data";
import RatingBadge from "./RatingBadge.astro";

interface Props {
  restaurant: Restaurant;
  avg: number | null;
  dishCount: number;
}

const { restaurant: r, avg, dishCount } = Astro.props;
const isPending = r.status === "pending";
---

<article
  class:list={["restaurant-card card-clickable flex-row", { "is-official": r.officialRestaurantId }]}
  data-href={`/restaurante?id=${r.id}`}
  style={`view-transition-name: restaurant-${r.id}`}
>
  <div class="holo-sheet" aria-hidden="true"></div>
  <div class="card-body flex-column">
    <h3>
      {r.officialRestaurantId ? (() => {
        const idx = r.name.lastIndexOf(" ");
        const head = idx === -1 ? "" : r.name.slice(0, idx + 1);
        const tail = idx === -1 ? r.name : r.name.slice(idx + 1);
        return (
          <>
            {head}
            <span class="name-tail-nowrap">
              {tail}
              <i class="bi bi-patch-check-fill verified-badge" title="Restaurante verificado" />
            </span>
          </>
        );
      })() : r.name}
    </h3>
    {
      !isPending && (
        <span class="dish-count-pill">
          <i class="bi bi-journal-text" /> {dishCount}{" "}
          {dishCount === 1 ? "plato" : "platos"}
        </span>
      )
    }
  </div>
  <RatingBadge score={avg} />
</article>

<style>
  /* Misma estructura de contenido que .dish-card: padding 14/16, gap 12 y el
     bloque de texto (nombre + pill) alineado igual que .dish-info. */
  .restaurant-card {
    background: var(--clr-white);
    border: 1px solid var(--clr-border);
    border-radius: 18px;
    padding: 14px 16px;
    justify-content: space-between;
    gap: 12px;
    transition: var(--transition);
  }

  .restaurant-card.card-clickable {
    cursor: pointer;
  }

  /* Gemelo de .dish-info: ocupa el espacio disponible y apila nombre + pill. */
  .card-body {
    flex: 1;
    align-items: flex-start;
    min-width: 0;
  }

  .card-body h3 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--clr-text);
    word-break: break-word;
    line-height: 1.25;
  }

  /* Mismo respiro nombre→pill que en las cards de platos (margin-top ~3px). */
  .card-body .dish-count-pill {
    margin-top: 3px;
  }

  .restaurant-card.card-clickable:active {
    transform: scale(0.97);
  }

  @media (hover: hover) {
    .restaurant-card.card-clickable:hover {
      border-color: var(--clr-border2);
    }
  }

  /* La card oficial (borde de oro giratorio + núcleo oscuro) es un estilo
     COMPARTIDO por 3 cards → vive en project.css (.restaurant-card /
     .explore-card / .rh-card).is-official. Aquí solo se inyecta la .holo-sheet. */
</style>
